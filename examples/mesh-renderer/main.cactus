module main

use std.input as inp
use std.math.quat as quat
use std.transform.volume as tv
use std.render.meshes as meshes

const:
    WINDOW_WIDTH = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE = "Mesh Renderer Example"
    TARGET_FPS = 60
    ROTATION_SPEED = 1.75

asset BlueCubeMesh: mesh = "models/blue_cube.mesh"
asset BlueCubeMaterial: material = "materials/blue_cube.mat"

input RotateHorizontal: axis
    negative = inp.Key.A
    positive = inp.Key.D

input RotateVertical: axis
    negative = inp.Key.S
    positive = inp.Key.W

trait RotationInput:
    var horizontal: float = 0.0
    var vertical: float = 0.0

pub entity BlueCube:
    tv.WorldTransform:
        position = vec3(0.0, 0.0, 0.0)
        rotation = quat.identity()
        scale = vec3(1.5, 1.5, 1.5)
    RotationInput:
        horizontal = 0.0
        vertical = 0.0
    meshes.Renderer:
        mesh = BlueCubeMesh
        material = BlueCubeMaterial
        visible = true
        cast_shadow = true

pub entity BlueCube2:
    tv.WorldTransform:
        position = vec3(3.0, 1.0, 0.0)
        rotation = quat.identity()
        scale = vec3(3.5, 3.5, 3.5)
    RotationInput:
        horizontal = 0.0
        vertical = 0.0
    meshes.Renderer:
        mesh = BlueCubeMesh
        material = BlueCubeMaterial
        visible = true
        cast_shadow = true

pub entity LeftPointLight:
    tv.WorldTransform:
        position = vec3(-2.0, 1.5, 2.5)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #b3ffd5
        intensity = 1.4
        range = 8.0
        enabled = true

pub entity RightPointLight:
    tv.WorldTransform:
        position = vec3(2.0, 1.25, 2.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #ffb3e8
        intensity = 1.2
        range = 8.0
        enabled = true

rule ReadRotationInput:
    filter:
        RotationInput

    on input:
        horizontal = input.axis(RotateHorizontal)
        vertical = input.axis(RotateVertical)

rule ApplyScreenSpaceRotation:
    filter:
        tv.WorldTransform
        RotationInput

    on tick:
        let yaw_axis = quat.up(rotation)
        let pitch_axis = quat.right(rotation)
        let yaw_delta = quat.from_axis_angle(yaw_axis, horizontal * ROTATION_SPEED * tick.dt)
        let pitch_delta = quat.from_axis_angle(pitch_axis, vertical * ROTATION_SPEED * tick.dt)
        rotation = quat.rotate_world(rotation, yaw_delta)
        rotation = quat.rotate_world(rotation, pitch_delta)
