module std.render.text

# ── Text Label Rendering Trait ────────────────────────────────────────────────
# Single trait works in both 2D and 3D contexts.
# The active renderer is determined by the entity's WorldTransform type:
#   flat.WorldTransform  → TextRenderer2D (DrawTextPro, font_size in screen pixels)
#   volume.WorldTransform → TextRenderer3D (render-to-texture plane, font_size in world units)
# Neither transform module is imported here; the game code supplies whichever it needs,
# avoiding the duplicate-symbol conflict that arises when both are in scope simultaneously.

pub trait TextLabel:
    var text:      string = ""
    var font_size: int    = 32
    var color:     color  = #FFFFFFFF
    var visible:   bool   = true

# Fires for entities with a 2D (flat) WorldTransform.
# font_size is interpreted as screen pixels.
extern system TextRenderer2D:
    filter:
        TextLabel

# Fires for entities with a 3D (volume) WorldTransform.
# font_size is interpreted as world units; text is baked to a RenderTexture2D
# cached by content and drawn as a plane mesh following the entity's orientation.
extern system TextRenderer3D:
    filter:
        TextLabel

# ── Window-Space Screen Labels ────────────────────────────────────────────────
# HUD text drawn in window pixel coordinates after all viewport/world rendering.
# Requires no WorldTransform, so it works identically in flat and volume
# programs — unlike TextLabel, which follows the entity's transform flavor.

# position:  screen pixels, top-left origin
# font_size: screen pixels
pub trait ScreenLabel:
    var text:      string = ""
    var position:  vec2
    var font_size: int    = 32
    var color:     color  = #FFFFFFFF
    var visible:   bool   = true

# Draws visible labels at their window position, overlaying 2D and 3D content.
extern system ScreenLabelSystem:
    filter:
        ScreenLabel
