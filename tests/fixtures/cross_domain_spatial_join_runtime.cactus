module cross_domain_spatial_join_runtime

use std.core
use std.collision.volume as vol

# Each accelerated rule has a twin whose where: wraps the same test in
# `== true`, which is not a recognized overlap predicate, so the twin runs the
# plain product. The host fills the world with spheres and rotated boxes and
# the test compares the twins' tuple logs.

const:
    PROBE = 0.25

trait Actor:
    var pos: vec3
    var radius: float
    var tag: int

trait Solid:
    var pos: vec3
    var size: vec3
    var rotation: quat
    var tag: int

trait Recorder:
    var accelerated_hash: int = 0
    var accelerated_count: int = 0
    var plain_hash: int = 0
    var plain_count: int = 0
    var nearest_accelerated_hash: int = 0
    var nearest_accelerated_count: int = 0
    var nearest_plain_hash: int = 0
    var nearest_plain_count: int = 0

template Sphere(pos: vec3, radius: float, tag: int):
    Actor:
        pos = pos
        radius = radius
        tag = tag

template Box(pos: vec3, size: vec3, rotation: quat, tag: int):
    Solid:
        pos = pos
        size = size
        rotation = rotation
        tag = tag

# A sphere that is also a box, so shared entities produce self tuples.
template SphereBox(pos: vec3, radius: float, size: vec3, rotation: quat, tag: int):
    use Sphere(pos = pos, radius = radius, tag = tag)
    use Box(pos = pos, size = size, rotation = rotation, tag = tag)

pub extern event SpherePlaced:
    pos: vec3
    radius: float
    tag: int

pub extern event BoxPlaced:
    pos: vec3
    size: vec3
    rotation: quat
    tag: int

pub extern event SphereBoxPlaced:
    pos: vec3
    radius: float
    size: vec3
    rotation: quat
    tag: int

rule PlaceSphere:
    on SpherePlaced:
        spawn Sphere(pos = SpherePlaced.pos, radius = SpherePlaced.radius, tag = SpherePlaced.tag)

rule PlaceBox:
    on BoxPlaced:
        spawn Box(pos = BoxPlaced.pos, size = BoxPlaced.size, rotation = BoxPlaced.rotation, tag = BoxPlaced.tag)

rule PlaceSphereBox:
    on SphereBoxPlaced:
        spawn SphereBox(
            pos = SphereBoxPlaced.pos,
            radius = SphereBoxPlaced.radius,
            size = SphereBoxPlaced.size,
            rotation = SphereBoxPlaced.rotation,
            tag = SphereBoxPlaced.tag)

event AcceleratedHit:
    code: int

event PlainHit:
    code: int

event NearestAcceleratedHit:
    code: int

event NearestPlainHit:
    code: int

rule DetectAccelerated:
    pairs:
        actor:
            Actor
        wall:
            Solid
    where:
        vol.sphere_box_overlap(actor[Actor].pos, actor[Actor].radius + PROBE, wall[Solid].pos, wall[Solid].size, wall[Solid].rotation)
    on tick:
        emit AcceleratedHit:
            code = (actor[Actor].tag * 1000) + wall[Solid].tag

rule DetectPlain:
    pairs:
        actor:
            Actor
        wall:
            Solid
    where:
        vol.sphere_box_overlap(actor[Actor].pos, actor[Actor].radius + PROBE, wall[Solid].pos, wall[Solid].size, wall[Solid].rotation) == true
    on tick:
        emit PlainHit:
            code = (actor[Actor].tag * 1000) + wall[Solid].tag

rule NearestAccelerated:
    pairs:
        actor:
            Actor
        wall:
            Solid
    order by:
        wall[Solid].tag desc
    where:
        vol.sphere_box_overlap(actor[Actor].pos, actor[Actor].radius, wall[Solid].pos, wall[Solid].size, wall[Solid].rotation)
    limit: 1 per actor
    on tick:
        emit NearestAcceleratedHit:
            code = (actor[Actor].tag * 1000) + wall[Solid].tag

rule NearestPlain:
    pairs:
        actor:
            Actor
        wall:
            Solid
    order by:
        wall[Solid].tag desc
    where:
        vol.sphere_box_overlap(actor[Actor].pos, actor[Actor].radius, wall[Solid].pos, wall[Solid].size, wall[Solid].rotation) == true
    limit: 1 per actor
    on tick:
        emit NearestPlainHit:
            code = (actor[Actor].tag * 1000) + wall[Solid].tag

rule RecordTuples:
    each:
        Recorder

    on AcceleratedHit as hit:
        accelerated_hash = ((accelerated_hash * 31) + hit.code) % 1000003
        accelerated_count += 1

    on PlainHit as hit:
        plain_hash = ((plain_hash * 31) + hit.code) % 1000003
        plain_count += 1

    on NearestAcceleratedHit as hit:
        nearest_accelerated_hash = ((nearest_accelerated_hash * 31) + hit.code) % 1000003
        nearest_accelerated_count += 1

    on NearestPlainHit as hit:
        nearest_plain_hash = ((nearest_plain_hash * 31) + hit.code) % 1000003
        nearest_plain_count += 1

entity Recorder1:
    Recorder
