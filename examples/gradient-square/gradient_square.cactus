module gradient_square

use std.transform.flat as tf
use std.render.layers as layers

const:
    SQUARE_SIZE = 200.0

pub entity GradientSquare:
    tf.WorldTransform:
        position = vec2(400.0, 300.0)

# Each corner gets its own color; the fragment stage sees them blended.
rule Square:
    each:
        tf.WorldTransform as xf
    group: layers.sprites

    on render.vertex as v:
        let half = SQUARE_SIZE * 0.5
        v.world_position = xf.position + v.corner * half
        if v.corner.x < 0.0:
            v.tint_out = if v.corner.y < 0.0: #FF0000FF else: #FFFF00FF
        else:
            v.tint_out = if v.corner.y < 0.0: #00FF00FF else: #0000FFFF

    on render.fragment as f:
        f.frag_color = f.tint
