module std.render.models

use std.transform.volume as tv

# ── 3D Model Rendering Traits ─────────────────────────────────────────────────
# Passive traits — the backend reads these and renders automatically.
# No user rule is needed. An entity with WorldTransform + ModelRenderer is
# drawn with every submesh bound to its embedded material from the model file.

# Renders a model file (e.g. GLB) at the entity's transform position.
# Materials come from the model file itself; there is no material override.
# model:       asset handle for the model file (immutable after spawn)
# visible:     set false to skip rendering without removing the trait
# cast_shadow: whether this model contributes to shadow maps
pub trait ModelRenderer:
    let model: model_id
    var visible: bool = true
    var cast_shadow: bool = true
    var color: color = #FFFFFFFF

extern rule ModelRender:
    filter:
        tv.WorldTransform
        ModelRenderer

    on render:
        reads:
            tv.WorldTransform
            ModelRenderer
            ModelAnimator
        effects:
            graphics

# ── Skeletal Animation ────────────────────────────────────────────────────────
# Optional companion to ModelRenderer. Entities without ModelAnimator render at
# the model's bind pose. Entities sharing one model asset animate independently.

# Plays a skeletal animation clip on the entity's model.
# clip:    index of the animation clip to play (see animation_count/animation_name)
# playing: set false to freeze the pose at the current time
# speed:   playback rate multiplier (2.0 = double speed)
# time:    seconds into the clip; advanced by the backend, writable to seek
pub trait ModelAnimator:
    var clip: int = 0
    var playing: bool = true
    var speed: float = 1.0
    var time: float = 0.0

# Advances `time` by dt * speed each update tick while `playing`, wrapping by
# the active clip's duration so playback loops. Entities that add ModelPlayback
# below opt into one-shot playback and lifecycle events instead.
extern rule ModelAnimation:
    filter:
        ModelRenderer
        ModelAnimator

    on tick:
        reads:
            ModelRenderer
            ModelPlayback
            AnimationCue
        writes:
            ModelAnimator
        emits:
            AnimationMarker
            AnimationFinished
        effects:
            graphics

# ── Opt-in one-shot playback and lifecycle events ───────────────────────────────
# Optional companion to ModelAnimator. Adding ModelPlayback does not change
# ModelAnimator's default looping behavior by itself — Loop is the default
# mode, matching what every ModelAnimator already does without ModelPlayback.
#
# AnimationMarker/AnimationFinished are presentation cues, not an authoritative
# clock: they tell gameplay code when to react (play a footstep sound, clear an
# "attacking" flag) to what the model is currently showing on screen. Combat or
# other simulation logic that needs precise hit timing should keep its own
# timer rather than gate damage on these events, since dropped frames, a large
# dt, or the 64-duration cap below can shift exactly when a marker lands.
#
# Each update advances at most 64 clip durations regardless of dt or speed —
# a guard against an unbounded marker/completion burst from an extreme value
# of either. Requested advancement beyond that is silently discarded (not
# queued for a later frame) and recorded as a diagnostic; ordinary gameplay
# speeds never approach this bound.

pub enum PlaybackMode:
    Loop
    # Clamps at the clip's endpoint (duration for forward speed, 0 for
    # negative speed) instead of wrapping, stops playing, and emits one
    # targeted AnimationFinished.
    Once

# mode:     Loop preserves ModelAnimator's default wrap-and-continue behavior;
#           Once clamps at the endpoint (duration for positive speed, 0 for
#           negative — reverse playback works the same as forward, just
#           walking the clip and its cues from the other end) and completes.
# revision: bump to explicitly restart at the current ModelAnimator.time and
#           rearm completion — the only way to replay a finished Once clip.
#           Writing ModelAnimator.time directly without bumping revision is a
#           seek, not a restart: it moves the traversal baseline to the new
#           value without replaying cues in between and without rearming a
#           completed Once clip.
pub trait ModelPlayback:
    var mode: PlaybackMode = PlaybackMode.Loop
    var revision: int = 0

# A marker authored as a direct child entity of a ModelPlayback owner. Crossing
# `time` while playing emits AnimationMarker(clip, name) to the owner; `time`
# must lie strictly inside (0, clip duration) or the cue is ignored with a
# diagnostic. Multiple cues, and multiple owners sharing one model asset, are
# independent.
pub trait AnimationCue:
    var clip: int
    var time: float
    var name: string

# Targeted at the ModelPlayback owner whose cue was crossed, in traversal order
# (creation order breaks equal-time ties). Fires only for entities with
# ModelPlayback; a plain ModelAnimator never produces this.
pub event AnimationMarker:
    clip: int
    name: string

# Targeted at the ModelPlayback owner whose Once clip reached its endpoint.
# Fires exactly once per completion — not on every subsequent frame spent
# parked at the endpoint, and not when interrupted by a clip or revision
# change before finishing.
pub event AnimationFinished:
    clip: int

# Number of animation clips in the model file (0 if the handle is unresolvable).
# Triggers a lazy model load, so it works before the model's first draw.
pub extern func animation_count(m: model_id) int

# Name of a clip as stored in the model file ("" on bad handle or index).
pub extern func animation_name(m: model_id, clip: int) string

# Extents (max - min per axis) of the model's bind-pose axis-aligned bounding
# box. Triggers a lazy model load, so it works before the model's first draw.
# Returns vec3(0.0, 0.0, 0.0) for an unresolvable handle, a failed load, or a
# call before the rendering window exists.
pub extern func bounds_size(m: model_id) vec3

# Midpoint of the bind-pose bounding box ((min + max) / 2), in model space.
# Add this (scaled by the entity's world scale) to a model's world position
# to center a wire box on the actual mesh rather than the entity origin, for
# models whose bind-pose bounds aren't centered on the origin. Same
# load/fallback behavior as bounds_size. Not currently called by
# std.editor's gizmo renderers — those intentionally use a fixed-size
# fallback instead of mesh-aware bounds (see the editor-declarative-rendering
# change's design.md decision 8); this accessor is available for other
# callers that need bind-pose-centered placement.
pub extern func bounds_center(m: model_id) vec3
