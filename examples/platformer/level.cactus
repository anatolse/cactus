module level

use player

const:
    GROUND_Y = 600.0
    GROUND_WIDTH = 5000.0
    GROUND_HEIGHT = 40.0
    GROUND_COLOR = #5B8C3E
    PLATFORM_COLOR = #8B6914
    WALL_COLOR = #6B6B6B
    LEVEL_LEFT_BOUND = 0.0
    LEVEL_RIGHT_BOUND = 5000.0

enum PlatformType:
    Ground
    Floating
    Wall

trait Platform:
    let pos: vec2
    let size: vec2
    let platform_type: PlatformType
    let color: color

event PlatformCollision:
    entity: entity_id
    platform_pos: vec2
    platform_size: vec2
    overlap_x: float
    overlap_y: float

pub unit Ground:
    Platform:
        pos = vec2(0.0, GROUND_Y)
        size = vec2(GROUND_WIDTH, GROUND_HEIGHT)
        platform_type = PlatformType.Ground
        color = GROUND_COLOR

pub unit FloatingPlatform1:
    Platform:
        pos = vec2(300.0, 450.0)
        size = vec2(200.0, 20.0)
        platform_type = PlatformType.Floating
        color = PLATFORM_COLOR

pub unit FloatingPlatform2:
    Platform:
        pos = vec2(600.0, 350.0)
        size = vec2(150.0, 20.0)
        platform_type = PlatformType.Floating
        color = PLATFORM_COLOR

pub unit FloatingPlatform3:
    Platform:
        pos = vec2(950.0, 280.0)
        size = vec2(180.0, 20.0)
        platform_type = PlatformType.Floating
        color = PLATFORM_COLOR

pub unit FloatingPlatform4:
    Platform:
        pos = vec2(1300.0, 400.0)
        size = vec2(250.0, 20.0)
        platform_type = PlatformType.Floating
        color = PLATFORM_COLOR

pub unit FloatingPlatform5:
    Platform:
        pos = vec2(1700.0, 300.0)
        size = vec2(120.0, 20.0)
        platform_type = PlatformType.Floating
        color = PLATFORM_COLOR

pub unit WallBlock1:
    Platform:
        pos = vec2(500.0, 500.0)
        size = vec2(40.0, 100.0)
        platform_type = PlatformType.Wall
        color = WALL_COLOR

func aabb_overlap_x(ax: float, aw: float, bx: float, bw: float) float:
    let half_a = aw * 0.5
    let half_b = bw * 0.5
    let dx = (ax + half_a) - (bx + half_b)
    let overlap = half_a + half_b - abs_float(dx)
    if overlap < 0.0:
        return 0.0
    return overlap

func aabb_overlap_y(ay: float, ah: float, by: float, bh: float) float:
    let half_a = ah * 0.5
    let half_b = bh * 0.5
    let dy = (ay + half_a) - (by + half_b)
    let overlap = half_a + half_b - abs_float(dy)
    if overlap < 0.0:
        return 0.0
    return overlap

func abs_float(v: float) float:
    if v < 0.0:
        return v * -1.0
    return v

system CollisionSystem:
    filter:
        Platform as plat

    on tick:
        let player_pos = get_player_position()
        let player_w = get_player_width()
        let player_h = get_player_height()

        let ox = aabb_overlap_x(player_pos.x, player_w, plat.pos.x, plat.size.x)
        let oy = aabb_overlap_y(player_pos.y, player_h, plat.pos.y, plat.size.y)

        if ox > 0.0 and oy > 0.0:
            emit PlatformCollision:
                entity = get_player_entity()
                platform_pos = plat.pos
                platform_size = plat.size
                overlap_x = ox
                overlap_y = oy

system CollisionResolver:
    filter:
        Position as pos
        PlayerPhysics as phys
        PlayerController as ctrl

    on PlatformCollision:
        if PlatformCollision.overlap_y < PlatformCollision.overlap_x:
            if pos.pos.y < PlatformCollision.platform_pos.y:
                pos.pos = vec2(pos.pos.x, PlatformCollision.platform_pos.y - ctrl.height)
                emit PlayerLanded:
                    position = pos.pos
            else:
                pos.pos = vec2(pos.pos.x, PlatformCollision.platform_pos.y + PlatformCollision.platform_size.y)
                pos.velocity = vec2(pos.velocity.x, 0.0)
        else:
            if pos.pos.x < PlatformCollision.platform_pos.x:
                pos.pos = vec2(PlatformCollision.platform_pos.x - ctrl.width, pos.pos.y)
            else:
                pos.pos = vec2(PlatformCollision.platform_pos.x + PlatformCollision.platform_size.x, pos.pos.y)

system PlatformRenderer:
    filter:
        Platform as plat

    on tick:
        draw_rect(plat.pos, plat.size, plat.color)
