module platformer

use std.input
use std.math as math
use std.transform.flat
use std.physics.flat as phys
use std.render.shapes

# ── Input Action Declarations ─────────────────────────────────────────────────

input MoveX: axis
    negative = Key.A
    positive = Key.D
    gamepad  = GamepadAxis.LeftX

input MoveY: axis
    negative = Key.S
    positive = Key.W
    invert   = true
    gamepad  = GamepadAxis.LeftY

input Jump: button
    key     = Key.Space
    gamepad = GamepadButton.South

const:
    WINDOW_TITLE = "Cactus Platformer"
    WINDOW_WIDTH = 1280
    WINDOW_HEIGHT = 720
    TARGET_FPS = 60
    MOVE_SPEED = 320.0
    JUMP_FORCE = 780.0
    GRAVITY = 2200.0
    MAX_FALL_SPEED = 1250.0
    MAX_JUMPS = 2
    START_HEALTH = 3
    START_LIVES = 3
    WALL_SLIDE_SPEED = 20.0
    PLAYER_WIDTH = 32.0
    PLAYER_HEIGHT = 48.0
    GROUND_Y = 600.0
    GROUND_WIDTH = 5000.0
    GROUND_HEIGHT = 40.0
    GROUND_COLOR = #5B8C3E
    PLATFORM_COLOR = #8B6914
    PLATFORM1_X = 300.0
    PLATFORM1_Y = 450.0
    PLATFORM1_WIDTH = 200.0
    PLATFORM2_X = 600.0
    PLATFORM2_Y = 350.0
    PLATFORM2_WIDTH = 150.0
    PLATFORM3_X = 950.0
    PLATFORM3_Y = 280.0
    PLATFORM3_WIDTH = 180.0
    PLATFORM_HEIGHT = 20.0
    PATROL_SPEED = 140.0
    ENEMY_WIDTH = 32.0
    ENEMY_HEIGHT = 32.0
    ENEMY_COLOR = #CC3333
    GEM_SIZE = 16.0
    GEM_COLOR_BLUE = #4488FF
    GEM_COLOR_GOLD = #FFD700
    BLUE_GEM_POINTS = 10
    GOLD_GEM_POINTS = 100

# ── Enums ────────────────────────────────────────────────────────────────────────

enum FacingDirection:
    Left
    Right

enum JumpState:
    Grounded
    Jumping
    Falling

enum GemType:
    Blue
    Gold

# ── Traits ───────────────────────────────────────────────────────────────────────

trait PlayerMotion:
    var velocity: vec2
    var gravity: float
    var jump_force: float
    var grounded: bool
    var jumps_remaining: int
    var max_jumps: int
    var move_speed: float
    var facing: FacingDirection
    var jump_state: JumpState
    var move_axis: float
    var jump_requested: bool

trait Health:
    persist sync var health: int
    persist var lives: int
    let max_health: int = 3
    var invincible_timer: float

trait PatrolMotion:
    var patrol_min_x: float
    var patrol_max_x: float
    var patrol_speed: float
    var direction: float

trait Collectible:
    let point_value: int
    let gem_type: GemType
    var collected: bool

# ── Units ────────────────────────────────────────────────────────────────────────

pub unit Player:
    WorldTransform:
        position = vec2(100.0, 300.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(PLAYER_WIDTH, PLAYER_HEIGHT)
        color = #44AAFFFF
        visible = true
    Collider:
        layer = 1
        mask = 1
    BoxCollider:
        size = vec2(PLAYER_WIDTH, PLAYER_HEIGHT)
    PlayerMotion:
        velocity = vec2(0.0, 0.0)
        gravity = GRAVITY
        jump_force = JUMP_FORCE
        grounded = false
        jumps_remaining = MAX_JUMPS
        max_jumps = MAX_JUMPS
        move_speed = MOVE_SPEED
        facing = FacingDirection.Right
        jump_state = JumpState.Falling
        move_axis = 0.0
        jump_requested = false
    Health:
        health = START_HEALTH
        lives = START_LIVES
        invincible_timer = 0.0
    Persistent

pub unit GroundPlatform:
    WorldTransform:
        position = vec2(0.0, GROUND_Y)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(GROUND_WIDTH, GROUND_HEIGHT)
        color = GROUND_COLOR
        visible = true
    Collider:
        layer = 1
        mask = 1
    BoxCollider:
        size = vec2(GROUND_WIDTH, GROUND_HEIGHT)

