module std.math

# ── Constants ─────────────────────────────────────────────────────────────────

const:
    PI = 3.14159265

# ── Scalar Pure Functions ─────────────────────────────────────────────────────
# Implementations provided by the backend. These declarations are symbol
# references only — game code calls them; the backend resolves the bodies.

# Linear interpolation between a and b by factor t (0..1)
pub extern func lerp(a: float, b: float, t: float) float

# Clamp x to the range [lo, hi]
pub extern func clamp(x: float, lo: float, hi: float) float

# Absolute value
pub extern func abs(v: float) float

# Minimum of two values
pub extern func min(a: float, b: float) float

# Maximum of two values
pub extern func max(a: float, b: float) float

# Square root
pub extern func sqrt(v: float) float

# Sine of angle in radians
pub extern func sin(a: float) float

# Cosine of angle in radians
pub extern func cos(a: float) float

# Arc-tangent of y/x, returning angle in radians
pub extern func atan2(y: float, x: float) float

# Floor: largest integer not greater than v
pub extern func floor(v: float) int

# Ceil: smallest integer not less than v
pub extern func ceil(v: float) int

# Round: nearest integer to v
pub extern func round(v: float) int

# base raised to exp
pub extern func pow(base: float, exp: float) float
