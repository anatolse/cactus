module waving_label_3d

use std.math as math
use std.math.quat as quat
use std.text as text
use std.transform.volume as tv
use std.render.text as rtext

const:
    WINDOW_WIDTH  = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE  = "Waving Label 3D"
    TARGET_FPS    = 60

trait Clock:
    var elapsed: float = 0.0

pub entity WavingLabel:
    tv.WorldTransform:
        scale    = vec3(3.0, 1.5, 1.0)
    rtext.TextLabel:
        text      = "00:00"
        font_size = 1
    Clock:
        elapsed = 0.0

rule Wave:
    filter:
        tv.WorldTransform
        rtext.TextLabel
        Clock

    on tick:
        elapsed  = elapsed + tick.dt
        let ry   = quat.from_axis_angle(vec3(0.0, 1.0, 0.0), math.sin(elapsed * 1.2) * 1.2)
        let rx   = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), math.sin(elapsed * 0.7) * 0.5)
        rotation = quat.multiply(ry, rx)
        let secs = math.floor(elapsed)
        text = text.format("{:02}:{:02}", secs / 60, secs % 60)
