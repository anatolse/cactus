module std.math.vec3

# ── 3D Vector Pure Functions ──────────────────────────────────────────────────
# Implementations provided by the backend. These declarations are symbol
# references only — game code calls them; the backend resolves the bodies.

# Length (magnitude) of a 3D vector
pub extern func length(v: vec3) float

# Normalize a 3D vector to unit length
pub extern func normalize(v: vec3) vec3

# Dot product of two 3D vectors
pub extern func dot(a: vec3, b: vec3) float

# Cross product of two 3D vectors
pub extern func cross(a: vec3, b: vec3) vec3

# Linear interpolation between two 3D vectors by factor t (0..1)
pub extern func lerp(a: vec3, b: vec3, t: float) vec3

# Euclidean distance between two 3D points
pub extern func distance(a: vec3, b: vec3) float

# Reflect vector v about a surface with the given normal
pub extern func reflect(v: vec3, normal: vec3) vec3

# Component-wise clamp of a 3D vector to a [lo, hi] range per axis
pub extern func clamp(v: vec3, lo: vec3, hi: vec3) vec3

# Rotate a 3D vector around an axis by the given angle (radians), right-hand rule
pub extern func rotate(v: vec3, axis: vec3, angle: float) vec3
