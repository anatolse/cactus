entity CrosshairHud:
    text.ScreenLabel:
        text = "+"
        position = vec2(474.0, 252.0)
        font_size = 32
        color = #FFFFFFFF
        visible = true

entity GameOverHud:
    text.ScreenLabel:
        text = "GAME OVER"
        position = vec2(390.0, 245.0)
        font_size = 48
        color = #FFFFFFFF
