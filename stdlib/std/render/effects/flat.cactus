module std.render.effects.flat

use std.core as core
use std.time as time
use std.math as math
use std.math.vec2 as v2
use std.math.ease as ease
use std.transform.flat as tf
use std.render.layers as layers
use std.render.picture as picture
use std.render.effects as effects

# Flat effects: link an effect to a 2D target with `Affects`. Pose channels
# change where the target is drawn; `effects.Tint` and `effects.Glow` change
# its colors. See `std.render.effects` for how a channel moves.

pub relation Affects:
    from: effects.Effect
    to: tf.WorldTransform

# Moves the target. Effects on one target add.
pub trait Shift:
    var start: vec2 = vec2(0.0, 0.0)
    var end: vec2 = vec2(0.0, 0.0)
    var curve: ease.Curve = ease.Curve.Linear
    var at: float = 1.0

# Turns the target, in radians. Effects on one target add.
pub trait Turn:
    var start: float = 0.0
    var end: float = 0.0
    var curve: ease.Curve = ease.Curve.Linear
    var at: float = 1.0

# Scales the target per axis. Effects on one target multiply.
pub trait Scale:
    var start: vec2 = vec2(1.0, 1.0)
    var end: vec2 = vec2(1.0, 1.0)
    var curve: ease.Curve = ease.Curve.Linear
    var at: float = 1.0

# This frame's folded pose channels of one target.
trait PoseChange:
    var shift: vec2 = vec2(0.0, 0.0)
    var turn: float = 0.0
    var scale: vec2 = vec2(1.0, 1.0)

pub func shift_value(c: Shift) vec2:
    return v2.lerp(c.start, c.end, ease.apply(c.curve, c.at))

pub func turn_value(c: Turn) float:
    return math.lerp(c.start, c.end, ease.apply(c.curve, c.at))

pub func scale_value(c: Scale) vec2:
    return v2.lerp(c.start, c.end, ease.apply(c.curve, c.at))

rule DriveShift:
    each:
        Shift as c
        time.Span as span

    on core.late_tick:
        c.at = time.progress(span)

rule DriveTurn:
    each:
        Turn as c
        time.Span as span

    on core.late_tick:
        c.at = time.progress(span)

rule DriveScale:
    each:
        Scale as c
        time.Span as span

    on core.late_tick:
        c.at = time.progress(span)

rule FoldShift:
    pairs:
        fx: Shift
        thing: tf.WorldTransform
    group: layers.picture
    where:
        Affects(fx, thing)
    reduce per thing:
        rows = count()
        total = sum(shift_value(fx[Shift]))

    on core.render:
        if rows == 0:
            return
        project PoseChange to thing:
            shift = total

rule FoldTurn:
    pairs:
        fx: Turn
        thing: tf.WorldTransform
    group: layers.picture
    where:
        Affects(fx, thing)
    reduce per thing:
        rows = count()
        total = sum(turn_value(fx[Turn]))

    on core.render:
        if rows == 0:
            return
        project PoseChange to thing:
            turn = total

# `product` takes no vectors, so each axis folds on its own.
rule FoldScale:
    pairs:
        fx: Scale
        thing: tf.WorldTransform
    group: layers.picture
    where:
        Affects(fx, thing)
    reduce per thing:
        rows = count()
        x = product(scale_value(fx[Scale]).x)
        y = product(scale_value(fx[Scale]).y)

    on core.render:
        if rows == 0:
            return
        project PoseChange to thing:
            scale = vec2(x, y)

rule FoldTint:
    pairs:
        fx: effects.Tint
        thing: tf.WorldTransform
    group: layers.picture
    where:
        Affects(fx, thing)
    reduce per thing:
        rows = count()
        total = product(effects.tint_value(fx[effects.Tint]))

    on core.render:
        if rows == 0:
            return
        project picture.DrawnColor to thing:
            tint = total

rule FoldGlow:
    pairs:
        fx: effects.Glow
        thing: tf.WorldTransform
    group: layers.picture
    where:
        Affects(fx, thing)
    reduce per thing:
        rows = count()
        total = sum(effects.glow_value(fx[effects.Glow]))

    on core.render:
        if rows == 0:
            return
        project picture.DrawnColor to thing:
            glow = total

rule ComposePose:
    each:
        tf.WorldTransform as xf
        PoseChange as change
    group: layers.picture

    on core.render:
        project tf.DrawnPose:
            position = xf.position + change.shift
            rotation = xf.rotation + change.turn
            scale = xf.scale * change.scale
