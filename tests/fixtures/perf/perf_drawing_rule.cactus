module perf_drawing_rule

use std.core
use std.transform.flat as tf
use std.render.textures as textures

# A drawing rule over two traits with a without: and a where:. It reads row
# fields, one named entity and one link. Each step spawns one entity of each
# kind; only Young is in the drawn domain, Young and Old are the rows its draw
# loop visits. Tiles samples each row's texture: all Moss tiles come first,
# then all Sand tiles, so the draw binds two textures.

asset Moss: texture = "moss.png"
asset Sand: texture = "sand.png"

trait Board:
    let size: int = 1000
    var scale: float = 4.0

trait Particle:
    var age: float = 0.0
    let anchor: tf.WorldTransform

trait Hidden

trait Skin:
    let image: texture_id

entity Field:
    tf.WorldTransform
    Board

template Bare():
    tf.WorldTransform

template Spark(age: float = 0.0):
    use Bare()
    Particle:
        age = age
        anchor = Field

template Veiled():
    use Spark()
    Hidden

template Tile(image: texture_id):
    use Bare()
    Skin:
        image = image

rule Fill:
    on load:
        for i in range(0, Field[Board].size):
            spawn Bare()
            spawn Spark()
            spawn Spark(age = 2.0)
            spawn Veiled()
        for i in range(0, Field[Board].size):
            spawn Tile(image = Moss)
        for i in range(0, Field[Board].size):
            spawn Tile(image = Sand)

rule DropSparks:
    each: Particle
    on lost Particle.anchor:
        destroy

rule Sparks:
    each:
        tf.WorldTransform as xf
        Particle as particle
    without: Hidden
    where: particle.age < 1.0

    on render.vertex as v:
        let origin = particle.anchor[tf.WorldTransform].position
        v.world_position = origin + xf.position + v.corner * (Field[Board].scale - particle.age)

    on render.fragment as f:
        f.frag_color = f.tint

rule Tiles:
    each:
        tf.WorldTransform as xf
        Skin as skin
    after: Sparks

    on render.vertex as v:
        v.world_position = xf.position + v.corner

    on render.fragment as f:
        f.frag_color = textures.sample(skin.image, f.uv)
