module std.core

# ── Standard Traits ───────────────────────────────────────────────────────────

# Marker trait: entities with Persistent survive scene transitions.
# Apply this to units/templates that should NOT be destroyed on `load`.
pub trait Persistent

# Parent-child hierarchy relationship.
# Entities without Parent are treated as hierarchy roots.
pub trait Parent:
    var parent: entity_id

# ── Standard Lifecycle Events ─────────────────────────────────────────────────

# Events with a dt field (fired each frame phase)
pub event tick:
    dt: float

pub event fixed_tick:
    dt: float

pub event late_tick:
    dt: float

# Marker lifecycle events (no fields)
pub event spawn

pub event destroy

pub event input

pub event load

pub event unload

# ── Standard Systems ──────────────────────────────────────────────────────────

# SceneCleanup destroys all non-persistent entities on scene unload.
# Entities that have `Persistent` in their apply: block are excluded.
pub system SceneCleanup:
    exclude:
        Persistent
    on unload:
        destroy
