        sensitivity = 0.002
    KinematicActor:
        radius = PLAYER_RADIUS
        half_height = PLAYER_HALF_HEIGHT
        step_height = PLAYER_STEP_HEIGHT
    Player
    children:
        entity PlayerCamera:
            tv.WorldTransform
            camera.Camera:
                fov_y = 70.0
                near = 0.05
                far = 100.0
            viewport.Viewport:
                clear_color = #4890E0FF
            Shooter
            CameraRig

