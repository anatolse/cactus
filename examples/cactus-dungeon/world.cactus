module world

use std.core
use std.math as math
use std.noise as noise
use std.random as random
use std.physics.volume as physics
use std.transform.volume as tv
use std.voxel.volume as voxel

pub asset RockTexture: texture = "art/rock.png"
pub asset EarthTexture: texture = "art/earth.png"
pub asset GoldTexture: texture = "art/gold.png"
pub asset InfiniteGoldTexture: texture = "art/infinite_gold.png"
pub asset FloorTexture: texture = "art/floor.png"
pub asset BlueTexture: texture = "art/claimed_blue.png"
pub asset RedTexture: texture = "art/claimed_red.png"
pub asset WaterTexture: texture = "art/water.png"
pub asset LavaTexture: texture = "art/lava.png"
pub asset LairTexture: texture = "art/lair.png"
pub asset FarmTexture: texture = "art/farm.png"
pub asset TrainingTexture: texture = "art/training.png"
pub asset BridgeTexture: texture = "art/bridge.png"

pub enum Kind:
    Rock
    Earth
    Gold
    InfiniteGold
    Floor
    Water
    Lava

pub trait WorldConfig:
    var size: int = 85
    var seed: int = 7
    var starting_robots: int = 4
    var batch: int = 4096

pub trait Generation:
    persist var seed: int = 7
    persist var starting_robots: int = 4

pub trait Tile:
    persist var kind: Kind = Kind.Earth

pub trait Heart:
    persist var health: float = 2000.0

pub trait Robot

pub trait Player:
    persist var gold: int = 1000

pub entity Human:
    Player

pub entity Enemy:
    Player

pub relation OwnedBy:
    from: Tile one
    to: Player

pub relation OwnershipRequest:
    from: Tile
    to: Player

trait PendingCell

pub template Worker(at: vec3):
    Robot
    tv.WorldTransform:
        position = at

pub template Terrain(size: int, seed: int, robots: int, batch: int):
    voxel.Volume:
        max_x = size - 1
        max_y = 1
        max_z = size - 1
        batch = batch
    voxel.VolumeRenderer:
        style = voxel.SurfaceStyle.Smooth
        seed = seed
    tv.WorldTransform
    Generation:
        seed = seed
        starting_robots = robots

rule Begin:
    each: WorldConfig as config

    on load:
        spawn Terrain(size = config.size, seed = config.seed, robots = config.starting_robots, batch = config.batch)

pub func near_base(x: int, z: int, center: int) bool:
    return math.abs(1.0 * (x - center)) <= 2.0 and math.abs(1.0 * (z - center)) <= 2.0

pub func kind_at(cell: voxel.Cell, volume: voxel.Volume, recipe: Generation) Kind:
    let x = cell.x
    let z = cell.z
    let far = volume.max_x - 4
    if x == 0 or z == 0 or x == volume.max_x or z == volume.max_z:
        return Kind.Rock
    if near_base(x, z, 4) or near_base(x, z, far):
        return Kind.Floor
    if (z == 4 and x >= 4 and x <= far) or (x == far and z >= 4 and z <= far):
        return Kind.Earth
    let p = vec2(x * 1.0, z * 1.0)
    let terrain = noise.perlin2(p / 7.0, recipe.seed)
    let ore = random.sample_int(random.seeded(recipe.seed + x * 9176 + z * 6361), random.uniform_int(0, 99))
    if terrain > 0.45:
        return Kind.Rock
    if terrain < -0.45:
        return Kind.Water
    if terrain < -0.32 and ore < 25:
        return Kind.Lava
    if ore == 0:
        return Kind.InfiniteGold
    if ore < 16:
        return Kind.Gold
    return Kind.Earth

pub func texture_for(kind: Kind) texture_id:
    return match kind:
        Kind.Rock => RockTexture
        Kind.Earth => EarthTexture
        Kind.Gold => GoldTexture
        Kind.InfiniteGold => InfiniteGoldTexture
        Kind.Water => WaterTexture
        Kind.Lava => LavaTexture
        _ => FloorTexture

rule QueueCell:
    each: voxel.Cell as cell

    on added voxel.Cell:
        add PendingCell

rule GenerateCell:
    pairs:
        terrain:
            voxel.Volume as volume
            Generation as recipe
        node:
            voxel.Cell as cell
            PendingCell
    after: voxel.fill
    where:
        cell.volume == terrain

    on tick:
        remove PendingCell from node
        let kind = kind_at(cell, volume, recipe)
        if cell.y == 0:
            set voxel.Cell on node:
                texture = if kind == Kind.Water or kind == Kind.Lava: texture_for(kind) else: FloorTexture
            add physics.Solid to node
            return
        set voxel.Cell on node:
            texture = texture_for(kind)
        add Tile to node:
            kind = kind
        if near_base(cell.x, cell.z, 4):
            add OwnershipRequest(node, Human)
        if near_base(cell.x, cell.z, volume.max_x - 4):
            add OwnershipRequest(node, Enemy)
        if kind != Kind.Floor and kind != Kind.Water and kind != Kind.Lava:
            add physics.Solid to node
        if not ((cell.x == 4 and cell.z == 4) or (cell.x == volume.max_x - 4 and cell.z == volume.max_z - 4)):
            return
        add Heart to node
        for i in range(0, recipe.starting_robots):
            spawn Worker(at = vec3(cell.x + 0.75 + (i % 2) * 0.5, 1.25, cell.z + 0.75 + (i / 2) * 0.5))
