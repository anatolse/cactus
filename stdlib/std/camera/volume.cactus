module std.camera.volume

# ── 3D Camera Traits & Rules ──────────────────────────────────────────────────

# 3D perspective camera configuration.
# fov_y: vertical field of view in degrees
# near:  near clipping plane distance
# far:   far clipping plane distance
# Active camera selection is governed by std.camera.viewport.Viewport.
pub trait Camera:
    var fov_y: float = 60.0
    var near: float = 0.1
    var far: float = 1000.0

# Smooth-follow camera that tracks a target entity's position in 3D.
# follow_entity: entity_id of the entity to follow
# offset:        positional offset from the target (in world space)
# smoothing:     lerp speed (higher = snappier; 0 = instant)
pub trait FollowCamera:
    var follow_entity: entity_id
    var offset: vec3 = vec3(0.0, 2.0, -6.0)
    var smoothing: float = 8.0

# First-person camera driven by yaw/pitch angles.
# pitch:       vertical look angle in radians (clamped to avoid gimbal)
# yaw:         horizontal look angle in radians
# sensitivity: mouse/stick radians-per-input-unit
pub trait FirstPersonCamera:
    var pitch: float = 0.0
    var yaw: float = 0.0
    var sensitivity: float = 0.002

# Third-person camera that orbits around a target entity.
# follow_entity: entity_id of the entity to orbit
# distance:      orbit radius in world units
# height:        vertical offset above the target
# smoothing:     lerp speed (higher = snappier; 0 = instant)
pub trait ThirdPersonCamera:
    var follow_entity: entity_id
    var distance: float = 6.0
    var height: float = 2.0
    var smoothing: float = 8.0

# Rules to drive FollowCamera, FirstPersonCamera, and ThirdPersonCamera
# automatically are not yet implemented — they require entity-by-id field
# access (to read the followed/target entity's WorldTransform), which is not
# yet available in the language. Until then, attach Camera + Viewport
# (std.camera.viewport) to an entity whose own WorldTransform drives the 3D view.

# ── Screen/World Projection Helpers ──────────────────────────────────────────
# Projects screen-space coordinates through the active 3D camera onto a plane.
# screen_to_plane: ray/plane intersection; returns plane_origin when degenerate
# screen_delta_on_plane: world-space delta for a screen-space cursor movement

pub extern func screen_to_plane(screen: vec2, plane_origin: vec3, plane_normal: vec3) vec3

pub extern func screen_delta_on_plane(screen: vec2, delta: vec2, plane_origin: vec3, plane_normal: vec3) vec3
