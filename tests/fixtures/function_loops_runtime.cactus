module function_loops_runtime

use std.core
use function_loops_lib as lib

pub trait Results:
    var total: float
    var found_at: int
    var missing_at: int
    var cell: int
    var nearest_pair: int
    var empty_count: int
    var zero_step_count: int
    var wrong_direction_count: int
    var captured_count: int
    var countdown_sum: int
    var top_count: int
    var bottom_count: int
    var argument: int
    var bumped: int
    var imported_sum: int
    var constant_count: int
    var handler_top_count: int

const:
    FOUR = count_range(0, 4, 1)

pub entity Observer:
    Results

func total_of(values: list[float]) float:
    var sum = 0.0
    for v in values:
        sum += v
    return sum

func first_over(values: list[int], limit: int) int:
    var index = 0
    for v in values:
        if v > limit:
            return index
        index += 1
    return -1

func find_cell(rows: int, cols: int, target: int) int:
    for r in range(0, rows):
        for c in range(0, cols):
            if r * cols + c == target:
                return r * 100 + c
    return -1

func nearest_two(center: int) int:
    var best = 1000000
    var second = 1000000
    for i in range(0, 10):
        let d = (i * 7 % 10 - center) * (i * 7 % 10 - center)
        if d < best:
            second = best
            best = d
        else if d < second:
            second = d
    return best * 1000 + second

func count_range(begin: int, end: int, step: int) int:
    var n = 0
    for i in range(begin, end, step):
        n += 1
    return n

func captured(limit: int) int:
    var bound = limit
    var n = 0
    for i in range(0, bound):
        bound += 1
        n += 1
    return n

func countdown(start: int) int:
    var sum = 0
    for i in range(start, 0, -3):
        sum += i
    return sum

func bump(a: int) int:
    for i in range(0, 3):
        a += 1
    return a

rule Compute:
    each:
        Results

    on tick:
        total = total_of([1.5, 2.5, 3.0])
        found_at = first_over([1, 4, 9, 16], 5)
        missing_at = first_over([1, 2], 5)
        cell = find_cell(3, 4, 6)
        nearest_pair = nearest_two(4)
        empty_count = count_range(5, 0, 1)
        zero_step_count = count_range(0, 5, 0)
        wrong_direction_count = count_range(0, 5, -1)
        captured_count = captured(3)
        countdown_sum = countdown(10)
        top_count = count_range(2147483640, 2147483647, 4)
        bottom_count = count_range(-2147483641, -2147483647, -5)
        var original = 7
        bumped = bump(original)
        argument = original
        imported_sum = lib.sum_to(4)
        constant_count = FOUR
        var near_limit = 0
        for i in range(2147483640, 2147483647, 4):
            near_limit += 1
        handler_top_count = near_limit
