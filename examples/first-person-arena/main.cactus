module main

use std.core
use std.input as inp
use std.query as query
use std.math as math
use std.math.vec3 as v3
use std.math.quat as quat
use std.transform.volume as tv
use std.physics.volume as physics
use std.collision.volume as collision
use std.render.meshes as meshes
use std.render.models as models
use std.render.text as text
use std.camera.volume as camera
use std.camera.viewport as viewport

# Per-kind enemy data. Clip indices are positions in the GLB's own animation
# list (models.animation_name). The animator plays at speed /
# run_reference_speed, the speed the run clip's stride was authored for, so
# retuning speed can't reintroduce foot-sliding. visual_yaw_offset turns a
# model authored facing +Z (the robot) toward its direction of travel.
struct EnemyKind:
    speed: float
    run_reference_speed: float
    visual_yaw_offset: float
    run_clip: int
    jump_clip: int
    death_clip: int

const:
    WINDOW_WIDTH = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE = "First-Person Arena"
    TARGET_FPS = 60
    PLAYER_SPEED = 4.0
    PLAYER_RADIUS = 0.35
    PLAYER_HALF_HEIGHT = 0.9
    PLAYER_STEP_HEIGHT = 0.55
    CAMERA_EYE_HEIGHT = 0.65
    GRAVITY = 20.0
    JUMP_VELOCITY = 6.5
    ENEMY_RADIUS = 0.35
    ENEMY_HALF_HEIGHT = 0.9
    # How far ahead an enemy probes for a blocking wall before committing to a
    # heading, and the fixed deflection angles it tries (in order) when the
    # direct-to-player heading is blocked.
    ENEMY_STEER_PROBE_DISTANCE = 1.0
    ENEMY_STEER_ANGLE_SMALL = math.radians(40.0)
    ENEMY_STEER_ANGLE_LARGE = math.radians(80.0)
    SPAWN_INTERVAL = 10.0
    CHARACTER_HEIGHT = 1.8
    BULLET_SPEED = 20.0
    BULLET_RADIUS = 0.12
    BULLET_LIFETIME = 2.0
    # Collider layers. Map boxes keep the default layer 1. Bodies collide
    # with the map and each other; bullets with the map and enemies; a
    # hurtbox only touches the player.
    MAP_LAYER = 1
    ENEMY_LAYER = 2
    BULLET_LAYER = 4
    PLAYER_LAYER = 8
    HURTBOX_LAYER = 16
    BODY_MASK = MAP_LAYER + ENEMY_LAYER + PLAYER_LAYER
    BULLET_MASK = MAP_LAYER + ENEMY_LAYER
    # How far an enemy's hurtbox reaches past its body.
    HURTBOX_REACH = 0.1
    FIRE_COOLDOWN = 0.2
    DEATH_DURATION = 1.0
    HALF_PI = math.PI * 0.5
    ROBOT = EnemyKind(
        speed = 3.0,
        run_reference_speed = 3.5,
        visual_yaw_offset = math.PI,
        run_clip = 6,     # Robot_Running
        jump_clip = 3,    # Robot_Jump
        death_clip = 1,   # Robot_Death
    )
    KNIGHT = EnemyKind(
        speed = 3.3,
        run_reference_speed = 3.5,
        visual_yaw_offset = 0.0,
        run_clip = 4,     # Run1_Loop
        jump_clip = 3,    # Jump
        death_clip = 6,   # ShieldBlockHigh; the knight pack has no death clip
    )
    # How far above the enemy's torso the "would clearing this obstacle by
    # jumping actually work" probe checks — an obstacle that still blocks at
    # this height is treated as too tall to vault (route around it instead).
    ENEMY_VAULT_CLEARANCE_HEIGHT = 1.3
    # Encloses every steering probe sphere, so SeekPlayer's broad phase can
    # skip walls that no probe could touch.
    ENEMY_SENSE_RADIUS = ENEMY_STEER_PROBE_DISTANCE + ENEMY_VAULT_CLEARANCE_HEIGHT + ENEMY_RADIUS

asset BoxMesh: mesh = "models/box.mesh"
asset WhiteMaterial: material = "materials/white.mat"
asset Robot: model = "../model-renderer/art/robot.glb"
asset Knight: model = "../model-renderer/art/Crispoly-Characters-Mini-Red-Knight.glb"

input MoveForward: button
    key = inp.Key.W

input MoveBackward: button
    key = inp.Key.S

input MoveLeft: button
    key = inp.Key.A

input MoveRight: button
    key = inp.Key.D

input Fire: button
    mouse = inp.MouseButton.Left

input Jump: button
    key = inp.Key.Space

input ReleaseCursor: button
    key = inp.Key.Escape

input RestartGame: button
    key = inp.Key.R

pub trait Floor
pub trait PerimeterWall
pub trait BuildingWall
pub trait BuildingRoof
pub trait Stair
pub trait CameraRig
pub trait Threat
pub trait RobotEnemy
pub trait KnightEnemy
pub trait EnemyVisual

pub trait Player:
    var cursor_captured: bool = true

# Game-wide state, held by the named `Game` entity. Rules that stop during game
# over gate on it with `when:`.
pub trait Match:
    var over: bool = false
    var over_count: int = 0

pub trait Enemy:
    var kind: EnemyKind = ROBOT
    var death_elapsed: float = 0.0
    var facing_yaw: float = 0.0
    var death_pitch: float = 0.0
    var is_vaulting: bool = false

# Marks an enemy whose death animation is playing.
pub trait Dying

# A live enemy's trigger volume; touching the player catches them.
pub trait Hurtbox

# Kept on the player while a hurtbox touches them.
pub trait Caught

pub trait RobotSpawnPoint:
    var countdown: float = 0.0

pub trait KnightSpawnPoint:
    var countdown: float = 0.0

pub trait Shooter:
    var cooldown: float = 0.0

pub trait Bullet:
    var velocity: vec3 = vec3(0.0, 0.0, 0.0)
    var lifetime: float = 2.0

event EnemyHit

template BoxVisual:
    tv.WorldTransform:
        rotation = quat.identity()
    meshes.Renderer:
        mesh = BoxMesh
        material = WhiteMaterial
        visible = true
        cast_shadow = true

# Every map box blocks bodies and enemy steering probes; the character
# controller decides which ones are low enough to step onto.
template SolidBox:
    use BoxVisual
    physics.Solid
    physics.Collider
    physics.BoxCollider

template FloorBox:
    use SolidBox
    Floor

template PerimeterBox:
    use SolidBox
    PerimeterWall

template BuildingBox:
    use SolidBox
    BuildingWall

template RoofBox:
    use SolidBox
    BuildingRoof

template StairBox:
    use SolidBox
    Stair

template EnemyBase:
    tv.WorldTransform:
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    physics.Collider:
        layer = ENEMY_LAYER
        mask = BODY_MASK
    physics.CapsuleCollider:
        radius = ENEMY_RADIUS
        height = CHARACTER_HEIGHT
    physics.CharacterBody:
        gravity = GRAVITY
        step_height = PLAYER_STEP_HEIGHT
    physics.Solid
    Enemy
    Threat

    # The GLB character models are feet-anchored, but the body's
    # WorldTransform is the capsule's center. The model lives on a child
    # offset down to the feet, and follows the body by transform propagation.
    children:
        # Follows the body in solve, so CatchPlayer sees this tick's pose.
        entity HurtVolume:
            tv.LocalTransform
            tv.WorldTransform
            physics.Collider:
                layer = HURTBOX_LAYER
                mask = PLAYER_LAYER
            physics.CapsuleCollider:
                radius = ENEMY_RADIUS + HURTBOX_REACH
                height = CHARACTER_HEIGHT + HURTBOX_REACH * 2.0
            Hurtbox
        entity EnemyVisual:
            tv.LocalTransform:
                position = vec3(0.0, ENEMY_HALF_HEIGHT * -1.0, 0.0)
            tv.WorldTransform
            EnemyVisual
            models.ModelRenderer:
                color = #FFFFFFFF
            models.ModelAnimator:
                clip = 0
                playing = true
                speed = 1.0
                time = 0.0

template RobotTemplate:
    use EnemyBase
    RobotEnemy

template KnightTemplate:
    use EnemyBase
    KnightEnemy

template BulletTemplate:
    tv.WorldTransform:
        rotation = quat.identity()
        scale = vec3(BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0)
    meshes.Renderer:
        mesh = BoxMesh
        material = WhiteMaterial
        color = #FFD040FF
        visible = true
        cast_shadow = false
    physics.Collider:
        layer = BULLET_LAYER
        mask = BULLET_MASK
    physics.BoxCollider:
        size = vec3(BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0)
    Bullet

