rule FinishWideState:
    each:
        WideMode.V63
    on tick:
        add WideMode.Done
        add WideMode.V0
        remove WideMode

rule KeepWideStateFinal:
    each:
        WideMode.Done
    on tick:
        add WideMode.Done:
            elapsed = 0.0
        remove WideMode
