module platformer

use std.input as inp
use std.math as math
use std.transform.flat as tf
use std.physics.flat as phys
use std.render.shapes as shapes

# ── Input Action Declarations ─────────────────────────────────────────────────

input MoveX: axis
    negative = inp.Key.A
    positive = inp.Key.D
    gamepad  = inp.GamepadAxis.LeftX

input MoveY: axis
    negative = inp.Key.S
    positive = inp.Key.W
    invert   = true
    gamepad  = inp.GamepadAxis.LeftY

input Jump: button
    key     = inp.Key.Space
    gamepad = inp.GamepadButton.South

const:
    WINDOW_TITLE = "Cactus Platformer"
    WINDOW_WIDTH = 1280
    WINDOW_HEIGHT = 720
    TARGET_FPS = 60
    MOVE_SPEED = 320.0
    JUMP_FORCE = 780.0
    GRAVITY = 2200.0
    MAX_FALL_SPEED = 1250.0
    MAX_JUMPS = 2
    START_HEALTH = 3
    START_LIVES = 3
    WALL_SLIDE_SPEED = 20.0
    PLAYER_WIDTH = 32.0
    PLAYER_HEIGHT = 48.0
    GROUND_Y = 600.0
    GROUND_WIDTH = 5000.0
    GROUND_HEIGHT = 40.0
    GROUND_COLOR = #5B8C3E
    PLATFORM_COLOR = #8B6914
    PLATFORM1_X = 300.0
    PLATFORM1_Y = 450.0
    PLATFORM1_WIDTH = 200.0
    PLATFORM2_X = 600.0
    PLATFORM2_Y = 350.0
    PLATFORM2_WIDTH = 150.0
    PLATFORM3_X = 950.0
    PLATFORM3_Y = 280.0
    PLATFORM3_WIDTH = 180.0
    PLATFORM_HEIGHT = 20.0
    PATROL_SPEED = 140.0
    ENEMY_WIDTH = 32.0
    ENEMY_HEIGHT = 32.0
    ENEMY_COLOR = #CC3333
    GEM_SIZE = 16.0
    GEM_COLOR_BLUE = #4488FF
    GEM_COLOR_GOLD = #FFD700
    BLUE_GEM_POINTS = 10
    GOLD_GEM_POINTS = 100
    SOLID_LAYER = 1
    PLAYER_LAYER = 2
    ENEMY_LAYER = 4
    COLLECTIBLE_LAYER = 8
    SOLID_MASK = 1
    PLAYER_MASK = 14
    ENEMY_MASK = 3
    COLLECTIBLE_MASK = 2
    GROUND_PROBE_DISTANCE = 3.0

# ── Enums ────────────────────────────────────────────────────────────────────────

enum FacingDirection:
    Left
    Right

enum JumpState:
    Grounded
    Jumping
    Falling

enum GemType:
    Blue
    Gold

# ── Traits ───────────────────────────────────────────────────────────────────────

trait PlayerMotion:
    var velocity: vec2
    var gravity: float
    var jump_force: float
    var grounded: bool
    var jumps_remaining: int
    var max_jumps: int
    var move_speed: float
    var facing: FacingDirection
    var jump_state: JumpState
    var move_axis: float
    var jump_requested: bool

trait Health:
    persist sync var health: int
    persist var lives: int
    let max_health: int = 3
    var invincible_timer: float

trait PatrolMotion:
    var patrol_min_x: float
    var patrol_max_x: float
    var patrol_speed: float
    var direction: float

trait Collectible:
    let point_value: int
    let gem_type: GemType
    var collected: bool

# ── Templates ────────────────────────────────────────────────────────────────────

template FloatingPlatformBase:
    tf.WorldTransform:
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        color = PLATFORM_COLOR
        visible = true
    phys.Collider:
        layer = SOLID_LAYER
        mask = PLAYER_LAYER
    phys.BoxCollider

template WalkerEnemyBase:
    tf.WorldTransform:
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
        color = ENEMY_COLOR
        visible = true
    phys.Collider:
        layer = ENEMY_LAYER
        mask = ENEMY_MASK
    phys.BoxCollider:
        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
    PatrolMotion:
        patrol_speed = PATROL_SPEED
        direction = 1.0

template BlueGemBase:
    tf.WorldTransform:
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(GEM_SIZE, GEM_SIZE)
        color = GEM_COLOR_BLUE
        visible = true
    phys.Collider:
        layer = COLLECTIBLE_LAYER
        mask = COLLECTIBLE_MASK
    phys.BoxCollider:
        size = vec2(GEM_SIZE, GEM_SIZE)
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        collected = false

template GoldGemBase:
    tf.WorldTransform:
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(GEM_SIZE, GEM_SIZE)
        color = GEM_COLOR_GOLD
        visible = true
    phys.Collider:
        layer = COLLECTIBLE_LAYER
        mask = COLLECTIBLE_MASK
    phys.BoxCollider:
        size = vec2(GEM_SIZE, GEM_SIZE)
    Collectible:
        point_value = GOLD_GEM_POINTS
        gem_type = GemType.Gold
        collected = false

# ── Entities ──────────────────────────────────────────────────────────────────────

pub entity Player:
    tf.WorldTransform:
        position = vec2(100.0, 300.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(PLAYER_WIDTH, PLAYER_HEIGHT)
        color = #44AAFFFF
        visible = true
    phys.Collider:
        layer = PLAYER_LAYER
        mask = PLAYER_MASK
    phys.BoxCollider:
        size = vec2(PLAYER_WIDTH, PLAYER_HEIGHT)
    PlayerMotion:
        velocity = vec2(0.0, 0.0)
        gravity = GRAVITY
        jump_force = JUMP_FORCE
        grounded = false
        jumps_remaining = MAX_JUMPS
        max_jumps = MAX_JUMPS
        move_speed = MOVE_SPEED
        facing = FacingDirection.Right
        jump_state = JumpState.Falling
        move_axis = 0.0
        jump_requested = false
    Health:
        health = START_HEALTH
        lives = START_LIVES
        invincible_timer = 0.0
    Persistent

pub entity GroundPlatform:
    tf.WorldTransform:
        position = vec2(0.0, GROUND_Y)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(GROUND_WIDTH, GROUND_HEIGHT)
        color = GROUND_COLOR
        visible = true
    phys.Collider:
        layer = SOLID_LAYER
        mask = PLAYER_LAYER
    phys.BoxCollider:
        size = vec2(GROUND_WIDTH, GROUND_HEIGHT)

pub entity FloatingPlatform1 from FloatingPlatformBase:
    tf.WorldTransform:
        position = vec2(PLATFORM1_X, PLATFORM1_Y)
    shapes.Shape:
        size = vec2(PLATFORM1_WIDTH, PLATFORM_HEIGHT)
    phys.BoxCollider:
        size = vec2(PLATFORM1_WIDTH, PLATFORM_HEIGHT)

pub entity FloatingPlatform2 from FloatingPlatformBase:
    tf.WorldTransform:
        position = vec2(PLATFORM2_X, PLATFORM2_Y)
    shapes.Shape:
        size = vec2(PLATFORM2_WIDTH, PLATFORM_HEIGHT)
    phys.BoxCollider:
        size = vec2(PLATFORM2_WIDTH, PLATFORM_HEIGHT)

pub entity FloatingPlatform3 from FloatingPlatformBase:
    tf.WorldTransform:
        position = vec2(PLATFORM3_X, PLATFORM3_Y)
    shapes.Shape:
        size = vec2(PLATFORM3_WIDTH, PLATFORM_HEIGHT)
    phys.BoxCollider:
        size = vec2(PLATFORM3_WIDTH, PLATFORM_HEIGHT)

pub entity WalkerEnemy1 from WalkerEnemyBase:
    tf.WorldTransform:
        position = vec2(400.0, 568.0)
    PatrolMotion:
        patrol_min_x = 350.0
        patrol_max_x = 550.0

pub entity WalkerEnemy2 from WalkerEnemyBase:
    tf.WorldTransform:
        position = vec2(800.0, 568.0)
    PatrolMotion:
        patrol_min_x = 700.0
        patrol_max_x = 1000.0

pub entity BlueGem1 from BlueGemBase:
    tf.WorldTransform:
        position = vec2(250.0, 560.0)

pub entity BlueGem2 from BlueGemBase:
    tf.WorldTransform:
        position = vec2(350.0, 410.0)

pub entity GoldGem1 from GoldGemBase:
    tf.WorldTransform:
        position = vec2(1000.0, 240.0)

# ── Rules ────────────────────────────────────────────────────────────────────────

rule ReadPlayerInput:
    filter:
        PlayerMotion

    on input:
        move_axis = input.axis(MoveX)
        jump_requested = input.pressed(Jump)

rule MovementSystem:
    filter:
        tf.WorldTransform
        PlayerMotion
        phys.BoxCollider

    on tick:
        if move_axis > 0.0:
            facing = FacingDirection.Right
        if move_axis < 0.0:
            facing = FacingDirection.Left

        velocity = vec2(move_axis * move_speed, velocity.y)
        if jump_requested:
            if jumps_remaining > 0:
                velocity = vec2(velocity.x, jump_force * -1.0)
                jumps_remaining = jumps_remaining - 1
                grounded = false
                jump_state = JumpState.Jumping
        jump_requested = false

        velocity = vec2(velocity.x, math.clamp(velocity.y + gravity * tick.dt, jump_force * -1.0, MAX_FALL_SPEED))

        let horizontal_delta = velocity.x * tick.dt
        let horizontal_hit = phys.query_cast_nearest(self, vec2(horizontal_delta, 0.0), SOLID_MASK, self)

        if horizontal_hit.kind == phys.QueryResultKind.Hit:
            if horizontal_delta > 0.0:
                position = vec2(math.clamp(position.x + horizontal_hit.contact.distance, 0.0, GROUND_WIDTH - size.x), position.y)
            if horizontal_delta < 0.0:
                position = vec2(math.clamp(position.x - horizontal_hit.contact.distance, 0.0, GROUND_WIDTH - size.x), position.y)
            velocity = vec2(0.0, velocity.y)
        else:
            position = vec2(math.clamp(position.x + horizontal_delta, 0.0, GROUND_WIDTH - size.x), position.y)

        let vertical_delta = velocity.y * tick.dt
        let vertical_hit = phys.query_cast_nearest(self, vec2(0.0, vertical_delta), SOLID_MASK, self)
        grounded = false

        if vertical_hit.kind == phys.QueryResultKind.Hit:
            if vertical_delta > 0.0:
                position = vec2(position.x, position.y + vertical_hit.contact.distance)
            if vertical_delta < 0.0:
                position = vec2(position.x, position.y - vertical_hit.contact.distance)
            velocity = vec2(velocity.x, 0.0)
            if vertical_hit.contact.normal.y < 0.0:
                grounded = true
                jumps_remaining = max_jumps
                jump_state = JumpState.Grounded
        else:
            position = vec2(position.x, position.y + vertical_delta)

        if velocity.y > 0.0 and jump_state == JumpState.Jumping:
            jump_state = JumpState.Falling

        if not grounded:
            if velocity.y == 0.0:
                let ground_probe = phys.query_cast_nearest(self, vec2(0.0, GROUND_PROBE_DISTANCE), SOLID_MASK, self)
                if ground_probe.kind == phys.QueryResultKind.Hit:
                    if ground_probe.contact.normal.y < 0.0:
                        grounded = true
                        jumps_remaining = max_jumps
                        jump_state = JumpState.Grounded

rule InvincibilitySystem:
    filter:
        Health

    on tick:
        if invincible_timer > 0.0:
            invincible_timer = invincible_timer - tick.dt

rule PatrolSystem:
    filter:
        tf.WorldTransform
        PatrolMotion

    on tick:
        position = vec2(position.x + patrol_speed * direction * tick.dt, position.y)

        if position.x >= patrol_max_x:
            direction = -1.0
            position = vec2(patrol_max_x, position.y)

        if position.x <= patrol_min_x:
            direction = 1.0
            position = vec2(patrol_min_x, position.y)

rule CollectionSystem:
    filter:
        Collectible
        shapes.Shape

    on tick:
        if not collected:
            visible = true
        else:
            visible = false
