{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 20,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "default",
            "displayName": "Default (Debug)",
            "description": "Debug build with default compiler",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "release",
            "displayName": "Release",
            "description": "Optimized release build",
            "binaryDir": "${sourceDir}/build-release",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "msvc",
            "displayName": "MSVC (Debug)",
            "description": "Debug build using MSVC compiler",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "clang",
            "displayName": "Clang (Debug)",
            "description": "Debug build using Clang compiler",
            "binaryDir": "${sourceDir}/build",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++"
            }
        },
        {
            "name": "clang-o3-release",
            "displayName": "Clang O3 (Release)",
            "description": "Release build using Clang compiler with explicit -O3 optimization",
            "binaryDir": "${sourceDir}/build-clang-o3-release",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG -g"
            }
        },
        {
            "name": "clang-coverage",
            "displayName": "Clang Coverage (Debug)",
            "description": "Debug build using Clang with source-based coverage instrumentation for coverage_check",
            "binaryDir": "${sourceDir}/build-clang-coverage",
            "generator": "Ninja",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_CXX_COMPILER": "clang++",
                "CACTUS_ENABLE_COVERAGE": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "default",
            "configurePreset": "default"
        },
        {
            "name": "release",
            "configurePreset": "release"
        },
        {
            "name": "clang-o3-release",
            "configurePreset": "clang-o3-release"
        },
        {
            "name": "clang-coverage",
            "configurePreset": "clang-coverage"
        }
    ],
    "testPresets": [
        {
            "name": "default",
            "configurePreset": "clang-o3-release",
            "output": {
                "outputOnFailure": true
            }
        }
    ]
}