module std.physics.volume

use std.core as core
use std.math as math
use std.math.vec3 as v3
use std.transform.volume as tv

# ── 3D Kinematic Physics Traits ──────────────────────────────────────────────
# The `solve` rules below move every CharacterBody that has a Collider, a shape
# and a WorldTransform once per fixed_tick. Games write `velocity` and read the
# results; no game rule is needed for a body to fall, collide, slide or climb.
# Bodies stop only at solid colliders (with `Solid`); the rest are triggers.

# Kinematic character controller for 3D entities.
# velocity:            movement velocity in world units per second; games write it
# gravity:             downward acceleration while unsupported; 0.0 disables it
# step_height:         highest step a grounded body climbs, and lowest drop it follows
# max_slope:           steepest walkable surface, in degrees from world up
# grounded:            whether the body rests on a walkable surface (set by solve)
# ground_normal:       normal of that surface, or world up when airborne (set by solve)
# time_since_grounded: seconds since the body was last grounded (set by solve)
# motion:              stdlib-owned: motion left to move this tick
# lift:                stdlib-owned: how far the step-up raised the body this tick
# drop:                stdlib-owned: how far below the body the snap looks for ground
# ground_offset:       stdlib-owned: height of the body's center above its last ground contact
# heading:             stdlib-owned: the motion this tick started with
# contacts:            stdlib-owned: how many contact planes hold the rest of this tick's motion
# plane_a, plane_b:    stdlib-owned: the normals of those planes
# paused:              when true, solve leaves every field and the pose unchanged; the
#                      body still blocks others, which take the whole overlap correction
pub trait CharacterBody:
    var velocity: vec3 = vec3(0.0, 0.0, 0.0)
    var gravity: float = 9.81
    var step_height: float = 0.3
    var max_slope: float = 45.0
    var grounded: bool = false
    var ground_normal: vec3 = vec3(0.0, 1.0, 0.0)
    var time_since_grounded: float = 0.0
    var motion: vec3 = vec3(0.0, 0.0, 0.0)
    var lift: float = 0.0
    var drop: float = 0.0
    var ground_offset: float = 0.0
    var heading: vec3 = vec3(0.0, 0.0, 0.0)
    var contacts: int = 0
    var plane_a: vec3 = vec3(0.0, 0.0, 0.0)
    var plane_b: vec3 = vec3(0.0, 0.0, 0.0)
    var paused: bool = false

# Shared 3D collision participation/filtering data. An entity with Collider
# also needs exactly one shape trait: BoxCollider, SphereCollider or
# CapsuleCollider. Shapes are centered on WorldTransform.position, and
# WorldTransform.scale doesn't change them.
# layer: collision layer bitmask this entity belongs to
# mask:  collision layer bitmask this entity collides with
pub trait Collider:
    var layer: int = 1
    var mask: int = 1

# Makes a Collider solid: character bodies stop at it, slide along it and are
# pushed out of it. A Collider without Solid is a trigger: bodies pass through
# it, and rules see the contact through the queries below.
pub trait Solid

# Box collider, oriented by WorldTransform.rotation.
# size: full collider width/height/depth in world units
pub trait BoxCollider:
    var size: vec3 = vec3(1.0, 1.0, 1.0)

# Spherical collider for 3D entities.
# radius: collider radius in world units
pub trait SphereCollider:
    var radius: float = 0.5

# Capsule collider, always vertical along world Y.
# radius: capsule radius in world units
# height: total capsule height in world units, caps included
pub trait CapsuleCollider:
    var radius: float = 0.5
    var height: float = 1.0

# ── Collider queries ──────────────────────────────────────────────────────────
# These take bindings of the calling rule, work for any mix of shapes, solid or
# trigger, and honor Collider.layer/mask. An entity never hits itself.

# Where a sweep first touched its target. A miss has hit = false and t = 1.0,
# so `position += delta * hit.t` moves the full delta either way.
# other:   the target that was hit
# t:       fraction of delta travelled before contact
# point:   contact point on the target's surface
# normal:  unit normal pointing from the target toward the subject
# surface: the target's surface normal at the contact; on a box edge or corner,
#          the face the motion meets first
pub struct SweepHit:
    hit: bool
    other: entity_id
    t: float
    point: vec3
    normal: vec3
    surface: vec3

# Where subject's collider first touches target's when subject moves by delta.
pub extern func sweep(subject: entity_id, delta: vec3, target: entity_id) SweepHit

# Whether a's and b's colliders overlap now. a's mask filters b's layer.
pub extern func touching(a: entity_id, b: entity_id) bool

# Shortest move that takes a's collider out of b's, zero when apart. a's mask
# filters b's layer. Two character bodies that collide with each other each
# get half, unless b is paused: then a gets all of it.
pub extern func push_out(a: entity_id, b: entity_id) vec3

# ── Character controller ──────────────────────────────────────────────────────
# Each stage runs once per body, in declaration order, against solid colliders
# only; the slide runs three times. A body that was grounded lifts by
# step_height, slides at that height, then snaps back down, which climbs steps
# and follows descents. Game rules that write velocity run before the group;
# `after: solve` reads this tick's results.

pub group solve:
    phase: core.fixed_tick

# Contact rules join this group: it runs after `solve`, so they see this
# tick's poses of bodies and their children. A `keep` rule here turns a
# contact into a trait, so entering and leaving are `on added` and `on removed`.
pub group contacts:
    phase: core.fixed_tick
    after:
        solve

func walkable(normal: vec3, max_slope: float) bool:
    return normal.y >= math.cos(math.radians(max_slope))

func clip(v: vec3, normal: vec3) vec3:
    return v - normal * math.min(0.0, v3.dot(v, normal))

# Removes the part of `v` that moves into the surface `hit` touched. A surface
# the body can't stand on never adds upward speed: it stops the body like a
# wall first, so a body pressed against an edge still rises or falls past it.
func slide_along(v: vec3, hit: SweepHit, max_slope: float) vec3:
    let clipped = clip(v, hit.normal)
    if walkable(hit.surface, max_slope) or clipped.y <= math.max(v.y, 0.0):
        return clipped
    let wall = clip(v, v3.normalize(vec3(hit.normal.x, 0.0, hit.normal.z)))
    return clip(wall, hit.normal)

# Rounding can tilt a plane hit twice; normals this close count as one plane.
func parallel(a: vec3, b: vec3) bool:
    return math.abs(v3.dot(a, b)) > 0.999

# Whether `v` moves into `plane`, a plane other than the one `hit` touched.
func presses(v: vec3, plane: vec3, hit: SweepHit) bool:
    return v3.dot(v, plane) < -0.0001 * v3.length(v) and not parallel(plane, hit.normal)

# The part of `v` along the line where `held` and the surface `hit` touched
# meet. Nothing is left when that line climbs a surface the body can't stand
# on, or moves into `other`, the third plane when `has_other`.
func slide_along_crease(v: vec3, hit: SweepHit, held: vec3, other: vec3, has_other: bool, max_slope: float) vec3:
    let line = v3.normalize(v3.cross(held, hit.normal))
    let slid = line * v3.dot(v, line)
    let climbs = slid.y > math.max(v.y, 0.0) and not (walkable(hit.surface, max_slope) and walkable(held, max_slope))
    if climbs or (has_other and presses(slid, other, hit)):
        return vec3(0.0, 0.0, 0.0)
    return slid

# Removes the part of `v` that moves into the surface `hit` touched, or into a
# plane `body` hit earlier in this tick. Held by two planes, `v` keeps only its
# part along the line where they meet; held by three, nothing. Each new plane
# takes one dimension, so three slides use up the motion of a tick. A slide
# never turns back against the tick's heading: in a pocket of walls, where no
# single plane or crease explains the stop, the body stops.
func slide_along_all(v: vec3, hit: SweepHit, body: CharacterBody) vec3:
    if not hit.hit:
        return v
    let held = slide_along_held(v, hit, body)
    if v3.dot(held, body.heading) <= 0.0:
        return vec3(0.0, 0.0, 0.0)
    return held

func slide_along_held(v: vec3, hit: SweepHit, body: CharacterBody) vec3:
    let slid = slide_along(v, hit, body.max_slope)
    let on_a = body.contacts >= 1 and presses(slid, body.plane_a, hit)
    let on_b = body.contacts >= 2 and presses(slid, body.plane_b, hit)
    if on_a and on_b:
        return vec3(0.0, 0.0, 0.0)
    if on_a:
        return slide_along_crease(v, hit, body.plane_a, body.plane_b, body.contacts >= 2, body.max_slope)
    if on_b:
        return slide_along_crease(v, hit, body.plane_b, body.plane_a, true, body.max_slope)
    return slid

# The planes that hold the rest of a tick's motion: how many, then their normals.
struct ContactPlanes:
    count: int
    a: vec3
    b: vec3

# The contact planes after `hit` stopped `rest`: an earlier plane the slid
# motion still presses, then the hit's own. A hit that stops no motion, or
# repeats a plane, adds none.
func planes_after(rest: vec3, hit: SweepHit, body: CharacterBody) ContactPlanes:
    let kept = ContactPlanes(count = body.contacts, a = body.plane_a, b = body.plane_b)
    let repeated = (body.contacts >= 1 and parallel(body.plane_a, hit.normal)) or (body.contacts >= 2 and parallel(body.plane_b, hit.normal))
    if not hit.hit or v3.dot(rest, hit.normal) >= 0.0 or repeated:
        return kept
    let slid = slide_along(rest, hit, body.max_slope)
    if body.contacts >= 1 and presses(slid, body.plane_a, hit):
        return ContactPlanes(count = 2, a = body.plane_a, b = hit.normal)
    if body.contacts >= 2 and presses(slid, body.plane_b, hit):
        return ContactPlanes(count = 2, a = body.plane_b, b = hit.normal)
    return ContactPlanes(count = 1, a = hit.normal, b = body.plane_b)

rule Integrate:
    each:
        CharacterBody as body
        Collider
        tv.WorldTransform
    group: solve
    where:
        not body.paused

    on core.fixed_tick as step:
        let supported = body.grounded and body.velocity.y <= 0.0
        if not supported:
            body.velocity.y -= body.gravity * step.dt
        body.motion = body.velocity * step.dt
        body.lift = 0.0
        body.drop = 0.0
        body.contacts = 0
        if supported:
            body.motion.y = 0.0
            body.drop = body.step_height
        body.heading = body.motion
        if supported and (body.motion.x != 0.0 or body.motion.z != 0.0):
            body.lift = body.step_height
        body.grounded = false
        body.ground_normal = vec3(0.0, 1.0, 0.0)

rule Lift:
    pairs:
        body:
            CharacterBody
            Collider
            tv.WorldTransform
        other:
            Collider
            Solid
    group: solve
    after:
        Integrate
    where:
        not body[CharacterBody].paused
    reduce per body:
        hit = first_hit(sweep(body, vec3(0.0, body[CharacterBody].lift, 0.0), other))

    on core.fixed_tick:
        let rise = body[CharacterBody].lift * hit.t
        body[tv.WorldTransform].position.y += rise
        body[CharacterBody].lift = rise

rule Slide:
    pairs:
        body:
            CharacterBody
            Collider
            tv.WorldTransform
        other:
            Collider
            Solid
    group: solve
    after:
        Lift
    where:
        not body[CharacterBody].paused
    reduce per body:
        hit = first_hit(sweep(body, body[CharacterBody].motion, other))
    repeat: 3

    on core.fixed_tick:
        let max_slope = body[CharacterBody].max_slope
        let rest = body[CharacterBody].motion * (1.0 - hit.t)
        let planes = planes_after(rest, hit, body[CharacterBody])
        body[tv.WorldTransform].position += body[CharacterBody].motion * hit.t
        body[CharacterBody].motion = slide_along_all(rest, hit, body[CharacterBody])
        body[CharacterBody].velocity = slide_along_all(body[CharacterBody].velocity, hit, body[CharacterBody])
        body[CharacterBody].contacts = planes.count
        body[CharacterBody].plane_a = planes.a
        body[CharacterBody].plane_b = planes.b
        if hit.hit and walkable(hit.surface, max_slope):
            body[CharacterBody].grounded = true
            body[CharacterBody].ground_normal = hit.surface
            body[CharacterBody].ground_offset = body[tv.WorldTransform].position.y - hit.point.y

# Lands a planned step on walkable ground at most step_height above the ground
# it left. Otherwise the lift is undone, and Depenetrate clears any corner the
# body now overlaps.
rule Snap:
    pairs:
        body:
            CharacterBody
            Collider
            tv.WorldTransform
        other:
            Collider
            Solid
    group: solve
    after:
        Slide
    where:
        not body[CharacterBody].paused
    reduce per body:
        hit = first_hit(sweep(body, vec3(0.0, (body[CharacterBody].lift + body[CharacterBody].drop) * -1.0, 0.0), other))

    on core.fixed_tick as step:
        let lift = body[CharacterBody].lift
        let planned = body[CharacterBody].drop > 0.0
        let highest = body[tv.WorldTransform].position.y - lift - body[CharacterBody].ground_offset + body[CharacterBody].step_height
        let landed = planned and hit.hit and walkable(hit.surface, body[CharacterBody].max_slope) and hit.point.y <= highest + 0.001
        if landed:
            body[tv.WorldTransform].position.y -= (lift + body[CharacterBody].drop) * hit.t
            body[CharacterBody].velocity.y = 0.0
            body[CharacterBody].grounded = true
            body[CharacterBody].ground_normal = hit.surface
            body[CharacterBody].ground_offset = body[tv.WorldTransform].position.y - hit.point.y
        if planned and not landed:
            body[tv.WorldTransform].position.y -= lift
        if body[CharacterBody].grounded:
            body[CharacterBody].time_since_grounded = 0.0
        else:
            body[CharacterBody].time_since_grounded += step.dt

rule Depenetrate:
    pairs:
        body:
            CharacterBody
            Collider
            tv.WorldTransform
        other:
            Collider
            Solid
    group: solve
    after:
        Snap
    where:
        not body[CharacterBody].paused
    reduce per body:
        push = sum(push_out(body, other))

    on core.fixed_tick:
        body[tv.WorldTransform].position += push

# Re-derives the WorldTransform of each LocalTransform descendant of a body,
# so a rule after `solve` sees a body's children at this tick's pose. Other
# subtrees wait for std.transform.volume's late_tick propagation.
extern rule FollowBodies:
    group: solve
    after:
        Depenetrate

    on core.fixed_tick:
        reads:
            CharacterBody
            core.Parent
            tv.LocalTransform
            tv.WorldTransform
        writes:
            tv.WorldTransform
