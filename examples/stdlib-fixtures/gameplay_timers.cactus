module gameplay_timers

use std.core
use std.time as time

const:
    BULLET_LIFETIME = 40ms
    RELOAD_SECONDS = 0.11
    SHIELD_SECONDS = 0.07

# ── Traits and events ────────────────────────────────────────────────────────

trait Bullet

trait Muzzle:
    var pending_shots: int = 0

trait Weapon:
    var reloads_ready: int = 0
    var shields_ready: int = 0

# A timer entity's authored reference back to the entity it serves.
trait TimerOwner:
    var owner: entity_id

trait ReloadChannel

trait ShieldChannel

trait Metronome:
    var wraps: int = 0

# Timer entities are driven by whatever gameplay system owns them. This demo
# collects a frame's requests in one trait so a single input-phase rule issues
# them, in the order a real game would: starts first, then a rewind, a
# cancellation, and a teardown of the timer entity itself. Requests hold
# run-time float seconds, as a host or a formula would produce them.
trait TimerRequests:
    var starts: int = 0
    var first_duration: float = 0.0
    var second_duration: float = 0.0
    var rewind_pending: bool = false
    var cancel_pending: bool = false
    var destroy_pending: bool = false

event ReloadReady

event ShieldReady

# ── Projectile lifetime ──────────────────────────────────────────────────────
# A bullet carries its own span. std.time destroys it when the span ends, so
# no rule here does lifetime arithmetic.

template BulletTemplate:
    Bullet
    time.Span:
        length = BULLET_LIFETIME
    time.Ending.Expires

rule FireBullets:
    each:
        Muzzle as muzzle

    on fixed_tick:
        if muzzle.pending_shots <= 0:
            return
        muzzle.pending_shots -= 1
        # A parameterless spawn still requires a body; nothing here varies per shot.
        spawn BulletTemplate:
            Bullet

# ── Reload and shield timers ─────────────────────────────────────────────────
# Each countdown lives on its own timer entity, which gets its span when the
# countdown starts. A relay rule turns that entity's SpanEnded into the
# gameplay event its owner actually cares about.

# The player carries TimerRequests but no span: a rewind aimed at it is an
# ordinary no-match, never an implicit span.
entity Player:
    Weapon
    Muzzle
    TimerRequests

template TimerOf(wait: float):
    TimerOwner:
        owner = Player
    TimerRequests:
        first_duration = wait

entity ReloadTimer:
    use TimerOf(wait = RELOAD_SECONDS)
    ReloadChannel

entity ShieldTimer:
    use TimerOf(wait = SHIELD_SECONDS)
    ShieldChannel

# An empty repeating span ends on every fixed step once it starts.
entity MetronomeTimer:
    Metronome
    TimerRequests
    time.Ending.Repeats

rule RelayReload:
    each:
        TimerOwner as link
        ReloadChannel

    on time.SpanEnded:
        emit ReloadReady to link.owner

rule RelayShield:
    each:
        TimerOwner as link
        ShieldChannel

    on time.SpanEnded:
        emit ShieldReady to link.owner

rule CountWeaponEvents:
    each:
        Weapon as weapon

    on ReloadReady:
        weapon.reloads_ready += 1

    on ShieldReady:
        weapon.shields_ready += 1

rule CountWraps:
    each:
        Metronome as metronome

    on time.SpanEnded:
        metronome.wraps += 1

# Starting a countdown adds a new span; a second start in one frame replaces
# the first, since a new length is a new span.
rule ApplyTimerRequests:
    each:
        TimerRequests as requests

    on input:
        if requests.starts >= 1:
            add time.Span:
                length = duration(requests.first_duration)
        if requests.starts >= 2:
            add time.Span:
                length = duration(requests.second_duration)
        requests.starts = 0
        if requests.rewind_pending:
            requests.rewind_pending = false
            emit time.RestartSpan to self
        if requests.cancel_pending:
            requests.cancel_pending = false
            remove time.Span
        if requests.destroy_pending:
            destroy
