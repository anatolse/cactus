module concise_rule_notation
use std.core

trait CompactBody:
    var x: int = 0
    var total: int = -1
    var enters: int = 0
    var exits: int = 0
    var visible: int = -1
    var rank: int = -1
trait CompactZone:
    var x: int = 1
    var id: int = 10
trait CompactKept:
    var n: int = 0
trait CompactControl:
    var enabled: bool = true
    var trace: int = 0
    var empty: int = -1
event CompactTrace:
    id: int
entity CompactSettings:
    CompactControl
entity CompactActor:
    CompactBody
entity CompactEmpty:
    CompactBody:
        x = 100
entity CompactPool:
    CompactZone
entity CompactPoolTwo:
    CompactZone:
        id = 20
group CompactContacts:
    phase: fixed_tick
rule CompactMove:
    each: CompactBody as body
    when: CompactSettings[CompactControl].enabled
    on fixed_tick:
        body.x += 1
rule CompactTotal:
    pairs:
        body: CompactBody
        zone: CompactZone
    after: CompactMove
    where: body[CompactBody].x == zone[CompactZone].x
    reduce per body:
        n = count()
    on fixed_tick:
        body[CompactBody].total = n
rule CompactKeep:
    pairs:
        body: CompactBody
        zone: CompactZone
    group: CompactContacts
    after: CompactMove
    where: body[CompactBody].x == zone[CompactZone].x
    reduce per body:
        n = count()
    keep CompactKept on body:
        n = n
rule CompactObserve:
    each: CompactBody as body
    after: CompactKeep
    on fixed_tick:
        return
    on added CompactKept:
        body.enters += 1
    on removed CompactKept:
        body.exits += 1
trait BlockBody:
    var x: int = 0
    var total: int = -1
    var enters: int = 0
    var exits: int = 0
    var visible: int = -1
    var rank: int = -1
trait BlockZone:
    var x: int = 1
    var id: int = 10
trait BlockKept:
    var n: int = 0
trait BlockControl:
    var enabled: bool = true
    var trace: int = 0
    var empty: int = -1
event BlockTrace:
    id: int
entity BlockSettings:
    BlockControl
entity BlockActor:
    BlockBody
entity BlockEmpty:
    BlockBody:
        x = 100
entity BlockPool:
    BlockZone
entity BlockPoolTwo:
    BlockZone:
        id = 20
group BlockContacts:
    phase: fixed_tick
rule BlockMove:
    each:
        BlockBody as body
    when:
        BlockSettings[BlockControl].enabled
    on fixed_tick:
        body.x += 1
rule BlockTotal:
    pairs:
        body:
            BlockBody
        zone:
            BlockZone
    after:
        BlockMove
    where:
        body[BlockBody].x == zone[BlockZone].x
    reduce per body:
        n = count()
    on fixed_tick:
        body[BlockBody].total = n
rule BlockKeep:
    pairs:
        body:
            BlockBody
        zone:
            BlockZone
    group: BlockContacts
    after:
        BlockMove
    where:
        body[BlockBody].x == zone[BlockZone].x
    reduce per body:
        n = count()
    keep BlockKept on body:
        n = n
rule BlockObserve:
    each:
        BlockBody as body
    after:
        BlockKeep
    on fixed_tick:
        return
    on added BlockKept:
        body.enters += 1
    on removed BlockKept:
        body.exits += 1

rule CompactObserveKept:
    each: CompactBody as body, CompactKept as kept
    after: CompactKeep
    on fixed_tick:
        body.visible = kept.n
rule CompactOrderedPairs:
    pairs:
        body: CompactBody
        zone: CompactZone
    order by: zone[CompactZone].id desc
    after: CompactMove
    where: body[CompactBody].x == zone[CompactZone].x
    on fixed_tick:
        emit CompactTrace:
            id = zone[CompactZone].id
rule CompactRecord:
    on CompactTrace as observed:
        CompactSettings[CompactControl].trace = CompactSettings[CompactControl].trace * 100 + observed.id
rule CompactRank:
    pairs:
        body: CompactBody
        zone: CompactZone
    after: CompactMove
    where: body[CompactBody].x == zone[CompactZone].x
    reduce per body:
        n = count()
    order by: n desc
    limit: 1
    on fixed_tick:
        body[CompactBody].rank = n
rule CompactGlobalEmpty:
    each: CompactZone
    where: false
    reduce:
        n = count()
    on fixed_tick:
        CompactSettings[CompactControl].empty = n

rule BlockObserveKept:
    each:
        BlockBody as body
        BlockKept as kept
    after:
        BlockKeep
    on fixed_tick:
        body.visible = kept.n
rule BlockOrderedPairs:
    pairs:
        body:
            BlockBody
        zone:
            BlockZone
    order by:
        zone[BlockZone].id desc
    after:
        BlockMove
    where:
        body[BlockBody].x == zone[BlockZone].x
    on fixed_tick:
        emit BlockTrace:
            id = zone[BlockZone].id
rule BlockRecord:
    on BlockTrace as observed:
        BlockSettings[BlockControl].trace = BlockSettings[BlockControl].trace * 100 + observed.id
rule BlockRank:
    pairs:
        body:
            BlockBody
        zone:
            BlockZone
    after:
        BlockMove
    where:
        body[BlockBody].x == zone[BlockZone].x
    reduce per body:
        n = count()
    order by:
        n desc
    limit: 1
    on fixed_tick:
        body[BlockBody].rank = n
rule BlockGlobalEmpty:
    each:
        BlockZone
    where:
        false
    reduce:
        n = count()
    on fixed_tick:
        BlockSettings[BlockControl].empty = n
