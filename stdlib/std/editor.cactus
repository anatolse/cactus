module std.editor

use std.input as inp
use std.math as math
use std.math.quat as quat
use std.query as query
use std.camera.flat as camera2d
use std.camera.volume as camera3d
use std.transform.flat as transform2d
use std.transform.volume as transform3d
use std.debug as debug
use std.ui as ui
use std.text as strfmt
use std.render.text as labels

# ── Editor Input Actions ──────────────────────────────────────────────────────

input EditorToggleActive: button
    key = inp.Key.F1

input EditorModeTranslate: button
    key = inp.Key.W

input EditorModeRotate: button
    key = inp.Key.E

input EditorModeScale: button
    key = inp.Key.R

input EditorModePlace: button
    key = inp.Key.T

input EditorSelectClick: button
    mouse = inp.MouseButton.Left

# ── Camera Navigation Input Actions ───────────────────────────────────────────
# Laptop-friendly defaults that never require a middle mouse button:
#   Right drag         orbit (3D) / pan (2D)     [middle drag: Blender-like alt]
#   Shift + drag       pan instead of orbit (3D)
#   Wheel / trackpad   zoom (2D) / dolly (3D)    [read via input.wheel_delta]
#   - / =              keyboard zoom fallback (= shares the + keycap)
#   F                  frame the selected entity

input EditorNavDrag: button
    mouse = inp.MouseButton.Right

input EditorNavDragAlt: button
    mouse = inp.MouseButton.Middle

input EditorNavPanModifier: button
    key = inp.Key.Shift

input EditorNavZoomIn: button
    key = inp.Key.Equal

input EditorNavZoomOut: button
    key = inp.Key.Minus

input EditorFrameSelected: button
    key = inp.Key.F

# ── Gizmo Mode ────────────────────────────────────────────────────────────────

pub enum GizmoMode:
    Select
    Translate
    Rotate
    Scale
    Place

# ── Editor State ──────────────────────────────────────────────────────────────

pub trait EditorState:
    var active: bool = true
    var mode: int = 0
    var selected: entity_id
    var active_template: string = ""
    var focused_trait: string = ""
    var focused_field: string = ""
    var use_3d: bool = false

pub entity Editor:
    EditorState
    labels.ScreenLabel:
        text = ""
        position = vec2(10.0, 10.0)
        font_size = 14
        color = #FFFF00FF
        visible = false

# ── Selection Marker Traits ───────────────────────────────────────────────────

pub trait EditorSelected

pub trait EditorLocked

pub trait EditorHidden

# ── Snap Settings ─────────────────────────────────────────────────────────────

pub trait EditorSnap:
    var position_snap: float = 0.0
    var rotation_snap: float = 0.0
    var scale_snap: float = 0.0

# ── Editor Category ───────────────────────────────────────────────────────────

pub trait EditorCategory:
    let category: string
    var visible: bool = true

# ── Editor Camera Rig Traits ──────────────────────────────────────────────────
# Carried by the editor-owned camera rig entity that camera_enter spawns
# when edit mode activates (the user's active viewports are disabled and the
# rig takes over rendering; camera_exit destroys it and restores them —
# user camera entities are never mutated). Rig existence is the edit-mode gate:
# exactly one rig with the trait matching EditorState.use_3d exists while edit
# mode is active. Navigation state is initialized from the captured camera pose
# at spawn; all fields stay writable so user rules can read or tune them.

# 2D rig navigation state and tuning.
# view_center: world position at the viewport center
# zoom:        camera zoom factor (clamped to [min_zoom, max_zoom])
# pan_speed:   world units per screen pixel at zoom 1.0
# zoom_speed:  fractional zoom change per wheel step / zoom key press
pub trait EditorCamera2D:
    var view_center: vec2 = vec2(0.0, 0.0)
    var zoom: float = 1.0
    var pan_speed: float = 1.0
    var zoom_speed: float = 0.1
    var min_zoom: float = 0.05
    var max_zoom: float = 20.0

# 3D rig orbit state and tuning. The camera looks at focus from
# distance along the direction given by yaw/pitch (radians).
# orbit_speed: radians per screen pixel of drag
# pan_speed:   world units per screen pixel per unit of distance
# zoom_speed:  fractional distance change per wheel step / zoom key press
# pitch clamps avoid camera inversion; distance clamps avoid a degenerate pose
pub trait EditorCamera3D:
    var focus: vec3 = vec3(0.0, 0.0, 0.0)
    var yaw: float = 0.0
    var pitch: float = 0.0
    var distance: float = 10.0
    var orbit_speed: float = 0.005
    var pan_speed: float = 0.002
    var zoom_speed: float = 0.1
    var min_pitch: float = -1.5
    var max_pitch: float = 1.5
    var min_distance: float = 0.1
    var max_distance: float = 1000.0

# ── Gizmo Projection Traits (frame-local) ─────────────────────────────────────

pub trait EditorGizmo2D:
    var mode: int = 1
    var color: color = #00FF00FF
    var size: float = 1.0

pub trait EditorGizmo3D:
    var mode: int = 1
    var color: color = #00FF00FF
    var size: float = 1.0

# ── Editor Events ─────────────────────────────────────────────────────────────

pub event EditorSelectionChanged:
    previous: entity_id
    current: entity_id

pub event EditorModeChanged:
    previous_mode: int
    current_mode: int

# ── Extern Func Bridges ───────────────────────────────────────────────────────
# Only editor-specific bridges remain here. Generic input, camera projection,
# and entity-position helpers moved to std.input, std.camera.*, std.transform.*.
# Backend runtime symbols may remain editor_-prefixed for C++ symbol hygiene;
# codegen maps the clean DSL names to the prefixed runtime implementations.

pub extern func spawn_template(template_name: string, position_2d: vec2, position_3d: vec3) entity_id

pub extern func hit_test_2d(screen_pos: vec2, mask: int) entity_id

pub extern func raycast_3d(screen_pos: vec2, mask: int) entity_id

# Edit-mode camera swap lifecycle. Enter captures the active camera pose,
# deactivates user viewports, and spawns the dimension-matching rig. Exit
# destroys the rig and restores the recorded viewports.
pub extern func camera_enter(use_3d: bool) entity_id

pub extern func camera_exit()

# Write the rig's backend camera components.
pub extern func apply_camera_2d(view_center: vec2, zoom: float)

pub extern func apply_camera_3d(position: vec3, rotation: quat)

# Current EditorState.mode of the singleton Editor entity. Narrow singleton-read
# accessor mirroring transform.world_position(of:) — for rules (e.g. the gizmo
# renderers) that are not filtered on EditorState itself and have no other way
# to read it.
pub extern func active_mode() int

# Current EditorState.active of the singleton Editor entity. Same narrow-accessor
# idiom as active_mode() — needed because EditorSelected persists across an
# editor deactivate (only a selection change clears it), so a rule filtered on
# EditorSelected but not EditorState has no other way to detect "editor is off".
pub extern func is_editor_active() bool

# Registered pub template names, in declaration order (editor-template-registry).
pub extern func template_names() list[string]

# name's zero-based position in the same order template_names() returns, or -1
# if name is not a registered template. Used to obtain a per-item index for
# DSL-authored layout/tint without a loop-local counter — bounded `foreach`
# cannot mutate an outer-scope var across iterations (confirmed unsupported;
# see the editor-declarative-rendering change's design notes).
pub extern func template_index(name: string) int

# Current window/render-target size in screen pixels.
pub extern func screen_size() vec2

# Entity handle for the Nth pre-spawned palette-button label slot (a small
# fixed pool, sized to a max template count), or an invalid entity_id if index
# is out of range. ScreenLabel is entity-attached, not an event, so the
# palette rule needs a stable per-index entity to `project ScreenLabel to`
# each frame; see editor-declarative-rendering's task 6.3 design notes.
pub extern func palette_label_slot(index: int) entity_id

# Cycles a small fixed 6-color palette by index % 6, for index-based palette
# button tinting. Computed here rather than a DSL `let` + conditional
# reassignment: `if`/`for` bodies can't mutate an outer-scope local (confirmed
# codegen bug, same root cause as the foreach-mutation finding in
# editor-declarative-rendering's design notes) — a `let color = <default>`
# followed by `if ...: color = ...` branches would silently keep the
# first-declared value instead of the branch's.
pub extern func palette_color(index: int) color

# GizmoMode name (SELECT/TRANSLATE/ROTATE/SCALE/PLACE) for the HUD overlay's
# mode text. Same reason this is a backend accessor and not a DSL if-chain as
# palette_color above.
pub extern func mode_label(mode: int) string

# Y screen position (pixels) for the index'th palette button: 40 + index * 30
# (140x26px buttons, 4px gap). Computed here rather than DSL `40.0 + (idx *
# 30.0)`: the DSL has no explicit int-to-float cast, so the generated C++
# promotes `idx` implicitly, which the project's clang-tidy narrowing-
# conversion check (correctly, if pedantically) flags.
pub extern func palette_button_y(index: int) float

# ── Extern Rule Declarations ──────────────────────────────────────────────────
# EditorTemplatePalette, GizmoRenderer2D, and GizmoRenderer3D are no longer
# declared here as extern rules — their geometry/layout decisions moved into
# plain DSL rules (see the Built-in Editor Rules section below: the plain
# rule EditorTemplatePalette, and EditorGizmoRenderer2D/3D, which still
# project EditorGizmo2D/3D below for any other consumer but now also emit the
# std.debug/std.ui primitive events directly). EditorPropertyPanel remains the
# only extern rule — still an unimplemented stub.

pub extern rule EditorPropertyPanel:
    filter:
        EditorState

    on render:
        reads:
            EditorState
        effects:
            graphics

# Always-on edit-mode ground grid, independent of any specific gizmo or
# debug-draw event. Rig existence is the edit-mode gate (see the camera rig
# comment above); no per-entity data is required. Declared here (not
# std.debug) since EditorCamera3D is editor-specific and std.debug must stay
# independent of std.editor — see the editor-debug-draw capability for the
# documented behavior.
pub extern rule DebugGrid3D:
    filter:
        EditorCamera3D

    on render:
        effects:
            graphics

# ── Built-in Editor Rules ─────────────────────────────────────────────────────

rule EditorModeToggle:
    filter:
        EditorState

    on input:
        if input.pressed(EditorToggleActive):
            active = not active

        # Camera swap lifecycle: reconcile rig existence with editor state
        # every frame rather than acting on toggle edges or at load. Load
        # handlers run stdlib-first, so an on-load enter would spawn before a
        # user load handler could set use_3d; deferring to the first input
        # frame picks up the final dimension. Reconciliation also covers
        # programs that write EditorState.active directly.
        let has_2d = query.exists[EditorCamera2D]()
        let has_3d = query.exists[EditorCamera3D]()
        if active:
            if has_2d and use_3d:
                camera_exit()
            if has_3d and not use_3d:
                camera_exit()
            if use_3d and not has_3d:
                camera_enter(true)
            if not use_3d and not has_2d:
                camera_enter(false)
        else:
            if has_2d or has_3d:
                camera_exit()

        if active:
            if input.pressed(EditorModeTranslate):
                mode = 1

            if input.pressed(EditorModeRotate):
                mode = 2

            if input.pressed(EditorModeScale):
                mode = 3

            if input.pressed(EditorModePlace):
                mode = 4

rule EditorSelection2D:
    filter:
        EditorState

    after:
        EditorTemplatePalette

    on input:
        if not active:
            return
        if use_3d:
            return
        if not input.pressed(EditorSelectClick):
            return
        let previous = selected
        let hit = hit_test_2d(input.mouse_position(), 1)

        if exists(previous):
            remove EditorSelected from previous

        if exists(hit):
            add EditorSelected to hit

        selected = hit
        emit EditorSelectionChanged:
            previous = previous
            current = hit

rule EditorTranslate2D:
    filter:
        EditorSelected

    on tick:
        let delta = camera2d.screen_delta_to_world(input.mouse_delta())

rule EditorPlace2D:
    filter:
        EditorState

    after:
        EditorTemplatePalette

    on input:
        if not active:
            return
        if use_3d:
            return
        if mode != 4:
            return
        if not input.pressed(EditorSelectClick):
            return
        let pos = camera2d.screen_to_world(input.mouse_position())
        let id = spawn_template(active_template, pos, vec3(0.0, 0.0, 0.0))
        if not exists(id):
            return
        add EditorSelected to id
        selected = id

# Computes Blender-style selection/transform-handle geometry per active_mode()
# and emits std.debug/std.ui primitive events to draw it (editor-debug-draw).
# Also keeps projecting EditorGizmo2D for any other consumer. Geometry constants
# (arrow length ratios, arrowhead size, ring inner/outer radius ratio, tip size)
# match the values the hardcoded C++ this replaces used, for visual parity —
# see design.md decision 8 for the one accepted deviation (fixed-size AABB
# instead of reading BoxCollider.size).
# GizmoMode: 1=Translate, 2=Rotate, 3=Scale (0=Select, 4=Place draw no handles).
rule EditorGizmoRenderer2D:
    filter:
        transform2d.WorldTransform as xform
        EditorSelected

    on render:
        if not is_editor_active():
            return

        let mode = active_mode()
        project EditorGizmo2D:
            mode = mode
            color = #00FF00FF
            size = 1.0

        let center = xform.position
        let arrow_len = 1.0
        let arrow_thick = arrow_len * 0.05

        emit debug.DrawDebugRectOutline2D:
            position = vec2(center.x - 0.5, center.y - 0.5)
            size = vec2(1.0, 1.0)
            thickness = 0.05
            color = #00FF00FF

        if mode == 1:
            emit debug.DrawDebugLine2D:
                start = center
                end = vec2(center.x + arrow_len, center.y)
                color = #E62937FF
                thickness = arrow_thick
            emit debug.DrawDebugTriangle2D:
                a = vec2(center.x + arrow_len - (arrow_len * 0.2), center.y - (arrow_len * 0.1))
                b = vec2(center.x + arrow_len - (arrow_len * 0.2), center.y + (arrow_len * 0.1))
                c = vec2(center.x + arrow_len, center.y)
                color = #E62937FF
            emit debug.DrawDebugLine2D:
                start = center
                end = vec2(center.x, center.y + arrow_len)
                color = #00E430FF
                thickness = arrow_thick
            emit debug.DrawDebugTriangle2D:
                a = vec2(center.x - (arrow_len * 0.1), center.y + arrow_len - (arrow_len * 0.2))
                b = vec2(center.x + (arrow_len * 0.1), center.y + arrow_len - (arrow_len * 0.2))
                c = vec2(center.x, center.y + arrow_len)
                color = #00E430FF

        if mode == 2:
            emit debug.DrawDebugRingOutline2D:
                center = center
                inner_radius = arrow_len * 0.8
                outer_radius = arrow_len
                color = #66BFFFFF

        if mode == 3:
            let sq = arrow_len * 0.15
            emit debug.DrawDebugLine2D:
                start = center
                end = vec2(center.x + arrow_len, center.y)
                color = #E62937FF
                thickness = arrow_thick
            emit debug.DrawDebugRectOutline2D:
                position = vec2(center.x + arrow_len - (sq * 0.5), center.y - (sq * 0.5))
                size = vec2(sq, sq)
                thickness = sq * 0.4
                color = #E62937FF
            emit debug.DrawDebugLine2D:
                start = center
                end = vec2(center.x, center.y + arrow_len)
                color = #00E430FF
                thickness = arrow_thick
            emit debug.DrawDebugRectOutline2D:
                position = vec2(center.x - (sq * 0.5), center.y + arrow_len - (sq * 0.5))
                size = vec2(sq, sq)
                thickness = sq * 0.4
                color = #00E430FF

rule EditorSelection3D:
    filter:
        EditorState

    after:
        EditorTemplatePalette

    on input:
        if not active:
            return
        if not use_3d:
            return
        if not input.pressed(EditorSelectClick):
            return
        let previous = selected
        let hit = raycast_3d(input.mouse_position(), 1)

        if exists(previous):
            remove EditorSelected from previous

        if exists(hit):
            add EditorSelected to hit

        selected = hit
        emit EditorSelectionChanged:
            previous = previous
            current = hit

rule EditorTranslate3D:
    filter:
        EditorSelected

    on tick:
        let delta = camera3d.screen_delta_on_plane(input.mouse_position(), input.mouse_delta(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))

rule EditorPlace3D:
    filter:
        EditorState

    after:
        EditorTemplatePalette

    on input:
        if not active:
            return
        if not use_3d:
            return
        if mode != 4:
            return
        if not input.pressed(EditorSelectClick):
            return
        let pos = camera3d.screen_to_plane(input.mouse_position(), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
        let id = spawn_template(active_template, vec2(0.0, 0.0), pos)
        if not exists(id):
            return
        add EditorSelected to id
        selected = id

# Same shape as EditorGizmoRenderer2D (see its comment for geometry-parity notes
# and the design.md decision 8 fixed-size trade-off — here: fixed 1x1x1 wire box
# instead of reading ModelRenderer bind-pose bounds). The always-on ground grid
# is a separate, dedicated extern rule (DebugGrid3D above), not part of this rule.
rule EditorGizmoRenderer3D:
    filter:
        transform3d.WorldTransform as xform
        EditorSelected

    on render:
        if not is_editor_active():
            return

        let mode = active_mode()
        project EditorGizmo3D:
            mode = mode
            color = #00FF00FF
            size = 1.0

        let origin = xform.position
        let axis_len = 1.0

        emit debug.DrawDebugWireBox3D:
            center = origin
            size = vec3(1.0, 1.0, 1.0)
            color = #00FF00FF

        if mode == 1 or mode == 3:
            emit debug.DrawDebugLine3D:
                start = origin
                end = vec3(origin.x + axis_len, origin.y, origin.z)
                color = #E62937FF
            emit debug.DrawDebugLine3D:
                start = origin
                end = vec3(origin.x, origin.y + axis_len, origin.z)
                color = #00E430FF
            emit debug.DrawDebugLine3D:
                start = origin
                end = vec3(origin.x, origin.y, origin.z + axis_len)
                color = #0079F1FF

        if mode == 2:
            emit debug.DrawDebugCircle3D:
                center = origin
                radius = axis_len
                normal = vec3(1.0, 0.0, 0.0)
                color = #66BFFFFF

        if mode == 3:
            let tip = axis_len * 0.15
            emit debug.DrawDebugCube3D:
                center = vec3(origin.x + axis_len, origin.y, origin.z)
                size = vec3(tip, tip, tip)
                color = #E62937FF
            emit debug.DrawDebugCube3D:
                center = vec3(origin.x, origin.y + axis_len, origin.z)
                size = vec3(tip, tip, tip)
                color = #00E430FF
            emit debug.DrawDebugCube3D:
                center = vec3(origin.x, origin.y, origin.z + axis_len)
                size = vec3(tip, tip, tip)
                color = #0079F1FF

# One button per registered pub template, stacked down the left edge starting
# at (10, 40), each 140x26px with a 4px gap (30px stride). Iterates
# template_names() and gets each button's index via template_index(name)
# rather than an outer-scope counter, since bounded `for` can't mutate one
# across iterations. Button tint cycles a small fixed palette by index
# (idx % 6), not the template name — see design.md decision 6's accepted
# palette-tint drift from the old hash-based scheme. Click hit-testing and the
# EditorState writes happen directly here (self bound to EditorState), not in
# the generic DrawScreenRect renderer, since a generic per-event handler has
# no reference to mutate a foreign EditorState entity. Labels are projected
# onto palette_label_slot(idx) — see its doc comment for why a fixed entity
# pool is needed instead of one ScreenLabel per rule invocation.
rule EditorTemplatePalette:
    filter:
        EditorState

    # Runs in the input phase, before EditorSelection2D/3D and EditorPlace2D/3D
    # (see their after: EditorTemplatePalette), so a click that lands on a
    # palette button is consumed here and never reaches world-space
    # selection/raycast or template placement.
    on input:
        if not active:
            return

        if not input.pressed(EditorSelectClick):
            return

        let click_pos = input.mouse_position()

        for name in template_names():
            let idx = template_index(name)
            let x = 10.0
            let y = palette_button_y(idx)

            if click_pos.x >= x and click_pos.x <= x + 140.0 and click_pos.y >= y and click_pos.y <= y + 26.0:
                active_template = name
                mode = 4
                input.consume(EditorSelectClick)

    on render:
        let names = template_names()

        if not active:
            for name in names:
                let idx = template_index(name)
                let slot = palette_label_slot(idx)
                project labels.ScreenLabel to slot:
                    text = ""
                    position = vec2(0.0, 0.0)
                    font_size = 14
                    color = #FFFFFFFF
                    visible = false
            return

        for name in names:
            let idx = template_index(name)
            let x = 10.0
            let y = palette_button_y(idx)

            let tint = palette_color(idx)

            emit ui.DrawScreenRect:
                position = vec2(x, y)
                size = vec2(140.0, 26.0)
                color = tint
                filled = true
                thickness = 0.0

            let slot = palette_label_slot(idx)
            project labels.ScreenLabel to slot:
                text = name
                position = vec2(x + 6.0, y + 6.0)
                font_size = 14
                color = #FFFFFFFF
                visible = true

# Yellow 3px border spanning the full screen plus a top-left mode readout,
# drawn only while EditorState.active is true. A real, documented, DSL-visible
# rule for the first time — the prior overlay was unconditionally spliced into
# codegen with no DSL identity. The HUD ScreenLabel lives directly on the
# Editor entity (declared above) rather than a pool slot like the palette's:
# there's exactly one HUD label, always tied 1:1 to the singleton EditorState
# entity, so no per-frame dynamic count/indexing problem exists here.
rule EditorHUDOverlay:
    filter:
        EditorState
        labels.ScreenLabel

    on render:
        if not active:
            visible = false
            return

        emit ui.DrawScreenRect:
            position = vec2(0.0, 0.0)
            size = screen_size()
            color = #FFFF00FF
            filled = false
            thickness = 3.0

        text = strfmt.format("EDIT [{}]  F1:toggle  W:trans  E:rot  R:scale  T:place", mode_label(mode))
        position = vec2(10.0, 10.0)
        color = #FFFF00FF
        visible = true

# ── Editor Camera Navigation (2D) ─────────────────────────────────────────────
# Pan: right or middle drag (world follows the cursor). Zoom: wheel or -/=,
# clamped, scaled about the view center. Frame selected: F. The rig exists
# only while 2D edit mode is active, so no EditorState check is needed here.

rule EditorCameraNav2D:
    filter:
        EditorCamera2D

    on input:
        if input.down(EditorNavDrag) or input.down(EditorNavDragAlt):
            let delta = input.mouse_delta()
            let per_pixel = pan_speed / zoom
            view_center = vec2(view_center.x - delta.x * per_pixel, view_center.y - delta.y * per_pixel)

        let wheel = input.wheel_delta()
        if wheel != 0.0:
            zoom = math.clamp(zoom * (1.0 + wheel * zoom_speed), min_zoom, max_zoom)
        if input.pressed(EditorNavZoomIn):
            zoom = math.clamp(zoom * (1.0 + zoom_speed), min_zoom, max_zoom)
        if input.pressed(EditorNavZoomOut):
            zoom = math.clamp(zoom * (1.0 - zoom_speed), min_zoom, max_zoom)

        if input.pressed(EditorFrameSelected):
            let sel = query.first[EditorSelected]()
            if exists(sel):
                view_center = transform2d.world_position(sel)

        apply_camera_2d(view_center, zoom)

# ── Editor Camera Navigation (3D) ─────────────────────────────────────────────
# Orbit: right or middle drag. Pan: Shift + drag (focus slides parallel to the
# view plane, scaled by distance so it feels constant on screen). Dolly: wheel
# or -/=, clamped. Frame selected: F. The pose is recomputed from orbit state
# each frame: rotation = from_euler(pitch, yaw, 0), position = focus -
# forward(rotation) * distance.

rule EditorCameraNav3D:
    filter:
        EditorCamera3D

    on input:
        if input.down(EditorNavDrag) or input.down(EditorNavDragAlt):
            let delta = input.mouse_delta()
            if input.down(EditorNavPanModifier):
                let view_rot = quat.from_euler(pitch, yaw, 0.0)
                let right_dir = quat.right(view_rot)
                let up_dir = quat.up(view_rot)
                let per_pixel = pan_speed * distance
                let fx = focus.x + (up_dir.x * delta.y - right_dir.x * delta.x) * per_pixel
                let fy = focus.y + (up_dir.y * delta.y - right_dir.y * delta.x) * per_pixel
                let fz = focus.z + (up_dir.z * delta.y - right_dir.z * delta.x) * per_pixel
                focus = vec3(fx, fy, fz)
            else:
                yaw = yaw - delta.x * orbit_speed
                pitch = math.clamp(pitch - delta.y * orbit_speed, min_pitch, max_pitch)

        let wheel = input.wheel_delta()
        if wheel != 0.0:
            distance = math.clamp(distance * (1.0 - wheel * zoom_speed), min_distance, max_distance)
        if input.pressed(EditorNavZoomIn):
            distance = math.clamp(distance * (1.0 - zoom_speed), min_distance, max_distance)
        if input.pressed(EditorNavZoomOut):
            distance = math.clamp(distance * (1.0 + zoom_speed), min_distance, max_distance)

        if input.pressed(EditorFrameSelected):
            let sel = query.first[EditorSelected]()
            if exists(sel):
                focus = transform3d.world_position(sel)

        let rot = quat.from_euler(pitch, yaw, 0.0)
        let fwd = quat.forward(rot)
        let pos = vec3(focus.x - fwd.x * distance, focus.y - fwd.y * distance, focus.z - fwd.z * distance)
        apply_camera_3d(pos, rot)

# ── Editor Input Consumption ──────────────────────────────────────────────────
# Hides editor-owned controls from gameplay input queries while edit mode is
# active. This rule is deliberately declared LAST in std.editor: input
# handlers run in merged declaration order (stdlib modules before the root
# module), so every editor rule above has already queried its inputs this
# frame — consumption never blinds the editor itself — while gameplay handlers
# later in the frame observe the consumed state. Consumption is blanket rather
# than press-gated so down/released edges and same-key axis contributions of
# editor-owned controls stay invisible to gameplay for the whole edit session.

rule EditorInputConsume:
    filter:
        EditorState

    on input:
        # The toggle is editor-owned on both edges, including the press that
        # just deactivated edit mode in EditorModeToggle this frame.
        if input.pressed(EditorToggleActive):
            input.consume(EditorToggleActive)

        if active:
            input.consume(EditorToggleActive)
            input.consume(EditorModeTranslate)
            input.consume(EditorModeRotate)
            input.consume(EditorModeScale)
            input.consume(EditorModePlace)
            input.consume(EditorSelectClick)
            input.consume(EditorNavDrag)
            input.consume(EditorNavDragAlt)
            input.consume(EditorNavPanModifier)
            input.consume(EditorNavZoomIn)
            input.consume(EditorNavZoomOut)
            input.consume(EditorFrameSelected)
