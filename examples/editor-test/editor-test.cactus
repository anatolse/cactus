module editor_test

use std.transform.flat
use std.physics.flat
use std.camera.flat
use std.camera.viewport
use std.render.shapes
use std.editor

# ── Template Catalog (editor-spawnable via EditorPlace2D) ─────────────────────

pub template Box:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #FF4444FF
        visible = true

pub template PlayerSpawn:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #4488FFFF
        visible = true

# ── Camera ────────────────────────────────────────────────────────────────────
# User-authored camera entity. When edit mode activates (F1), this viewport is
# deactivated and an editor rig is spawned at the captured 2D pose (zoom and
# world-center from the last rendered frame). On exit the rig is destroyed and
# this viewport is restored — EditorCamera is never mutated.
#
# Navigation controls (while edit mode is active):
#   Right/middle drag    Pan world with the cursor
#   Scroll / - / =       Zoom in/out (clamped to [min_zoom, max_zoom])
#   F                    Frame the selected entity at its world position

pub entity EditorCamera:
    Camera:
        zoom = 64.0
        offset = vec2(0.0, 0.0)
    Viewport

# ── Initial Scene Entities ────────────────────────────────────────────────────

pub entity Player:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #4488FFFF
        visible = true
    EditorLocked

pub entity SpawnBox:
    LocalTransform:
        position = vec2(3.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #44FF44FF
        visible = true
