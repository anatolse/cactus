module commit_notify_loop_runtime

use std.core

# Every new Minion reacts to its own arrival by spawning one more. The
# arrival handler is on a cycle with itself, so each spawn's arrival waits
# for the next activation of the clock: one new Minion per activation.

trait Offspring

template Minion:
    Offspring

# `budget` only stops a regressed, unbounded loop so the test fails instead
# of hanging.
trait Spawner:
    var budget: int = 10000

entity Nursery:
    Spawner

rule Seed:
    on load:
        spawn Minion()

rule Respawn:
    on added Offspring:
        if Nursery[Spawner].budget <= 0:
            return
        Nursery[Spawner].budget -= 1
        spawn Minion()

# A targeted event that re-emits itself to its recipient advances one hop
# per activation and only ever reaches that recipient.

event Knock

trait Door:
    var knocks: int = 0

entity Front:
    Door

entity Back:
    Door

rule FirstKnock:
    on load:
        emit Knock to Front

rule Answer:
    each:
        Door as door

    on Knock:
        if door.knocks >= 1000:
            return
        door.knocks = door.knocks + 1
        emit Knock to self
