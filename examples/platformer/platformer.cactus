# ── Systems ──────────────────────────────────────────────────────────────────────

system ReadPlayerInput:
    filter:
        PlayerMotion

    on input:
        move_axis = input.axis(MoveX)
        jump_requested = input.pressed(Jump)

system MovementSystem:
    filter:
        WorldTransform
        PlayerMotion
        BoxCollider

    on tick:
        let previous_bottom = position.y + size.y

        if move_axis > 0.0:
            facing = FacingDirection.Right
        if move_axis < 0.0:
            facing = FacingDirection.Left

        velocity = vec2(move_axis * move_speed, velocity.y)
        if jump_requested:
            if jumps_remaining > 0:
                velocity = vec2(velocity.x, jump_force * -1.0)
                jumps_remaining = jumps_remaining - 1
                grounded = false
                jump_state = JumpState.Jumping
        jump_requested = false

        velocity = vec2(velocity.x, math.clamp(velocity.y + gravity * tick.dt, jump_force * -1.0, MAX_FALL_SPEED))

        position = vec2(math.clamp(position.x + velocity.x * tick.dt, 0.0, GROUND_WIDTH - size.x), position.y + velocity.y * tick.dt)
        grounded = false

        if velocity.y > 0.0 and jump_state == JumpState.Jumping:
            jump_state = JumpState.Falling

        let player_left = position.x
        let player_right = position.x + size.x
        let player_bottom = position.y + size.y

        if velocity.y >= 0.0:
            if player_right > PLATFORM1_X and player_left < PLATFORM1_X + PLATFORM1_WIDTH:
                if previous_bottom <= PLATFORM1_Y and player_bottom >= PLATFORM1_Y:
                    position = vec2(position.x, PLATFORM1_Y - size.y)
                    velocity = vec2(velocity.x, 0.0)
                    grounded = true
                    jumps_remaining = max_jumps
                    jump_state = JumpState.Grounded

            if player_right > PLATFORM2_X and player_left < PLATFORM2_X + PLATFORM2_WIDTH:
                if previous_bottom <= PLATFORM2_Y and player_bottom >= PLATFORM2_Y:
                    position = vec2(position.x, PLATFORM2_Y - size.y)
                    velocity = vec2(velocity.x, 0.0)
                    grounded = true
                    jumps_remaining = max_jumps
                    jump_state = JumpState.Grounded

            if player_right > PLATFORM3_X and player_left < PLATFORM3_X + PLATFORM3_WIDTH:
                if previous_bottom <= PLATFORM3_Y and player_bottom >= PLATFORM3_Y:
                    position = vec2(position.x, PLATFORM3_Y - size.y)
                    velocity = vec2(velocity.x, 0.0)
                    grounded = true
                    jumps_remaining = max_jumps
                    jump_state = JumpState.Grounded

        if position.y > GROUND_Y - size.y:
            position = vec2(position.x, GROUND_Y - size.y)
            velocity = vec2(velocity.x, 0.0)
            grounded = true
            jumps_remaining = max_jumps
            jump_state = JumpState.Grounded

system InvincibilitySystem:
    filter:
        Health

    on tick:
        if invincible_timer > 0.0:
            invincible_timer = invincible_timer - tick.dt

system PatrolSystem:
    filter:
        WorldTransform
        PatrolMotion

    on tick:
        position = vec2(position.x + patrol_speed * direction * tick.dt, position.y)

        if position.x >= patrol_max_x:
            direction = -1.0
            position = vec2(patrol_max_x, position.y)

        if position.x <= patrol_min_x:
            direction = 1.0
            position = vec2(patrol_min_x, position.y)

system CollectionSystem:
    filter:
        Collectible
        Shape

    on tick:
        if not collected:
            visible = true
        else:
            visible = false
