module square

use std.input as inp
use std.transform.flat as tf
use std.render.shapes as shapes

# ── Input Declarations ────────────────────────────────────────────────────────

input MoveX: axis
    negative = inp.Key.A
    positive = inp.Key.D

input MoveY: axis
    negative = inp.Key.W
    positive = inp.Key.S

# ── Constants ─────────────────────────────────────────────────────────────────

const:
    SPEED = 200.0

# ── Traits ────────────────────────────────────────────────────────────────────

trait MoveInput:
    var dx: float
    var dy: float

# ── Unit ──────────────────────────────────────────────────────────────────────

pub entity Square:
    tf.WorldTransform:
        position = vec2(375.0, 275.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    MoveInput:
        dx = 0.0
        dy = 0.0
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(50.0, 50.0)
        color = #6495EDFF
        visible = true

# ── Rules ─────────────────────────────────────────────────────────────────────

# ReadInputSystem: runs every input poll, stores axis values into MoveInput fields
rule ReadInputSystem:
    filter:
        MoveInput

    on input:
        dx = input.axis(MoveX)
        dy = input.axis(MoveY)

# MoveSystem: applies stored input deltas to position each tick
rule MoveSystem:
    filter:
        tf.WorldTransform
        MoveInput

    on tick:
        position = vec2(position.x + dx * SPEED * tick.dt, position.y + dy * SPEED * tick.dt)
