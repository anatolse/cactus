module main

use std.core
use std.input as inp
use std.query as query
use std.math as math
use std.math.vec3 as v3
use std.math.quat as quat
use std.transform.volume as tv
use std.physics.volume as physics
use std.collision.volume as collision
use std.render.meshes as meshes
use std.render.models as models
use std.render.text as text
use std.camera.volume as camera
use std.camera.viewport as viewport

const:
    WINDOW_WIDTH = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE = "First-Person Arena"
    TARGET_FPS = 60
    PLAYER_SPEED = 4.0
    PLAYER_RADIUS = 0.35
    PLAYER_HALF_HEIGHT = 0.9
    PLAYER_STEP_HEIGHT = 0.55
    CAMERA_EYE_HEIGHT = 0.65
    ENEMY_RADIUS = 0.35
    ENEMY_HALF_HEIGHT = 0.9
    ROBOT_SPEED = 0.6
    KNIGHT_SPEED = 0.7
    SPAWN_INTERVAL = 10.0
    CHARACTER_HEIGHT = 1.8
    BULLET_SPEED = 20.0
    BULLET_RADIUS = 0.12
    BULLET_LIFETIME = 2.0
    FIRE_COOLDOWN = 0.2
    DEATH_DURATION = 1.0
    HALF_PI = 1.57079633

asset BoxMesh: mesh = "models/box.mesh"
asset WhiteMaterial: material = "materials/white.mat"
asset Robot: model = "../model-renderer/art/robot.glb"
asset Knight: model = "../model-renderer/art/Crispoly-Characters-Mini-Red-Knight.glb"

input MoveForward: button
    key = inp.Key.W

input MoveBackward: button
    key = inp.Key.S

input MoveLeft: button
    key = inp.Key.A

input MoveRight: button
    key = inp.Key.D

input Fire: button
    mouse = inp.MouseButton.Left

pub trait Floor
pub trait PerimeterWall
pub trait BuildingWall
pub trait BuildingRoof
pub trait Stair
pub trait Solid
pub trait Walkable
pub trait CameraRig
pub trait Crosshair
pub trait GameOverLabel
pub trait Threat
pub trait RobotEnemy
pub trait KnightEnemy

pub trait Player:
    var game_over: bool = false
    var game_over_count: int = 0

pub trait KinematicActor:
    var radius: float = 0.35
    var half_height: float = 0.9
    var step_height: float = 0.55
    var ground_surface: float = 0.0

pub trait Enemy:
    var speed: float = 0.6
    var dying: bool = false
    var death_elapsed: float = 0.0
    var facing_yaw: float = 0.0

pub trait RobotSpawnPoint:
    var countdown: float = 0.0

pub trait KnightSpawnPoint:
    var countdown: float = 0.0

pub trait Shooter:
    var cooldown: float = 0.0

pub trait Bullet:
    var velocity: vec3 = vec3(0.0, 0.0, 0.0)
    var lifetime: float = 2.0
    var consumed: bool = false

event CameraPose:
    position: vec3
    yaw: float
    pitch: float

event SeparateActor:
    amount: vec3

event GroundCandidate:
    surface: float

event BulletContact:
    other: entity_id
    hit_enemy: bool

event EnemyHit
event GameOver
event GameOverPresentation

template BoxVisual:
    tv.WorldTransform:
        rotation = quat.identity()
    meshes.Renderer:
        mesh = BoxMesh
        material = WhiteMaterial
        visible = true
        cast_shadow = true

template SolidBox:
    use BoxVisual
    Solid
    physics.Collider:
        layer = 1
        mask = 1
    physics.BoxCollider

template WalkableBox:
    use BoxVisual
    Walkable
    physics.BoxCollider

template FloorBox:
    use WalkableBox
    Floor

template PerimeterBox:
    use SolidBox
    PerimeterWall

template BuildingBox:
    use SolidBox
    BuildingWall

template RoofBox:
    use WalkableBox
    BuildingRoof

template StairBox:
    use WalkableBox
    Stair

template EnemyBase:
    tv.WorldTransform:
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    models.ModelRenderer:
        color = #FFFFFFFF
    models.ModelAnimator:
        clip = 0
        playing = true
        speed = 1.0
        time = 0.0
    physics.Collider:
        layer = 2
        mask = 3
    physics.CapsuleCollider:
        radius = ENEMY_RADIUS
        height = CHARACTER_HEIGHT
    KinematicActor:
        radius = ENEMY_RADIUS
        half_height = ENEMY_HALF_HEIGHT
        step_height = PLAYER_STEP_HEIGHT
    Enemy
    Threat

template RobotTemplate:
    use EnemyBase
    RobotEnemy

template KnightTemplate:
    use EnemyBase
    KnightEnemy

template BulletTemplate:
    tv.WorldTransform:
        rotation = quat.identity()
        scale = vec3(BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0)
    meshes.Renderer:
        mesh = BoxMesh
        material = WhiteMaterial
        color = #FFD040FF
        visible = true
        cast_shadow = false
    physics.Collider:
        layer = 4
        mask = 3
    physics.BoxCollider:
        size = vec3(BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0, BULLET_RADIUS * 2.0)
    Bullet

