module std.core

# ── Standard Traits ───────────────────────────────────────────────────────────

# Marker trait: entities with KeepOnLoad survive scene transitions.
# Apply this to entities/templates that should NOT be destroyed on `load`.
# It is unrelated to `persist` fields, which decide what a save records.
pub trait KeepOnLoad

# Parent-child hierarchy relationship.
# Entities without Parent are treated as hierarchy roots.
pub trait Parent:
    var parent: entity_id

# ── Standard Runtime Root and Phases ──────────────────────────────────────────

# Injected exactly once by the host for each runtime frame.
pub extern event frame:
    dt: float

pub phase input:
    from:
        frame

pub phase fixed_tick:
    after:
        input
    every: 1.0 / 60.0
    max: 8

pub phase tick:
    after:
        fixed_tick
    dt: float = frame.dt

pub phase late_tick:
    after:
        tick
    dt: float = frame.dt

pub phase render:
    after:
        late_tick
    alpha: float = fixed_tick.alpha

# Ordinary lifecycle events (no fields)
pub event spawn

pub event destroy

pub event load

pub event unload

# ── Standard Rules ───────────────────────────────────────────────────────────

# SceneCleanup destroys every entity without KeepOnLoad on scene unload.
rule SceneCleanup:
    exclude:
        KeepOnLoad
    on unload:
        destroy
