module split_screen

use std.input as inp
use std.transform.flat as tf
use std.camera.flat as cam2d
use std.camera.viewport as vp
use std.render.shapes as shapes

# ── Input ─────────────────────────────────────────────────────────────────────

input MoveX: axis
    negative = inp.Key.A
    positive = inp.Key.D

input MoveY: axis
    negative = inp.Key.W
    positive = inp.Key.S

# ── Constants ─────────────────────────────────────────────────────────────────

const:
    SPEED = 200.0

# ── Traits ────────────────────────────────────────────────────────────────────

trait PlayerInput:
    var dx: float
    var dy: float

# ── Cameras ───────────────────────────────────────────────────────────────────

# Left viewport: full left half of the screen, normal zoom.
pub entity LeftCamera:
    cam2d.Camera:
        zoom = 1.0
        offset = vec2(0.0, 0.0)
    vp.Viewport:
        x = 0.0
        y = 0.0
        width = 0.5
        height = 1.0
        depth = 0
        clear_color = #1a1a2eFF

# Right viewport: full right half of the screen, 2× zoom (shows the same world, closer in).
pub entity RightCamera:
    cam2d.Camera:
        zoom = 2.0
        offset = vec2(0.0, 0.0)
    vp.Viewport:
        x = 0.5
        y = 0.0
        width = 0.5
        height = 1.0
        depth = 0
        clear_color = #1e3a1eFF

# ── Scene Entities ────────────────────────────────────────────────────────────

pub entity Player:
    tf.WorldTransform:
        position = vec2(0.0, 0.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(40.0, 40.0)
        color = #4488FFFF
        visible = true
    PlayerInput:
        dx = 0.0
        dy = 0.0

pub entity RedMarker:
    tf.WorldTransform:
        position = vec2(200.0, 0.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(40.0, 40.0)
        color = #FF4444FF
        visible = true

pub entity GreenMarker:
    tf.WorldTransform:
        position = vec2(-200.0, 0.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(40.0, 40.0)
        color = #44FF44FF
        visible = true

pub entity YellowMarker:
    tf.WorldTransform:
        position = vec2(0.0, -150.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    shapes.Shape:
        type = shapes.ShapeType.Rectangle
        size = vec2(40.0, 40.0)
        color = #FFDD00FF
        visible = true

# ── Systems ───────────────────────────────────────────────────────────────────

system ReadInputSystem:
    filter:
        PlayerInput

    on input:
        dx = input.axis(MoveX)
        dy = input.axis(MoveY)

system MoveSystem:
    filter:
        tf.WorldTransform
        PlayerInput

    on tick:
        position = vec2(position.x + dx * SPEED * tick.dt, position.y + dy * SPEED * tick.dt)
