module std.transform.flat

# ── 2D Hierarchical Transforms ────────────────────────────────────────────────

# Local/authored 2D transform relative to the entity's parent.
# position: local-space 2D position
# rotation: angle in radians (counter-clockwise)
# scale:    per-axis scale factor (1.0 = normal size)
pub trait LocalTransform:
    var position: vec2 = vec2(0.0, 0.0)
    var rotation: float = 0.0
    var scale: vec2 = vec2(1.0, 1.0)

# Derived 2D world transform after hierarchy propagation.
# position: world-space 2D position
# rotation: world-space angle in radians
# scale:    world-space per-axis scale
pub trait WorldTransform:
    var position: vec2 = vec2(0.0, 0.0)
    var rotation: float = 0.0
    var scale: vec2 = vec2(1.0, 1.0)

extern system TransformPropagation:
    filter:
        LocalTransform
        WorldTransform

# Returns WorldTransform.position for a live entity, or vec2(0,0) if stale.
pub extern func world_position(of: entity_id) vec2
