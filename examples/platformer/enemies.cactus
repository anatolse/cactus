module enemies

use player
use level

const:
    PATROL_SPEED = 2.0
    ENEMY_WIDTH = 32.0
    ENEMY_HEIGHT = 32.0
    ENEMY_COLOR = #CC3333
    DAMAGE_AMOUNT = 1

enum EnemyType:
    Walker
    Flyer

trait EnemyAI:
    var patrol_min_x: float
    var patrol_max_x: float
    var patrol_speed: float
    var direction: float
    var enemy_type: EnemyType
    let enemy_color: color
    let enemy_width: float
    let enemy_height: float

event PlayerDamaged:
    amount: int

event EnemyDefeated:
    position: vec2

pub unit WalkerEnemy1:
    Position:
        pos = vec2(400.0, 568.0)
        velocity = vec2(0.0, 0.0)
    EnemyAI:
        patrol_min_x = 350.0
        patrol_max_x = 550.0
        patrol_speed = PATROL_SPEED
        direction = 1.0
        enemy_type = EnemyType.Walker
        enemy_color = ENEMY_COLOR
        enemy_width = ENEMY_WIDTH
        enemy_height = ENEMY_HEIGHT

pub unit WalkerEnemy2:
    Position:
        pos = vec2(800.0, 568.0)
        velocity = vec2(0.0, 0.0)
    EnemyAI:
        patrol_min_x = 700.0
        patrol_max_x = 1000.0
        patrol_speed = PATROL_SPEED
        direction = 1.0
        enemy_type = EnemyType.Walker
        enemy_color = ENEMY_COLOR
        enemy_width = ENEMY_WIDTH
        enemy_height = ENEMY_HEIGHT

pub unit FlyerEnemy1:
    Position:
        pos = vec2(1100.0, 250.0)
        velocity = vec2(0.0, 0.0)
    EnemyAI:
        patrol_min_x = 1000.0
        patrol_max_x = 1250.0
        patrol_speed = PATROL_SPEED
        direction = 1.0
        enemy_type = EnemyType.Flyer
        enemy_color = ENEMY_COLOR
        enemy_width = ENEMY_WIDTH
        enemy_height = ENEMY_HEIGHT

system PatrolSystem:
    filter:
        Position as p
        EnemyAI as ai

    on tick:
        p.pos = p.pos + vec2(ai.patrol_speed * ai.direction * tick.dt, 0.0)

        if p.pos.x >= ai.patrol_max_x:
            ai.direction = -1.0
            p.pos = vec2(ai.patrol_max_x, p.pos.y)

        if p.pos.x <= ai.patrol_min_x:
            ai.direction = 1.0
            p.pos = vec2(ai.patrol_min_x, p.pos.y)

system EnemyCollisionSystem:
    filter:
        Position as p
        EnemyAI as ai

    on tick:
        let player_pos = get_player_position()
        let player_w = get_player_width()
        let player_h = get_player_height()

        let ox = aabb_overlap_x(player_pos.x, player_w, p.pos.x, ai.enemy_width)
        let oy = aabb_overlap_y(player_pos.y, player_h, p.pos.y, ai.enemy_height)

        if ox > 0.0 and oy > 0.0:
            if player_pos.y + player_h < p.pos.y + ai.enemy_height * 0.5:
                emit EnemyDefeated:
                    position = p.pos
            else:
                emit PlayerDamaged:
                    amount = DAMAGE_AMOUNT

event Collision:
    other: entity_id
    normal: vec2
    depth: float

system EnemyTraitMatchDemo:
    filter:
        EnemyAI as ai

    on Collision as c:
        match c.other:
            PlayerTag =>
                emit PlayerDamaged:
                    amount = DAMAGE_AMOUNT
            Collectible as col =>
                let ignored_points = col.point_value
            _ =>
                pass

system EnemyRenderer:
    filter:
        Position as p
        EnemyAI as ai

    on tick:
        draw_rect(p.pos, vec2(ai.enemy_width, ai.enemy_height), ai.enemy_color)
