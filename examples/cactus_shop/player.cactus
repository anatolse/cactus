module player

const:
    MOVE_SPEED = 5.0
    TURN_SPEED = 2.0
    CAMERA_DISTANCE = 8.0
    CAMERA_HEIGHT = 4.0
    START_HEALTH = 100
    START_COINS = 50

enum PlayerState:
    Idle
    Walking
    Shopping

trait Position:
    persist sync var position: vec3
    persist sync var rotation: quat

trait Health:
    persist sync var health: int = 100
    let max_health: int = 100

trait Wallet:
    persist sync var coins: int = 50

trait PlayerController:
    var state: PlayerState
    var move_speed: float
    var turn_speed: float

trait ThirdPersonCamera:
    var distance: float
    var height: float
    var target_offset: vec3

event PlayerMoved:
    position: vec3
    direction: vec3

event CoinSpent:
    amount: int
    remaining: int

pub entity Player:
    Position:
        position = vec3(0.0, 0.0, 0.0)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    Health:
        health = START_HEALTH
    Wallet:
        coins = START_COINS
    PlayerController:
        state = PlayerState.Idle
        move_speed = MOVE_SPEED
        turn_speed = TURN_SPEED
    ThirdPersonCamera:
        distance = CAMERA_DISTANCE
        height = CAMERA_HEIGHT
        target_offset = vec3(0.0, 1.5, 0.0)

func clamp_int(value: int, min_val: int, max_val: int) int:
    if value < min_val:
        return min_val
    if value > max_val:
        return max_val
    return value

system MovementSystem:
    filter:
        Position as p
        PlayerController as ctrl

    on tick:
        if ctrl.state == PlayerState.Shopping:
            return

        let input_x = get_input_axis_x()
        let input_z = get_input_axis_z()

        if input_x != 0.0 or input_z != 0.0:
            let direction = vec3(input_x, 0.0, input_z)
            p.position = p.position + direction * ctrl.move_speed * tick.dt
            ctrl.state = PlayerState.Walking
            emit PlayerMoved:
                position = p.position
                direction = direction
        else:
            ctrl.state = PlayerState.Idle

system CameraSystem:
    filter:
        Position as p
        ThirdPersonCamera as cam

    on tick:
        let cam_pos = p.position + vec3(0.0, cam.height, cam.distance * -1.0)
        let cam_target = p.position + cam.target_offset
        set_camera(cam_pos, cam_target)
