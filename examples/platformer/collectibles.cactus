module collectibles

use player
use level

const:
    GEM_SIZE = 16.0
    GEM_COLOR_BLUE = #4488FF
    GEM_COLOR_RED = #FF4444
    GEM_COLOR_GOLD = #FFD700
    BLUE_GEM_POINTS = 10
    RED_GEM_POINTS = 25
    GOLD_GEM_POINTS = 100

enum GemType:
    Blue
    Red
    Gold

trait Collectible:
    let point_value: int
    let gem_type: GemType
    let gem_color: color
    let gem_size: float
    var collected: bool

trait Score:
    persist var score: int
    persist var gems_collected: int

event GemCollected:
    point_value: int
    gem_type: GemType
    position: vec2

pub unit BlueGem1:
    Position:
        pos = vec2(250.0, 560.0)
        velocity = vec2(0.0, 0.0)
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        gem_color = GEM_COLOR_BLUE
        gem_size = GEM_SIZE
        collected = false

pub unit BlueGem2:
    Position:
        pos = vec2(350.0, 410.0)
        velocity = vec2(0.0, 0.0)
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        gem_color = GEM_COLOR_BLUE
        gem_size = GEM_SIZE
        collected = false

pub unit BlueGem3:
    Position:
        pos = vec2(650.0, 310.0)
        velocity = vec2(0.0, 0.0)
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        gem_color = GEM_COLOR_BLUE
        gem_size = GEM_SIZE
        collected = false

pub unit RedGem1:
    Position:
        pos = vec2(1000.0, 240.0)
        velocity = vec2(0.0, 0.0)
    Collectible:
        point_value = RED_GEM_POINTS
        gem_type = GemType.Red
        gem_color = GEM_COLOR_RED
        gem_size = GEM_SIZE
        collected = false

pub unit GoldGem1:
    Position:
        pos = vec2(1750.0, 260.0)
        velocity = vec2(0.0, 0.0)
    Collectible:
        point_value = GOLD_GEM_POINTS
        gem_type = GemType.Gold
        gem_color = GEM_COLOR_GOLD
        gem_size = GEM_SIZE
        collected = false

system CollectionSystem:
    filter:
        Position as p
        Collectible as col

    on tick:
        if col.collected == false:
            let player_pos = get_player_position()
            let player_w = get_player_width()
            let player_h = get_player_height()

            let ox = aabb_overlap_x(player_pos.x, player_w, p.pos.x, col.gem_size)
            let oy = aabb_overlap_y(player_pos.y, player_h, p.pos.y, col.gem_size)

            if ox > 0.0 and oy > 0.0:
                col.collected = true
                emit GemCollected:
                    point_value = col.point_value
                    gem_type = col.gem_type
                    position = p.pos

system ScoreSystem:
    filter:
        Score as s

    on GemCollected:
        s.score = s.score + GemCollected.point_value
        s.gems_collected = s.gems_collected + 1

system CollectibleRenderer:
    filter:
        Position as p
        Collectible as col

    on tick:
        if col.collected == false:
            draw_rect(p.pos, vec2(col.gem_size, col.gem_size), col.gem_color)
