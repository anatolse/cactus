        visible = true

pub unit FloatingPlatform3:
    WorldTransform:
        position = vec2(950.0, 280.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(180.0, 20.0)
        color = PLATFORM_COLOR
        visible = true

pub unit WalkerEnemy1:
    WorldTransform:
        position = vec2(400.0, 568.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
        color = ENEMY_COLOR
        visible = true
    PatrolMotion:
        patrol_min_x = 350.0
        patrol_max_x = 550.0
        patrol_speed = PATROL_SPEED
        direction = 1.0

pub unit WalkerEnemy2:
    WorldTransform:
        position = vec2(800.0, 568.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
        color = ENEMY_COLOR
        visible = true
    PatrolMotion:
        patrol_min_x = 700.0
        patrol_max_x = 1000.0
        patrol_speed = PATROL_SPEED
        direction = 1.0

pub unit BlueGem1:
    WorldTransform:
        position = vec2(250.0, 560.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(GEM_SIZE, GEM_SIZE)
        color = GEM_COLOR_BLUE
        visible = true
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        collected = false

pub unit BlueGem2:
    WorldTransform:
        position = vec2(350.0, 410.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(GEM_SIZE, GEM_SIZE)
        color = GEM_COLOR_BLUE
        visible = true
    Collectible:
        point_value = BLUE_GEM_POINTS
        gem_type = GemType.Blue
        collected = false

pub unit GoldGem1:
    WorldTransform:
        position = vec2(1000.0, 240.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(GEM_SIZE, GEM_SIZE)
        color = GEM_COLOR_GOLD
        visible = true
    Collectible:
        point_value = GOLD_GEM_POINTS
        gem_type = GemType.Gold
        collected = false

# ── Pure Functions ───────────────────────────────────────────────────────────────

func lerp(a: float, b: float, t: float) float:
    return a + (b - a) * t

func clamp_f(value: float, lo: float, hi: float) float:
    if value < lo: return lo
    if value > hi: return hi
    return value

func abs_f(v: float) float:
    if v < 0.0: return v * -1.0
    return v

# ── Systems ──────────────────────────────────────────────────────────────────────

system ReadPlayerInput:
    filter:
        PlayerMotion

    on input:
        move_axis = axis(MoveX)
        jump_requested = pressed(Jump)

system MovementSystem:
    filter:
        WorldTransform
        PlayerMotion

    on tick:
        if move_axis > 0.0:
            facing = FacingDirection.Right
        if move_axis < 0.0:
            facing = FacingDirection.Left

        velocity = vec2(move_axis * move_speed, velocity.y)
        if jump_requested:
            if jumps_remaining > 0:
                velocity = vec2(velocity.x, jump_force * -1.0)
                jumps_remaining = jumps_remaining - 1
                grounded = false
                jump_state = JumpState.Jumping
        jump_requested = false

        if grounded == false:
            velocity = vec2(velocity.x, velocity.y + gravity * tick.dt)

        position = vec2(position.x + velocity.x * tick.dt, position.y + velocity.y * tick.dt)

        if velocity.y > 0.0 and jump_state == JumpState.Jumping:
            jump_state = JumpState.Falling

        if position.y > GROUND_Y - PLAYER_HEIGHT:
            position = vec2(position.x, GROUND_Y - PLAYER_HEIGHT)
            velocity = vec2(velocity.x, 0.0)
            grounded = true
            jumps_remaining = max_jumps
            jump_state = JumpState.Grounded

system InvincibilitySystem:
    filter:
        Health

    on tick:
        if invincible_timer > 0.0:
            invincible_timer = invincible_timer - tick.dt

system PatrolSystem:
    filter:
        WorldTransform
        PatrolMotion

    on tick:
        position = vec2(position.x + patrol_speed * direction * tick.dt, position.y)

        if position.x >= patrol_max_x:
            direction = -1.0
            position = vec2(patrol_max_x, position.y)

        if position.x <= patrol_min_x:
            direction = 1.0
            position = vec2(patrol_min_x, position.y)

system CollectionSystem:
    filter:
        Collectible
        Shape

    on tick:
        if collected == false:
            visible = true
        else:
            visible = false
