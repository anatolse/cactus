module std.render.shapes

use std.transform.flat as tf

# ── Simple Primitive Shape Rendering Traits ──────────────────────────────────
# Passive traits — the backend reads these and renders automatically.

pub enum ShapeType:
    Rectangle
    # Circle reuses Shape.size.x as its diameter; size.y is ignored.
    Circle

pub trait Shape:
    var type: ShapeType
    var size: vec2
    var color: color = #FFFFFFFF
    var visible: bool = true
    # Offset from WorldTransform.position to the shape's un-rotated reference
    # point — the top-left corner for Rectangle, the center for Circle.
    # Default (0,0) means position itself is that reference point, matching
    # this renderer's original position-is-top-left (Rectangle) /
    # position-is-center (Circle) behavior. WorldTransform.rotation pivots
    # a Rectangle around position; set origin = size / 2 to rotate around the
    # rectangle's own center instead of its corner.
    var origin: vec2 = vec2(0.0, 0.0)

extern rule ShapeRenderer:
    filter:
        tf.WorldTransform
        Shape

    on render:
        reads:
            tf.WorldTransform
            Shape
        effects:
            graphics