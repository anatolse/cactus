module std.core

# ── Standard Traits ───────────────────────────────────────────────────────────

# Marker trait: entities with KeepOnLoad survive scene transitions.
# Apply this to entities/templates that should NOT be destroyed on `load`.
# It is unrelated to `persist` fields, which decide what a save records.
pub trait KeepOnLoad

# Parent-child hierarchy relationship. It is always a forest: `parent` changes
# only through `add Parent`, which does nothing when it would form a cycle.
# Entities without Parent are treated as hierarchy roots.
pub trait Parent:
    let parent: entity_id

# ── Standard Runtime Root and Phases ──────────────────────────────────────────

# Injected exactly once by the host for each runtime frame. `delta` is the
# same step as `dt`, as an exact duration.
pub extern event frame:
    dt: float
    delta: duration

pub phase input:
    from:
        frame

# Game time runs at Clock[Pace].scale times real time: 0 pauses fixed_tick,
# 0.5 is slow motion, 4 is fast-forward. Steps stay 1/60 s long; fixed_tick
# runs fewer or more of them, never more than `max:` per frame. The pace is
# read when fixed_tick starts, so a write from `input` applies this frame and
# a write from fixed_tick or later applies from the next frame.
pub phase fixed_tick:
    after:
        input
    every: 1s / 60
    max: 8
    rate: Clock[Pace].scale

pub phase tick:
    after:
        fixed_tick
    dt: float = frame.dt
    delta: duration = frame.delta

pub phase late_tick:
    after:
        tick
    dt: float = frame.dt
    delta: duration = frame.delta

pub phase render:
    after:
        late_tick
    alpha: float = fixed_tick.alpha

# ── Game Pace ─────────────────────────────────────────────────────────────────

# The one game clock. `tick`, `late_tick` and `render` keep real frame time.
pub single trait Pace:
    persist var scale: float clamped(min = 0.0, max = 1024.0) = 1.0

pub entity Clock:
    Pace
    KeepOnLoad

# Ordinary lifecycle events (no fields)
pub event load

pub event unload

# ── Standard Rules ───────────────────────────────────────────────────────────

# SceneCleanup destroys every entity without KeepOnLoad on scene unload.
rule SceneCleanup:
    without:
        KeepOnLoad
    on unload:
        destroy
