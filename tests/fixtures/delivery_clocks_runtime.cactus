module delivery_clocks_runtime

use std.core

# Occurrences on a delivery cycle wait for the next activation of the clock
# that produced them. A fixed_tick chain therefore advances once per
# repetition, a chain started at load advances once per host drain, and an
# acyclic chain of any length still finishes in one activation.

trait Gate:
    var opened: bool = false

trait Door:
    var knocks: int = 0

trait Seen:
    var count: int = 0

trait Echoes:
    var hops: int = 0

trait Counter:
    var chain_end: int = 0

entity Front:
    Gate
    Door
    Seen
    Echoes
    KeepOnLoad

entity Stats:
    Counter
    KeepOnLoad

event Knock

rule StartKnock:
    each:
        Gate as gate
    on fixed_tick:
        if gate.opened:
            return
        gate.opened = true
        emit Knock to self

# On a cycle with itself: one hop per fixed_tick repetition.
rule Answer:
    each:
        Door as door
    on Knock:
        if door.knocks >= 1000:
            return
        door.knocks = door.knocks + 1
        emit Knock to self

# Off the cycle: sees every Knock in the activation that produced it.
rule Observe:
    each:
        Seen as seen
    on Knock:
        seen.count = seen.count + 1

event Ping

rule FirstPing:
    on load:
        emit Ping to Front

# A cycle started at load runs on the host clock.
rule Echo:
    each:
        Echoes as echoes
    on Ping:
        if echoes.hops >= 1000:
            return
        echoes.hops = echoes.hops + 1
        emit Ping to self

# An acyclic chain of 100 handlers.
