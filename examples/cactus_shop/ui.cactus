module ui

use player
use shop

# Note: 'view' declarations are deferred from v0.2.
# HUD and shop UI rendering is backend-driven: the backend reads trait fields
# and renders them each frame. Systems below update the backend's display state.

const:
    HUD_PADDING = 10
    HUD_FONT_SIZE = 20
    HEALTH_BAR_WIDTH = 200
    HEALTH_BAR_HEIGHT = 20
    HEALTH_COLOR = #00FF00
    HEALTH_BG_COLOR = #333333
    COIN_COLOR = #FFD700

system HUDSystem:
    filter:
        Health as h
        Wallet as w

    on tick:
        # Backend reads h.health, h.max_health, w.coins to render the HUD.
        draw_hud(h.health, h.max_health, w.coins)

system ShopUISystem:
    filter:
        Inventory as inv
        Wallet as w

    on ShopOpened:
        # Backend opens shop panel, passing inventory and coin count.
        show_shop_panel(ShopOpened.shop_entity, inv.items, w.coins)

    on ShopClosed:
        # Backend closes shop panel.
        hide_shop_panel()
