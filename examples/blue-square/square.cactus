module square

use std.input
use std.transform.flat
use std.render.shapes

# ── Input Declarations ────────────────────────────────────────────────────────

input MoveX: axis
    negative = Key.A
    positive = Key.D

input MoveY: axis
    negative = Key.W
    positive = Key.S

# ── Constants ─────────────────────────────────────────────────────────────────

const:
    SPEED = 200.0

# ── Traits ────────────────────────────────────────────────────────────────────

trait MoveInput:
    var dx: float
    var dy: float

# ── Unit ──────────────────────────────────────────────────────────────────────

pub unit Square:
    WorldTransform:
        position = vec2(375.0, 275.0)
        rotation = 0.0
        scale = vec2(1.0, 1.0)
    MoveInput:
        dx = 0.0
        dy = 0.0
    Shape:
        type = ShapeType.Rectangle
        size = vec2(50.0, 50.0)
        color = #6495EDFF
        visible = true

# ── Systems ───────────────────────────────────────────────────────────────────

# ReadInputSystem: runs every input poll, stores axis values into MoveInput fields
system ReadInputSystem:
    filter:
        MoveInput

    on input:
        dx = input.axis(MoveX)
        dy = input.axis(MoveY)

# MoveSystem: applies stored input deltas to position each tick
system MoveSystem:
    filter:
        WorldTransform
        MoveInput

    on tick:
        position = vec2(position.x + dx * SPEED * tick.dt, position.y + dy * SPEED * tick.dt)
