module ui

use player
use collectibles

# Note: 'view' declarations are deferred from v0.2.
# HUD rendering is backend-driven: the backend reads Health and Score traits
# directly each frame and draws the health bar, score counter, and lives display.
# HUDSystem below notifies the backend to refresh the display.

const:
    HUD_PADDING = 10
    HUD_FONT_SIZE = 20
    HEALTH_BAR_WIDTH = 150
    HEALTH_BAR_HEIGHT = 16
    HEALTH_COLOR = #00CC44
    HEALTH_BG_COLOR = #333333
    SCORE_COLOR = #FFD700
    LIVES_COLOR = #FF6666

system HUDSystem:
    filter:
        Health as h
        Score as s

    on tick:
        # Backend reads h.health, h.max_health, h.lives, s.score to render HUD.
        # These trait fields are the source of truth for the display layer.
        draw_hud(h.health, h.max_health, h.lives, s.score)
