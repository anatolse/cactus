module std.camera.flat

# ── 2D Camera Traits & Systems ────────────────────────────────────────────────

# 2D orthographic camera configuration.
# zoom:     magnification factor (1.0 = normal, 2.0 = 2x zoom in)
# offset:   camera origin offset in world units (controls what is centered)
# rotation: camera rotation in radians
# Active camera selection is governed by std.camera.viewport.Viewport.
pub trait Camera:
    var zoom: float = 1.0
    var offset: vec2 = vec2(0.0, 0.0)
    var rotation: float = 0.0

# Smooth-follow camera that tracks a target entity's position.
# follow_entity: entity_id of the entity to follow
# offset:        additional offset from the target's position
# smoothing:     lerp speed (higher = snappier; 0 = instant)
pub trait FollowCamera:
    var follow_entity: entity_id
    var offset: vec2 = vec2(0.0, 0.0)
    var smoothing: float = 8.0

# FollowCameraSystem is not yet implemented — it requires entity-by-id field
# access which is not yet available in the language.
