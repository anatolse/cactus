entity Sun:
    meshes.DirectionalLight:
        direction = vec3(-0.4, -1.0, -0.2)
        color = #FFFFFFFF
        intensity = 1.0
        enabled = true

rule CursorLifecycle:
    filter:
        Player

    on load:
        inp.set_cursor_captured(true)

    on unload:
        inp.set_cursor_captured(false)

rule ReadPlayerLook:
    filter:
        Player
        camera.FirstPersonCamera as first_person
        tv.WorldTransform as transform

    on input:
        if game_over:
            return
        let delta = inp.mouse_delta()
        first_person.yaw = first_person.yaw - delta.x * first_person.sensitivity
        first_person.pitch = math.clamp(first_person.pitch - delta.y * first_person.sensitivity, -1.45, 1.45)
        transform.rotation = quat.from_euler(0.0, first_person.yaw, 0.0)

rule CursorCaptureToggle:
    filter:
        Player

    on input:
        if game_over:
            return
        if cursor_captured and input.pressed(ReleaseCursor):
            cursor_captured = false
            inp.set_cursor_captured(false)
            return
        if not cursor_captured and input.pressed(Fire):
            cursor_captured = true
            inp.set_cursor_captured(true)
            input.consume(Fire)

rule MovePlayer:
    filter:
        Player
        tv.WorldTransform as transform

    on fixed_tick:
        if game_over:
            return
        let move = vec3(0.0, 0.0, 0.0)
        let forward = quat.forward(transform.rotation)
        let right = quat.right(transform.rotation)
        if input.down(MoveForward):
            move += vec3(forward.x, 0.0, forward.z)
        if input.down(MoveBackward):
            move -= vec3(forward.x, 0.0, forward.z)
        if input.down(MoveRight):
            move += vec3(right.x, 0.0, right.z)
        if input.down(MoveLeft):
            move -= vec3(right.x, 0.0, right.z)
        if v3.length(move) > 0.0:
            let direction = v3.normalize(move)
            transform.position.x += direction.x * PLAYER_SPEED * fixed_tick.dt
            transform.position.z += direction.z * PLAYER_SPEED * fixed_tick.dt

rule BeginGrounding:
    filter:
        KinematicActor as actor

    on fixed_tick:
        actor.ground_surface = -1000.0

rule DetectActorSolidContact:
    pairs:
        actor:
            KinematicActor
            tv.WorldTransform
        box:
            Solid
            physics.BoxCollider
            tv.WorldTransform
    after:
        MovePlayer
        SeekPlayer

    on fixed_tick:
        let separation = collision.sphere_box_separation(actor.tv.WorldTransform.position, actor.KinematicActor.radius, box.tv.WorldTransform.position, box.physics.BoxCollider.size, box.tv.WorldTransform.rotation)
        if v3.length(separation) > 0.0:
            emit SeparateActor to actor:
                amount = separation

rule ResolveActorSolidContact:
    filter:
        KinematicActor
        tv.WorldTransform as transform

    on SeparateActor as contact:
        transform.position += contact.amount

rule DetectGroundCandidate:
    pairs:
        actor:
            KinematicActor
            tv.WorldTransform
        surface:
            Walkable
            physics.BoxCollider
            tv.WorldTransform
    after:
        MovePlayer
        SeekPlayer

    on fixed_tick:
        let actor_position = actor.tv.WorldTransform.position
        let surface_position = surface.tv.WorldTransform.position
        let half_size = surface.physics.BoxCollider.size / 2.0
        let top = surface_position.y + half_size.y
        let feet = actor_position.y - actor.KinematicActor.half_height
        let overlaps_x = math.abs(actor_position.x - surface_position.x) <= half_size.x + actor.KinematicActor.radius
        let overlaps_z = math.abs(actor_position.z - surface_position.z) <= half_size.z + actor.KinematicActor.radius
        if overlaps_x and overlaps_z and top <= feet + actor.KinematicActor.step_height:
            emit GroundCandidate to actor:
                surface = top

rule ApplyGroundCandidate:
    filter:
        KinematicActor as actor
        tv.WorldTransform as transform

    on GroundCandidate as candidate:
        if candidate.surface > actor.ground_surface:
            actor.ground_surface = candidate.surface
            transform.position.y = candidate.surface + actor.half_height

rule ComposeCameraPose:
    pairs:
        rig:
            CameraRig
            tv.WorldTransform
        body:
            Player
            tv.WorldTransform
            camera.FirstPersonCamera

    on late_tick:
        emit CameraPose to rig:
            position = body.tv.WorldTransform.position + vec3(0.0, CAMERA_EYE_HEIGHT, 0.0)
            yaw = body.camera.FirstPersonCamera.yaw
            pitch = body.camera.FirstPersonCamera.pitch

rule ApplyCameraPose:
    filter:
        CameraRig
        tv.WorldTransform as transform

    on CameraPose as pose:
        transform.position = pose.position
        transform.rotation = quat.compose(quat.from_euler(0.0, pose.yaw, 0.0), quat.from_euler(pose.pitch, 0.0, 0.0))

# Mirrors ComposeCameraPose/ApplyCameraPose above: the EnemyVisual child's
# WorldTransform isn't auto-composed by std.transform.volume's
# TransformPropagation (that only applies when the parent itself carries
# LocalTransform, which the Enemy root deliberately doesn't — see EnemyBase),
# so it's authored here instead, offset down by half_height from the
# collision root's torso-height position. Rotation travels as yaw/pitch
# floats rather than a quat event field to sidestep a compiler gap in event
# quat-field codegen (see AnimateEnemyDeath's death_pitch, the same pattern
# CameraPose already uses for the player's look rotation).
rule ComposeEnemyVisualPose:
    filter:
        Enemy as enemy
        tv.WorldTransform as transform

    on late_tick:
        for visual in query.children[EnemyVisual](of = self):
            emit EnemyVisualPose to visual:
                position = transform.position - vec3(0.0, ENEMY_HALF_HEIGHT, 0.0)
                yaw = enemy.facing_yaw + enemy.visual_yaw_offset
                pitch = enemy.death_pitch

rule ApplyEnemyVisualPose:
    filter:
        EnemyVisual
        tv.WorldTransform as transform

    on EnemyVisualPose as pose:
        transform.position = pose.position
        # Single from_euler call (not a two-step compose like
        # ApplyCameraPose) to exactly match how the root's own rotation is
        # built in SeekPlayer/AnimateEnemyDeath.
        transform.rotation = quat.from_euler(pose.pitch, pose.yaw, 0.0)

rule SpawnRobots:
    filter:
        RobotSpawnPoint as spawn_point
        tv.WorldTransform as transform

    on fixed_tick:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let model_scale = 1.0
        let bounds = models.bounds_size(Robot)
        if bounds.y > 0.0:
            model_scale = CHARACTER_HEIGHT / bounds.y
        spawn RobotTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                speed = ROBOT_SPEED
                visual_yaw_offset = HALF_PI * 2.0
            children:
                EnemyVisual:
                    tv.WorldTransform:
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Robot
                    models.ModelAnimator:
                        clip = ROBOT_RUN_CLIP
        spawn_point.countdown = SPAWN_INTERVAL

rule SpawnKnights:
    filter:
        KnightSpawnPoint as spawn_point
        tv.WorldTransform as transform

    on fixed_tick:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let model_scale = 1.0
        let bounds = models.bounds_size(Knight)
        if bounds.y > 0.0:
            model_scale = CHARACTER_HEIGHT / bounds.y
        spawn KnightTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                speed = KNIGHT_SPEED
            children:
                EnemyVisual:
                    tv.WorldTransform:
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Knight
                    models.ModelAnimator:
                        clip = KNIGHT_RUN_CLIP
        spawn_point.countdown = SPAWN_INTERVAL

rule SeekPlayer:
    filter:
        Enemy as enemy
        Threat
        tv.WorldTransform as transform

    on fixed_tick:
        if enemy.dying:
            return
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        let target_position = tv.world_position(player_entity)
        let delta = vec3(target_position.x - transform.position.x, 0.0, target_position.z - transform.position.z)
        let distance = v3.length(delta)
        if distance <= 0.0:
            return
        let direction = delta / distance
        enemy.facing_yaw = math.atan2(direction.x * -1.0, direction.z * -1.0)
        transform.rotation = quat.from_euler(0.0, enemy.facing_yaw, 0.0)
        transform.position += direction * enemy.speed * fixed_tick.dt

rule CooldownShooter:
    filter:
        Shooter as shooter

    on tick:
        if shooter.cooldown > 0.0:
            shooter.cooldown = math.max(0.0, shooter.cooldown - tick.dt)

rule FireBullet:
    filter:
        CameraRig
        Shooter as shooter
        tv.WorldTransform as transform
    after:
        CursorCaptureToggle

    on input:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        if not input.pressed(Fire) or shooter.cooldown > 0.0:
            return
        let direction = quat.forward(transform.rotation)
        spawn BulletTemplate:
            tv.WorldTransform:
                position = transform.position + direction * 0.5
            Bullet:
                velocity = direction * BULLET_SPEED
        shooter.cooldown = FIRE_COOLDOWN

rule MoveBullets:
    filter:
        Bullet as bullet
        tv.WorldTransform as transform

    on fixed_tick:
        if bullet.consumed:
            return
        transform.position += bullet.velocity * fixed_tick.dt
        bullet.lifetime -= fixed_tick.dt
        if bullet.lifetime <= 0.0:
            bullet.consumed = true
            destroy

rule DetectBulletSolidContact:
    pairs:
        bullet:
            Bullet
            tv.WorldTransform
        box:
            Solid
            physics.BoxCollider
            tv.WorldTransform

    on fixed_tick:
        if not bullet.Bullet.consumed:
            let separation = collision.sphere_box_separation(bullet.tv.WorldTransform.position, BULLET_RADIUS, box.tv.WorldTransform.position, box.physics.BoxCollider.size, box.tv.WorldTransform.rotation)
            if v3.length(separation) > 0.0:
                emit BulletContact to bullet:
                    other = box
                    hit_enemy = false

rule DetectBulletEnemyContact:
    pairs:
        bullet:
            Bullet
            tv.WorldTransform
        enemy:
            Enemy
            Threat
            KinematicActor
            tv.WorldTransform
    after:
        DetectBulletSolidContact

    on fixed_tick:
        if not bullet.Bullet.consumed and not enemy.Enemy.dying:
            let bullet_position = bullet.tv.WorldTransform.position
            let enemy_position = enemy.tv.WorldTransform.position
            let horizontal = vec3(bullet_position.x - enemy_position.x, 0.0, bullet_position.z - enemy_position.z)
            let close_horizontal = v3.length(horizontal) <= BULLET_RADIUS + enemy.KinematicActor.radius
            let close_vertical = math.abs(bullet_position.y - enemy_position.y) <= enemy.KinematicActor.half_height + BULLET_RADIUS
            if close_horizontal and close_vertical:
                emit BulletContact to bullet:
                    other = enemy
                    hit_enemy = true

rule ConsumeBulletContact:
    filter:
        Bullet as bullet

    on BulletContact as contact:
        if bullet.consumed:
            return
        bullet.consumed = true
        if contact.hit_enemy:
            emit EnemyHit to contact.other
        destroy

rule BeginRobotDeath:
    filter:
        RobotEnemy
        Enemy as enemy

    on EnemyHit:
        if enemy.dying:
            return
        enemy.dying = true
        enemy.death_elapsed = 0.0
        for visual in query.children[EnemyVisual](of = self):
            emit BeginDeathAnimation to visual:
                clip = ROBOT_DEATH_CLIP

rule BeginKnightDeath:
    filter:
        KnightEnemy
        Enemy as enemy

    on EnemyHit:
        if enemy.dying:
            return
        enemy.dying = true
        enemy.death_elapsed = 0.0
        for visual in query.children[EnemyVisual](of = self):
            emit BeginDeathAnimation to visual:
                clip = KNIGHT_DEATH_CLIP

rule ApplyBeginDeathAnimation:
    filter:
        EnemyVisual
        models.ModelAnimator as animator

    on BeginDeathAnimation as trigger:
        animator.clip = trigger.clip
        animator.time = 0.0
        animator.playing = true

# Enemy is the collision/logic root (grounded at torso height, see
# EnemyBase); the rendered model lives on a child EnemyVisual entity, so the
# alpha fade computed here is applied there via EnemyDeathProgress.
rule AnimateEnemyDeath:
    filter:
        Enemy as enemy
        tv.WorldTransform as transform

    on tick:
        if not enemy.dying:
            return
        enemy.death_elapsed += tick.dt
        if enemy.death_elapsed >= DEATH_DURATION:
            # Destroying self cascades to the EnemyVisual child (Parent-based
            # recursive destroy) — skip emitting to it this tick so nothing
            # tries to apply EnemyDeathProgress against an entity destroyed
            # in the same activation.
            destroy
            return
        let progress = math.clamp(enemy.death_elapsed / DEATH_DURATION, 0.0, 1.0)
        enemy.death_pitch = progress * HALF_PI
        transform.rotation = quat.from_euler(enemy.death_pitch, enemy.facing_yaw, 0.0)
        for visual in query.children[EnemyVisual](of = self):
            emit EnemyDeathProgress to visual:
                alpha = 1.0 - progress

rule ApplyEnemyDeathProgress:
    filter:
        EnemyVisual
        models.ModelRenderer as renderer

    on EnemyDeathProgress as progress:
        renderer.color = color(1.0, 1.0, 1.0, progress.alpha)

rule DetectPlayerContact:
    pairs:
        enemy:
            Enemy
            Threat
            KinematicActor
            tv.WorldTransform
        player:
            Player
            KinematicActor
            tv.WorldTransform

    on fixed_tick:
        if not enemy.Enemy.dying and not player.Player.game_over:
            if collision.spheres_overlap(enemy.tv.WorldTransform.position, enemy.KinematicActor.radius, player.tv.WorldTransform.position, player.KinematicActor.radius):
                emit GameOver to player

rule EndGame:
    filter:
        Player

    on GameOver:
        if game_over:
            return
        game_over = true
        game_over_count += 1
        cursor_captured = false
        inp.set_cursor_captured(false)
        let crosshair = query.first[Crosshair]()
        emit GameOverPresentation to crosshair
        let label = query.first[GameOverLabel]()
        emit GameOverPresentation to label

rule HideCrosshairOnGameOver:
    filter:
        Crosshair
        text.ScreenLabel as label

    on GameOverPresentation:
        label.visible = false

rule ShowGameOverLabel:
    filter:
        GameOverLabel
        text.ScreenLabel as label

    on GameOverPresentation:
        label.text = "GAME OVER"
        label.visible = true

rule RestartOnGameOver:
    filter:
        Player
        tv.WorldTransform as transform
        camera.FirstPersonCamera as first_person

    on input:
        if not game_over:
            return
        if not input.pressed(RestartGame):
            return
        game_over = false
        transform.position = vec3(0.0, PLAYER_HALF_HEIGHT, 10.0)
        transform.rotation = quat.identity()
        first_person.yaw = 0.0
        first_person.pitch = 0.0
        cursor_captured = true
        inp.set_cursor_captured(true)
        for enemy in query.all[Enemy]():
            emit RestartCleanup to enemy
        for bullet in query.all[Bullet]():
            emit RestartCleanup to bullet
        for spawn_point in query.all[RobotSpawnPoint]():
            emit RestartSpawnPoint to spawn_point
        for spawn_point in query.all[KnightSpawnPoint]():
            emit RestartSpawnPoint to spawn_point
        let crosshair = query.first[Crosshair]()
        emit RestartPresentation to crosshair
        let label = query.first[GameOverLabel]()
        emit RestartPresentation to label

rule RestartClearsEnemy:
    filter:
        Enemy

    on RestartCleanup:
        destroy

rule RestartClearsBullet:
    filter:
        Bullet

    on RestartCleanup:
        destroy

rule RestartResetsRobotSpawnPoint:
    filter:
        RobotSpawnPoint as spawn_point

    on RestartSpawnPoint:
        spawn_point.countdown = 0.0

rule RestartResetsKnightSpawnPoint:
    filter:
        KnightSpawnPoint as spawn_point

    on RestartSpawnPoint:
        spawn_point.countdown = 0.0

rule ShowCrosshairOnRestart:
    filter:
        Crosshair
        text.ScreenLabel as label

    on RestartPresentation:
        label.visible = true

rule HideGameOverLabelOnRestart:
    filter:
        GameOverLabel
        text.ScreenLabel as label

    on RestartPresentation:
        label.visible = false
