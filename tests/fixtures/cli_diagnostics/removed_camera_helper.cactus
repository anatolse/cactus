module removed_camera_helper

use std.core as core
use std.camera.volume as camera

trait Spot:
    var at: vec3 = vec3(0.0, 0.0, 0.0)

entity Thing:
    Spot

rule Aim:
    each:
        Spot as s

    on core.input:
        s.at = camera.screen_to_plane(vec2(0.0, 0.0), vec3(0.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0))
