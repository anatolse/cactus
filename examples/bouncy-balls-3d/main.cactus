module main

use std.transform.volume as tv
use std.render.meshes as meshes
use std.math as math
use std.math.vec3 as v3m
use std.math.quat as quat
use std.camera.volume as cam3d
use std.camera.viewport as vp
use std.input as inp
use std.random as rand

# std.math.PI is a stdlib module constant, not an extern func — imported
# module constants don't currently lower through codegen (only extern funcs
# do), so it's redeclared locally here rather than referenced as `math.PI`,
# matching particle-burst's own local TAU constant for the same reason.
const:
    TWO_PI = 6.283185307

# ── Assets ────────────────────────────────────────────────────────────────────
# Placeholder mesh geometry only (dsl-model-assets' `mesh`/material system,
# not real files): SphereMesh's path contains "sphere" so the backend
# resolves it to a placeholder sphere; BoxMesh does not, so it resolves to
# the default placeholder cube. Neither material path matches a keyword
# bucket in the backend's placeholder-color heuristic, so both resolve to
# white — every ball's authored Renderer.color multiplies white unchanged.

asset SphereMesh: mesh = "models/sphere_lowpoly.mesh"
asset BallMaterial: material = "materials/ball.mat"
asset BoxMesh: mesh = "models/box.mesh"
asset WallMaterial: material = "materials/wall.mat"

# ── Inputs ────────────────────────────────────────────────────────────────────

input SpawnBall: button
    mouse = inp.MouseButton.Left

# ── Traits ────────────────────────────────────────────────────────────────────

trait Ball:
    var velocity: vec3

trait SphereCollider:
    var radius: float

trait Wall

trait BoxCollider:
    var size: vec3

# BallSpawner: the singleton bootstrap entity's own trait, holding the one
# shared Rng both spawn rules below read-advance-write. Rng is functional
# (advance returns new state rather than mutating in place), so it needs a
# durable home outside any single ball - this is that home.
trait BallSpawner:
    var rng: rand.Rng

# ── Events ────────────────────────────────────────────────────────────────────

event WallBounce:
    normal: vec3

event BallBounce:
    new_velocity: vec3

# ── Rules ─────────────────────────────────────────────────────────────────────

# MoveBalls: integrates every ball's position from its current velocity. No
# gravity term — balls drift at constant speed between collisions.
rule MoveBalls:
    filter:
        Ball
        tv.WorldTransform

    on fixed_tick:
        position += velocity * fixed_tick.dt

# DetectWallContact: cross-domain pair producer (Ball x Wall), generalized
# from bouncy-bubbles' 2D DetectWallContact to vec3/quat. The wall's contact
# normal is not authored — it's derived each tick by rotating the fixed
# local outward direction (0, 1, 0) by the wall's current
# WorldTransform.rotation, so it always matches the wall's actual
# orientation. Overlap is a single oriented-box-vs-sphere test: the ball's
# position is rotated into the wall's local space via the inverse rotation,
# clamped to +/-size/2 there, then rotated back to world space to find the
# closest point on the box. This one code path handles every wall,
# axis-aligned or tilted, with no special-casing. Gated by a closing-speed
# check along the derived normal so a resting/sliding ball doesn't
# re-trigger every tick. Emits a targeted WallBounce to the ball side only.
rule DetectWallContact:
    pairs:
        ball:
            Ball
            SphereCollider
            tv.WorldTransform
        wall:
            Wall
            BoxCollider
            tv.WorldTransform

    on fixed_tick:
        let ball_pos = ball.tv.WorldTransform.position
        let wall_pos = wall.tv.WorldTransform.position
        let wall_rotation = wall.tv.WorldTransform.rotation
        let half_size = wall.BoxCollider.size / 2.0
        let local_pos = quat.rotate(quat.inverse(wall_rotation), ball_pos - wall_pos)
        let clamped_local = v3m.clamp(local_pos, half_size * -1.0, half_size)
        let closest_point = wall_pos + quat.rotate(wall_rotation, clamped_local)
        let normal = quat.rotate(wall_rotation, vec3(0.0, 1.0, 0.0))
        let overlapping = v3m.distance(ball_pos, closest_point) < ball.SphereCollider.radius
        let closing = v3m.dot(ball.Ball.velocity, normal) > 0.0
        if overlapping and closing:
            emit WallBounce to ball:
                normal = normal

# ResolveWallBounce: unary consumer. Reflects the ball's own velocity across
# the wall normal carried by the event (elastic reflection, speed-preserving).
rule ResolveWallBounce:
    filter:
        Ball

    on WallBounce as bounce:
        velocity = v3m.reflect(velocity, bounce.normal)

# DetectBallContact: same-domain pair producer (Ball x Ball), generalized
# from bouncy-bubbles' DetectBubbleContact. Per dsl-pair-relations this
# iterates the full directed product, including self-pairs, which the
# `a == b` guard rejects. For every overlapping, approaching directed tuple
# it computes `a`'s post-collision velocity via the standard mass-weighted
# (radius^2) 1D-along-normal elastic solve, reading both sides' current
# velocity — legal under the pair read-only rule since it's a pure read. The
# reverse tuple (b, a) independently computes and emits b's half from the
# same unmutated pre-collision state.
rule DetectBallContact:
    pairs:
        a:
            Ball
            SphereCollider
            tv.WorldTransform
        b:
            Ball
            SphereCollider
            tv.WorldTransform

    on fixed_tick:
        if a == b:
            return

        let pos_a = a.tv.WorldTransform.position
        let pos_b = b.tv.WorldTransform.position
        let radius_a = a.SphereCollider.radius
        let radius_b = b.SphereCollider.radius
        let dist = v3m.distance(pos_a, pos_b)

        if dist >= radius_a + radius_b:
            return

        let normal = (pos_b - pos_a) / dist
        let vel_a = a.Ball.velocity
        let vel_b = b.Ball.velocity
        let closing = v3m.dot(vel_a - vel_b, normal)

        if closing <= 0.0:
            return

        let mass_a = radius_a * radius_a
        let mass_b = radius_b * radius_b
        let v1n = v3m.dot(vel_a, normal)
        let v2n = v3m.dot(vel_b, normal)
        let v1n_prime = ((mass_a - mass_b) * v1n + 2.0 * mass_b * v2n) / (mass_a + mass_b)
        let delta = v1n_prime - v1n
        let new_velocity = vel_a + normal * delta
        emit BallBounce to a:
            new_velocity = new_velocity

# ResolveBallBounce: unary consumer. Applies the resolved post-collision
# velocity computed by DetectBallContact directly.
rule ResolveBallBounce:
    filter:
        Ball

    on BallBounce as bounce:
        velocity = bounce.new_velocity

# ── Templates ────────────────────────────────────────────────────────────────

# WallColliderTemplate / WallTemplate: shared collider defaults for every box
# face, split into two tiers because a template-backed entity may only
# override a trait its template already declares — it cannot omit or add
# one. WallColliderTemplate is the collider-only base (used directly by the
# camera-facing wall, which stays un-rendered); WallTemplate composes it and
# adds meshes.Renderer for the other 5 walls. All 6 faces are the same
# canonical thin slab (a 6x6 square, 0.3 thick along the wall's own local
# outward axis) — only WorldTransform.position/rotation vary per wall,
# deciding which world face a given wall instance represents (see
# DetectWallContact for how the outward normal falls out of rotation alone).
template WallColliderTemplate:
    tv.WorldTransform:
        scale = vec3(6.0, 0.3, 6.0)
    Wall
    BoxCollider:
        size = vec3(6.0, 0.3, 6.0)

template WallTemplate:
    use WallColliderTemplate
    meshes.Renderer:
        mesh = BoxMesh
        material = WallMaterial
        visible = true
        cast_shadow = true

# BallTemplate: shared render-mesh defaults for every ball. Position,
# velocity, collider radius, and render color vary per ball.
template BallTemplate:
    tv.WorldTransform
    Ball
    SphereCollider
    meshes.Renderer:
        mesh = SphereMesh
        material = BallMaterial
        visible = true
        cast_shadow = true

# ── Entities: box walls ──────────────────────────────────────────────────────
# A 6x6x6 cube (world-unit bounds -3..3 on every axis) centered at the
# origin, bounded by 6 thin static walls sharing WallTemplate's collider
# defaults. Each wall's outward contact normal is derived from its
# WorldTransform.rotation (see DetectWallContact) rather than authored.
# RightWall is tilted an extra 3 degrees off its cardinal -90 degree
# orientation to exercise the oriented-box collision path on a non-axis-
# aligned wall, directly mirroring bouncy-bubbles' RightWall (93 degrees)
# precedent lifted to quat. FrontWall (the +Z face, nearest the camera) has
# no meshes.Renderer, so the camera looks straight through it into the box.

entity TopWall from WallTemplate:
    tv.WorldTransform:
        position = vec3(0.0, 3.0, 0.0)
        rotation = quat.identity()

entity BottomWall from WallTemplate:
    tv.WorldTransform:
        position = vec3(0.0, -3.0, 0.0)
        rotation = quat.from_axis_angle(vec3(0.0, 0.0, 1.0), 3.14159265)  # 180 degrees

entity LeftWall from WallTemplate:
    tv.WorldTransform:
        position = vec3(-3.0, 0.0, 0.0)
        rotation = quat.from_axis_angle(vec3(0.0, 0.0, 1.0), 1.57079633)  # 90 degrees

entity RightWall from WallTemplate:
    tv.WorldTransform:
        position = vec3(3.0, 0.0, 0.0)
        rotation = quat.from_axis_angle(vec3(0.0, 0.0, 1.0), -1.51843645)  # -87 degrees: -90 + a 3-degree tilt

entity BackWall from WallTemplate:
    tv.WorldTransform:
        position = vec3(0.0, 0.0, -3.0)
        rotation = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), -1.57079633)  # -90 degrees

# FrontWall is from the collider-only base template: no meshes.Renderer, so
# this is the camera-facing open side of the box. Its Wall + BoxCollider
# still participate in collision identically to the other 5.
entity FrontWall from WallColliderTemplate:
    tv.WorldTransform:
        position = vec3(0.0, 0.0, 3.0)
        rotation = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), 1.57079633)  # 90 degrees

# ── Entities: ball spawner ───────────────────────────────────────────────────
# Singleton holding the one shared Rng both ball-spawning rules below
# read-advance-write. Not a Ball itself - just the durable RNG state.

entity Spawner:
    BallSpawner:
        rng = rand.seeded(42)

# ── Rules: ball spawning ─────────────────────────────────────────────────────
# Replaces the previous 8 static Ball1..Ball8 declarations. SpawnInitialBalls
# spawns the same 8 corner-position balls at load time, but with
# radius/velocity/color drawn from std.random instead of hand-picked per
# instance. SpawnBallOnClick adds one more ball per left-click, at the
# mouse's position on the box's z=0 plane, with no cap on total ball count.

# SpawnInitialBalls: k (0..7), read as 3 bits, gives the per-axis corner sign
# (bit0 -> x, bit1 -> y, bit2 -> z; 0 -> negative, 1 -> positive) - the same 8
# corners as the original Ball1..Ball8, just derived instead of hard-coded. k
# also doubles as the palette index, so the initial batch always gets 8
# distinct colors (per-ball radius/direction/speed are still independently
# sampled). Each draw advances the spawner's shared Rng first, so no two
# balls in the batch repeat the same draw.
rule SpawnInitialBalls:
    filter:
        BallSpawner

    on load:
        for k in range(0, 8):
            rng = rand.advance(rng)
            let ball_radius = rand.sample(rng, rand.uniform(0.15, 0.42))

            rng = rand.advance(rng)
            let z = rand.sample(rng, rand.uniform(-1.0, 1.0))
            rng = rand.advance(rng)
            let theta = rand.sample(rng, rand.uniform(0.0, TWO_PI))
            let planar = math.sqrt(1.0 - z * z)
            let dir = vec3(planar * math.cos(theta), planar * math.sin(theta), z)

            rng = rand.advance(rng)
            let speed = rand.sample(rng, rand.uniform(0.8, 1.6))

            let x_sign = ((k % 2) * 2.0) - 1.0
            let y_sign = (((k / 2) % 2) * 2.0) - 1.0
            let z_sign = (((k / 4) % 2) * 2.0) - 1.0

            spawn BallTemplate:
                tv.WorldTransform:
                    position = vec3(x_sign * 1.5, y_sign * 1.2, z_sign * 1.5)
                    scale = vec3(ball_radius, ball_radius, ball_radius)
                Ball:
                    velocity = dir * speed
                SphereCollider:
                    radius = ball_radius
                meshes.Renderer:
                    color = rand.palette_color(k)

# SpawnBallOnClick: one ball per left-click press-edge, positioned at the
# mouse's projection onto the box's z=0 plane. Radius is sampled first so the
# wall-clearance clamp below can size its margin from this ball's own
# radius - the wall's inner face sits at |axis| = 3.0 - 0.3 = 2.7 (matching
# DetectWallContact's margin math), so clamping to +/-(2.7 - radius) keeps
# the spawned sphere clear of the walls. No cap on total ball count.
rule SpawnBallOnClick:
    filter:
        BallSpawner

    on input:
        if not input.pressed(SpawnBall):
            return

        let spawn_point = cam3d.screen_to_plane(input.mouse_position(), vec3(0.0, 0.0, 0.0), vec3(0.0, 0.0, 1.0))

        rng = rand.advance(rng)
        let ball_radius = rand.sample(rng, rand.uniform(0.15, 0.42))
        let margin = 2.7 - ball_radius
        let clamped = v3m.clamp(spawn_point, vec3(margin * -1.0, margin * -1.0, 0.0), vec3(margin, margin, 0.0))

        rng = rand.advance(rng)
        let z = rand.sample(rng, rand.uniform(-1.0, 1.0))
        rng = rand.advance(rng)
        let theta = rand.sample(rng, rand.uniform(0.0, TWO_PI))
        let planar = math.sqrt(1.0 - z * z)
        let dir = vec3(planar * math.cos(theta), planar * math.sin(theta), z)

        rng = rand.advance(rng)
        let speed = rand.sample(rng, rand.uniform(0.8, 1.6))

        rng = rand.advance(rng)
        let color_index = rand.sample_int(rng, rand.uniform_int(0, 7))

        spawn BallTemplate:
            tv.WorldTransform:
                position = clamped
                scale = vec3(ball_radius, ball_radius, ball_radius)
            Ball:
                velocity = dir * speed
            SphereCollider:
                radius = ball_radius
            meshes.Renderer:
                color = rand.palette_color(color_index)

# ── Entities: lighting and camera ─────────────────────────────────────────────
# Two point lights inside the box illuminate the balls and walls (same
# PointLight pattern as examples/model-renderer); no shadow-casting work is
# needed since cast_shadow is already a no-op in the renderer today. The
# camera is a single static Camera + Viewport, positioned outside the box on
# the open (FrontWall) side so nothing blocks its view of the interior.

entity KeyLight:
    tv.WorldTransform:
        position = vec3(-2.5, 2.5, 2.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #FFF4E0FF
        intensity = 0.7
        range = 12.0
        enabled = true

entity FillLight:
    tv.WorldTransform:
        position = vec3(2.5, -2.0, -2.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #C0D8FFFF
        intensity = 0.5
        range = 12.0
        enabled = true

entity MainCamera:
    tv.WorldTransform:
        position = vec3(0.0, 1.0, 8.0)
        rotation = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), -0.15)
        scale = vec3(1.0, 1.0, 1.0)
    cam3d.Camera:
        fov_y = 60.0
        near = 0.1
        far = 100.0
    vp.Viewport:
        x = 0.0
        y = 0.0
        width = 1.0
        height = 1.0
        depth = 0
        clear_color = #12121AFF
