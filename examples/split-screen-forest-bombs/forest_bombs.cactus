module forest_bombs

# Split-screen forest bombs — a small 3D gameplay slice.
#
# Two local players share the screen (left/right viewports). Each player runs
# around a bounded 3D forest of growing blocky trees and throws orange bombs.
# A bomb flies on an authored projectile arc; when it hits the ground it
# explodes, using a 3D overlap-sphere world query to find nearby tree roots and
# destroy the whole trees it caught, scoring one point per felled tree.
#
# Kept intentionally minimal: no minimap, no arrow indicator, no
# render-to-texture, and no UI DSL dependency.

# Task 1.2 — required stdlib surfaces. std.core provides the Parent trait that
# hierarchical `children:` templates wire on generated child entities.
use std.core
use std.input as inp
use std.math as math
use std.math.quat as quat
use std.random as rand
use std.transform.volume as tv
use std.render.meshes as meshes
use std.camera.volume as cam3d
use std.camera.viewport as vp
use std.physics.volume.query as query

# ── Constants ─────────────────────────────────────────────────────────────────

const:
    WINDOW_TITLE  = "Split-Screen Forest Bombs"
    WINDOW_WIDTH  = 1280
    WINDOW_HEIGHT = 720
    TARGET_FPS    = 60

    PLAYER_SPEED   = 6.0
    GROUND_Y       = 0.0
    START_BOMBS    = 8
    THROW_COOLDOWN = 0.4

    # Authored projectile launch and gravity for the bomb arc.
    THROW_UP       = 6.0
    THROW_SPEED    = 9.0
    BOMB_GRAVITY   = 12.0
    BOMB_RADIUS    = 3.5

    # Player locomotion and first-person camera.
    PLAYER_BODY_Y  = 0.6
    EYE_HEIGHT     = 1.5
    TURN_SPEED     = 2.5
    FLY_SPEED      = 4.0

# ── Assets (placeholder mesh/material handles) ────────────────────────────────
# Task 1.3 — a shared unit box mesh plus one material per themed surface.

asset BoxMesh:          mesh     = "models/box.mesh"
asset CapsuleMesh:      mesh     = "models/capsule.mesh"
asset SphereMesh:       mesh     = "models/sphere_lowpoly.mesh"
asset GroundMaterial:   material = "materials/ground_green.mat"
asset PlayerMaterial:   material = "materials/player_blue.mat"
asset BombMaterial:     material = "materials/bomb_orange.mat"
asset TrunkMaterial:    material = "materials/trunk_brown.mat"
asset CrownMaterial:    material = "materials/crown_green.mat"

# ── Input actions ─────────────────────────────────────────────────────────────
# Task 2.1 — distinct keyboard mappings per player.

# Player 1: WASD to move, Space to throw.
input P1MoveX: axis
    negative = inp.Key.A
    positive = inp.Key.D

input P1MoveZ: axis
    negative = inp.Key.S
    positive = inp.Key.W

input P1Throw: button
    key = inp.Key.Space

input P1FlyAxis: axis
    negative = inp.Key.R
    positive = inp.Key.F

# Player 2: arrow keys to move, Enter to throw.
input P2MoveX: axis
    negative = inp.Key.Left
    positive = inp.Key.Right

input P2MoveZ: axis
    negative = inp.Key.Down
    positive = inp.Key.Up

input P2Throw: button
    key = inp.Key.Enter

input P2FlyAxis: axis
    negative = inp.Key.PageUp
    positive = inp.Key.PageDown

# ── Gameplay traits ───────────────────────────────────────────────────────────

# Task 1.4 — player traits: identity markers, movement input, bomb inventory,
# and a tree-hit score counter.
trait Player1Tag
trait Player2Tag

trait PlayerInput:
    var move_x: float = 0.0
    var move_z: float = 0.0
    var throw_pressed: bool = false
    var fly: float = 0.0

trait BombInventory:
    var bombs_left: int = 8
    var throw_cooldown: float = 0.0

trait Score:
    var trees_hit: int = 0

# Task 1.5 — tree traits. The logical root is the queryable/destructible tree;
# it also carries the trunk's growth data. The crown is a child entity created
# by the hierarchical TreeTemplate with a generated `Parent` relation, so
# destroying the root fells the whole tree — no shared instance ids needed.
trait TreeRoot

trait TreeCrown

trait TreeGrowth:
    var progress: float = 0.0
    let target_scale: float = 1.0
    let slowdown: float = 3.0
    let base_scale: vec3 = vec3(1.0, 1.0, 1.0)

trait TreeRng:
    var rng: rand.Rng = rand.seeded(0)
    let wobble: rand.Uniform = rand.uniform(-0.04, 0.04)

# Task 1.6 — bomb traits: owning player, authored velocity, gravity, blast
# radius, and an explosion latch.
trait Bomb:
    var owner: entity_id
    var velocity: vec3 = vec3(0.0, 0.0, 0.0)
    let gravity: float = 12.0
    let radius: float = 3.0
    var exploded: bool = false

# ── Events ────────────────────────────────────────────────────────────────────

# Sent to the throwing player when its bomb fells a tree.
event TreeHit:
    count: int
    thrower: entity_id

# ── Templates ─────────────────────────────────────────────────────────────────

# Spawned when a player throws. Orange box on an authored projectile arc.
template BombTemplate:
    tv.WorldTransform:
        scale    = vec3(0.6, 0.6, 0.6)
    meshes.Renderer:
        mesh        = SphereMesh
        material    = BombMaterial
    Bomb:
        velocity = vec3(0.0, THROW_UP, -THROW_SPEED)
        gravity  = BOMB_GRAVITY
        radius   = BOMB_RADIUS
        exploded = false

# A whole tree is one hierarchical template: the brown trunk is the root node
# the gameplay queries and destroys, and the green crown box is a `children:`
# entity that receives a generated `Parent` relation to the trunk. Each node
# grows from its own TreeGrowth data. Parentage does not move the crown —
# crown positions stay authored per tree.
template TreeTemplate:
    tv.WorldTransform:
        scale    = vec3(0.4, 1.2, 0.4)
    meshes.Renderer:
        mesh        = BoxMesh
        material    = TrunkMaterial
    TreeRoot
    TreeGrowth:
        progress     = 0.0
        target_scale = 1.0
        slowdown     = 3.0
        base_scale   = vec3(0.4, 1.2, 0.4)
    TreeRng:
        rng    = rand.seeded(0)
        wobble = rand.uniform(-0.04, 0.04)

    children:
        entity Crown:
            tv.WorldTransform:
                scale    = vec3(1.4, 1.4, 1.4)
            meshes.Renderer:
                mesh        = BoxMesh
                material    = CrownMaterial
            TreeCrown
            TreeGrowth:
                progress     = 0.0
                target_scale = 1.0
                slowdown     = 3.0
                base_scale   = vec3(1.4, 1.4, 1.4)
            TreeRng:
                rng    = rand.seeded(0)
                wobble = rand.uniform(-0.04, 0.04)

# ── Scene: players + split-screen cameras ─────────────────────────────────────
# Task 2.1/2.2/2.3 — each player has a visible gameplay body plus a separate
# chase camera entity. The camera carries the same player input tag so it moves
# with the player, but it does not render a mesh or throw bombs.

pub entity Player1:
    tv.WorldTransform:
        position = vec3(-3.0, PLAYER_BODY_Y, 8.0)
        scale    = vec3(0.5, 0.5, 0.5)
    meshes.Renderer:
        mesh        = CapsuleMesh
        material    = PlayerMaterial
    PlayerInput:
        move_x        = 0.0
        move_z        = 0.0
        throw_pressed = false
    BombInventory:
        bombs_left    = START_BOMBS
        throw_cooldown = 0.0
    Score:
        trees_hit = 0
    Player1Tag

pub entity Player1Camera:
    tv.WorldTransform:
        position = vec3(-3.0, PLAYER_BODY_Y + EYE_HEIGHT, 8.0)
    cam3d.Camera:
        far   = 500.0
    vp.Viewport:
        width       = 0.5
        clear_color = #223047FF
    PlayerInput:
        move_x        = 0.0
        move_z        = 0.0
        throw_pressed = false
    Player1Tag

pub entity Player2:
    tv.WorldTransform:
        position = vec3(3.0, PLAYER_BODY_Y, 8.0)
        scale    = vec3(0.5, 0.5, 0.5)
    meshes.Renderer:
        mesh        = CapsuleMesh
        material    = PlayerMaterial
    PlayerInput:
        move_x        = 0.0
        move_z        = 0.0
        throw_pressed = false
    BombInventory:
        bombs_left    = START_BOMBS
        throw_cooldown = 0.0
    Score:
        trees_hit = 0
    Player2Tag

pub entity Player2Camera:
    tv.WorldTransform:
        position = vec3(3.0, PLAYER_BODY_Y + EYE_HEIGHT, 8.0)
    cam3d.Camera:
        far   = 500.0
    vp.Viewport:
        x           = 0.5
        width       = 0.5
        clear_color = #2A2440FF
    PlayerInput:
        move_x        = 0.0
        move_z        = 0.0
        throw_pressed = false
    Player2Tag

# Task 2.4 — ground plane and a sun light for a readable 3D scene.
pub entity Ground:
    tv.WorldTransform:
        position = vec3(0.0, -0.5, 0.0)
        scale    = vec3(60.0, 1.0, 60.0)
    meshes.Renderer:
        mesh        = BoxMesh
        material    = GroundMaterial
        cast_shadow = false

pub entity SunLight:
    tv.WorldTransform:
        position = vec3(0.0, 20.0, 0.0)
    meshes.DirectionalLight:
        direction = vec3(-0.3, -1.0, -0.2)
        color     = #FFF3D6FF
        intensity = 1.1
    meshes.PointLight:
        color     = #FFF3D6FF
        intensity = 2.8
        range     = 45.0

pub entity FillLight:
    tv.WorldTransform:
        position = vec3(-8.0, 6.0, 10.0)
    meshes.PointLight:
        color     = #BBD7FFFF
        intensity = 1.4
        range     = 35.0

# ── Scene: the forest ─────────────────────────────────────────────────────────
# Task 2.5/3.1 — a bounded, deterministically-varied forest. Each tree is one
# hierarchical TreeTemplate instance: the trunk root plus a Crown child wired
# by a generated Parent relation, with varied X/Z positions, target scale
# factors, and growth slowdown values. Scatter positions are authored; per-node
# Rng (from std.random) drives independent growth-rate wobble so each entity
# grows at a slightly different pace. Nested `children:` overrides address the
# crown by role.

pub entity Tree1 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(-7.0, 0.0, 2.0)
    TreeGrowth:
        target_scale = 1.0
        slowdown     = 2.5
    TreeRng:
        rng = rand.seeded(1)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(-7.0, 1.6, 2.0)
            TreeGrowth:
                target_scale = 1.0
                slowdown     = 2.5
            TreeRng:
                rng = rand.seeded(101)

pub entity Tree2 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(-3.0, 0.0, -1.0)
    TreeGrowth:
        target_scale = 1.3
        slowdown     = 3.5
    TreeRng:
        rng = rand.seeded(2)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(-3.0, 1.6, -1.0)
            TreeGrowth:
                target_scale = 1.3
                slowdown     = 3.5
            TreeRng:
                rng = rand.seeded(102)

pub entity Tree3 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(2.0, 0.0, 1.0)
    TreeGrowth:
        target_scale = 0.8
        slowdown     = 2.0
    TreeRng:
        rng = rand.seeded(3)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(2.0, 1.6, 1.0)
            TreeGrowth:
                target_scale = 0.8
                slowdown     = 2.0
            TreeRng:
                rng = rand.seeded(103)

pub entity Tree4 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(6.0, 0.0, -3.0)
    TreeGrowth:
        target_scale = 1.5
        slowdown     = 4.0
    TreeRng:
        rng = rand.seeded(4)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(6.0, 1.6, -3.0)
            TreeGrowth:
                target_scale = 1.5
                slowdown     = 4.0
            TreeRng:
                rng = rand.seeded(104)

pub entity Tree5 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(-5.0, 0.0, -5.0)
    TreeGrowth:
        target_scale = 1.1
        slowdown     = 3.0
    TreeRng:
        rng = rand.seeded(5)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(-5.0, 1.6, -5.0)
            TreeGrowth:
                target_scale = 1.1
                slowdown     = 3.0
            TreeRng:
                rng = rand.seeded(105)

pub entity Tree6 from TreeTemplate:
    tv.WorldTransform:
        position = vec3(3.0, 0.0, -7.0)
    TreeGrowth:
        target_scale = 0.9
        slowdown     = 2.2
    TreeRng:
        rng = rand.seeded(6)
    children:
        Crown:
            tv.WorldTransform:
                position = vec3(3.0, 1.6, -7.0)
            TreeGrowth:
                target_scale = 0.9
                slowdown     = 2.2
            TreeRng:
                rng = rand.seeded(106)

# ── Rules ─────────────────────────────────────────────────────────────────────

# Task 3.3 — read each player's own keyboard mapping into shared input state.
rule ReadPlayer1Input:
    filter:
        PlayerInput
        Player1Tag

    on input:
        move_x = input.axis(P1MoveX)
        move_z = input.axis(P1MoveZ)
        throw_pressed = input.down(P1Throw)
        fly = input.axis(P1FlyAxis)

rule ReadPlayer2Input:
    filter:
        PlayerInput
        Player2Tag

    on input:
        move_x = input.axis(P2MoveX)
        move_z = input.axis(P2MoveZ)
        throw_pressed = input.down(P2Throw)
        fly = input.axis(P2FlyAxis)

# Task 3.3 — move both players on the X/Z ground plane. The camera follows for
# free because each player entity owns its own viewport camera.
rule MovePlayer:
    filter:
        tv.WorldTransform
        PlayerInput

    on tick:
        rotation = quat.rotate_local(rotation, quat.from_euler(0, -move_x * TURN_SPEED * tick.dt, 0))
        let fwd = quat.forward(rotation)
        position = vec3(position.x + fwd.x * move_z * PLAYER_SPEED * tick.dt, position.y + fly * FLY_SPEED * tick.dt, position.z + fwd.z * move_z * PLAYER_SPEED * tick.dt)

# Task 3.2 — grow trees over time. Trunk and crown each scale from their own
# growth data; slowdown stretches how long a tree takes to reach full size.
# std.random drives a per-entity wobble so each piece grows at a slightly
# different pace, producing natural-looking variation without hand-authored noise.
rule GrowTrees:
    filter:
        tv.WorldTransform
        TreeGrowth
        TreeRng

    on tick:
        rng = rand.advance(rng)
        let noise = rand.sample(rng, wobble)
        progress = math.min(progress + (tick.dt * (1.0 + noise)) / slowdown, 1.0)
        let s = target_scale * (0.35 + 0.65 * progress)
        scale = vec3(base_scale.x * s, base_scale.y * s, base_scale.z * s)

# Task 3.4 — throw a bomb: consume one from inventory and spawn an orange bomb
# with authored launch velocity, tagged with its owning player.
rule ThrowBomb:
    filter:
        tv.WorldTransform
        PlayerInput
        BombInventory

    on tick:
        if throw_cooldown > 0.0:
            throw_cooldown = throw_cooldown - tick.dt

        if throw_pressed and bombs_left > 0 and throw_cooldown <= 0.0:
            let fwd = quat.forward(rotation)
            spawn BombTemplate:
                tv.WorldTransform:
                    position = vec3(position.x, position.y + EYE_HEIGHT, position.z)
                    rotation = quat.identity()
                    scale    = vec3(0.6, 0.6, 0.6)
                Bomb:
                    owner    = self
                    velocity = vec3(fwd.x * THROW_SPEED, fwd.y * THROW_SPEED + THROW_UP, fwd.z * THROW_SPEED)
                    exploded = false
            bombs_left     = bombs_left - 1
            throw_cooldown = THROW_COOLDOWN

# Task 3.5/3.6/3.7 — simulate bomb flight; on ground impact, explode: query the
# tree roots inside the blast radius and destroy each root. The crown is a
# hierarchy child of the root, so the existing Parent-based recursive destroy
# fells the whole tree. Score one point per felled tree for the thrower.
rule SimulateBomb:
    filter:
        tv.WorldTransform
        Bomb

    on tick:
        velocity = vec3(velocity.x, velocity.y - gravity * tick.dt, velocity.z)
        position = vec3(position.x + velocity.x * tick.dt, position.y + velocity.y * tick.dt, position.z + velocity.z * tick.dt)

        if position.y <= GROUND_Y:
            let center = vec3(position.x, GROUND_Y, position.z)

            let trunks = query.overlap_sphere[TreeRoot](center = center, radius = radius)
            for hit_root in trunks:
                destroy hit_root
                emit TreeHit to owner:
                    count = 1
                    thrower = owner

            destroy

# Task 3.7 — apply tree-hit deltas to the throwing player's score. Event
# delivery broadcasts to every entity the handler's filter matches, so the
# payload carries the thrower and the handler credits only that entity.
rule TallyScore:
    filter:
        Score

    on TreeHit as hit:
        if self == hit.thrower:
            trees_hit = trees_hit + hit.count
