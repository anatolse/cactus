# Taller than PLAYER_STEP_HEIGHT (can't be auto-climbed like a stair) but
# short enough to clear with a single jump — sits on the direct approach from
# the player's spawn toward the building, so both the player's jump and
# enemies' vault-over-a-short-obstacle behavior get exercised without needing
# to seek it out deliberately.
entity LowBarrier from SolidBox:
    tv.WorldTransform:
        position = vec3(0.0, 0.4, 5.0)
        scale = vec3(3.0, 0.8, 0.5)
    meshes.Renderer:
        color = #606060FF
    physics.BoxCollider:
        size = vec3(3.0, 0.8, 0.5)

entity PlayerBody:
    tv.WorldTransform:
        position = vec3(0.0, PLAYER_HALF_HEIGHT, 10.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    # Its own layer, so bullets fly through the player.
    physics.Collider:
        layer = PLAYER_LAYER
        mask = BODY_MASK
    physics.CapsuleCollider:
        radius = PLAYER_RADIUS
        height = PLAYER_HALF_HEIGHT * 2.0
    camera.FirstPersonCamera:
        pitch = 0.0
        yaw = 0.0
        sensitivity = 0.002
    physics.CharacterBody:
        gravity = GRAVITY
        step_height = PLAYER_STEP_HEIGHT
    physics.Solid
    Player
    children:
        entity PlayerCamera:
            tv.WorldTransform
            camera.Camera:
                fov_y = 70.0
                near = 0.05
                far = 100.0
            viewport.Viewport:
                clear_color = #4890E0FF
            Shooter
            CameraRig

