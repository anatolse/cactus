module shop

use player

const:
    SHOP_NAME = "Desert Oasis Cactus Shop"
    INTERACT_DISTANCE = 3.0
    CACTUS_SMALL_NAME = "Small Cactus"
    CACTUS_SMALL_PRICE = 10
    CACTUS_MEDIUM_NAME = "Medium Cactus"
    CACTUS_MEDIUM_PRICE = 25
    CACTUS_LARGE_NAME = "Large Cactus"
    CACTUS_LARGE_PRICE = 50
    GOLDEN_CACTUS_NAME = "Golden Cactus"
    GOLDEN_CACTUS_PRICE = 100

enum ItemRarity:
    Common
    Uncommon
    Rare
    Legendary

struct ShopItem:
    name_id: int
    price: int
    rarity: ItemRarity
    model_scale: float

trait ShopKeeper:
    let shop_name_id: int
    var is_open: bool
    var interact_distance: float

trait Inventory:
    persist var items: list[ShopItem]
    persist var total_spent: int

trait Purchasable:
    let item: ShopItem

event ShopOpened:
    shop_entity: entity_id

event ShopClosed:
    shop_entity: entity_id

event ItemPurchased:
    item: ShopItem
    buyer: entity_id

pub entity CactusShop:
    Position:
        position = vec3(10.0, 0.0, 5.0)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    ShopKeeper:
        is_open = true
        interact_distance = INTERACT_DISTANCE

pub entity SmallCactus:
    Position:
        position = vec3(8.0, 0.0, 4.0)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    Purchasable:
        item = ShopItem(CACTUS_SMALL_PRICE, CACTUS_SMALL_PRICE, ItemRarity.Common, 0.5)

pub entity MediumCactus:
    Position:
        position = vec3(9.0, 0.0, 4.5)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    Purchasable:
        item = ShopItem(CACTUS_MEDIUM_PRICE, CACTUS_MEDIUM_PRICE, ItemRarity.Uncommon, 1.0)

pub entity LargeCactus:
    Position:
        position = vec3(11.0, 0.0, 4.5)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    Purchasable:
        item = ShopItem(CACTUS_LARGE_PRICE, CACTUS_LARGE_PRICE, ItemRarity.Rare, 1.5)

pub entity GoldenCactus:
    Position:
        position = vec3(12.0, 0.0, 5.0)
        rotation = quat(0.0, 0.0, 0.0, 1.0)
    Purchasable:
        item = ShopItem(GOLDEN_CACTUS_PRICE, GOLDEN_CACTUS_PRICE, ItemRarity.Legendary, 2.0)

func can_afford(coins: int, price: int) bool:
    return coins >= price

func calculate_total(items: list[ShopItem]) int:
    return items.map(i => i.price).reduce(0, acc, p => acc + p)

rule ShopInteraction:
    filter:
        Position as p
        ShopKeeper as shop

    on tick:
        let player_pos = get_player_position()
        let dist = distance_2d(p.position, player_pos)

        if dist < shop.interact_distance and shop.is_open:
            if is_interact_pressed():
                emit ShopOpened:
                    shop_entity = get_self_entity()

rule PurchaseSystem:
    filter:
        Wallet as w
        Inventory as inv

    on ItemPurchased:
        if can_afford(w.coins, ItemPurchased.item.price):
            w.coins = w.coins - ItemPurchased.item.price
            inv.items = inv.items + [ItemPurchased.item]
            inv.total_spent = inv.total_spent + ItemPurchased.item.price
            emit CoinSpent:
                amount = ItemPurchased.item.price
                remaining = w.coins
