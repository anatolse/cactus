module std.camera.flat

use std.core as core
use std.math as math
use std.transform.flat as tf

# ── 2D Camera Traits & Rules ──────────────────────────────────────────────────

# 2D orthographic camera configuration.
# zoom:     magnification factor (1.0 = normal, 2.0 = 2x zoom in)
# offset:   camera origin offset in world units (controls what is centered)
# rotation: camera rotation in radians
# Active camera selection is governed by std.camera.viewport.Viewport.
pub trait Camera:
    var zoom: float = 1.0
    var offset: vec2 = vec2(0.0, 0.0)
    var rotation: float = 0.0

# Smooth-follow camera that tracks a target entity's position.
# target:    the entity to follow, a required link to its WorldTransform
# offset:    additional offset from the target's position
# smoothing: lerp speed (higher = snappier; 0 = instant)
pub trait FollowCamera:
    var target: tf.WorldTransform
    var offset: vec2 = vec2(0.0, 0.0)
    var smoothing: float = 8.0

# Follow cameras move after the game's own late_tick moves.
pub group follow:
    phase: core.late_tick

# Centers the camera on its target after the frame's movement; smoothing 0 snaps.
rule FollowFlatTarget:
    each: Camera as cam, FollowCamera as follow
    group: follow
    on core.late_tick as step:
        let goal = follow.target[tf.WorldTransform].position + follow.offset
        let blend = if follow.smoothing <= 0.0: 1.0 else: math.min(1.0, follow.smoothing * step.dt)
        cam.offset += (goal - cam.offset) * blend

# A camera whose target is gone stays where it is.
rule StopFollowingFlat:
    each: FollowCamera
    on lost FollowCamera.target:
        remove FollowCamera

# ── Screen/World Projection Helpers ──────────────────────────────────────────
# Converts screen-space coordinates through the active 2D camera.
# screen_to_world: inverse camera transform → world position
# screen_delta_to_world: scale a screen-space delta by the camera zoom

pub extern func screen_to_world(screen: vec2) vec2

pub extern func screen_delta_to_world(delta: vec2) vec2
