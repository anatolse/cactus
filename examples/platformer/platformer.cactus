        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
        color = ENEMY_COLOR
        visible = true
    Collider:
        layer = 1
        mask = 1
    BoxCollider:
        size = vec2(ENEMY_WIDTH, ENEMY_HEIGHT)
    PatrolMotion:
        patrol_min_x = 350.0
        patrol_max_x = 550.0
        patrol_speed = PATROL_SPEED
        direction = 1.0

