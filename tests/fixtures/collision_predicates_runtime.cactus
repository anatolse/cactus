module collision_predicates_runtime

use std.core
use std.collision.flat as flat
use std.collision.volume as vol

# ── stdlib-collision: direct overlapping/touching/separated coverage ───────
# circles_overlap/spheres_overlap are ordinary pure Cactus functions (not
# backend intrinsics), so they're exercised the same way any other rule
# computation would be: called from a handler body and their results read
# back from trait fields after a frame.

trait Probe:
    var circle_overlap: bool = false
    var circle_touch: bool = false
    var circle_separate: bool = false
    var sphere_overlap: bool = false
    var sphere_touch: bool = false
    var sphere_separate: bool = false
    var sphere_box_separate: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_box_touch: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_box_overlap: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_box_inside_tie: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_box_rotated: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_sphere_separate: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_sphere_touch: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_sphere_overlap: vec3 = vec3(0.0, 0.0, 0.0)
    var sphere_sphere_coincident: vec3 = vec3(0.0, 0.0, 0.0)

rule ComputeProbe:
    filter:
        Probe

    on tick:
        circle_overlap = flat.circles_overlap(vec2(0.0, 0.0), 1.0, vec2(1.0, 0.0), 1.0)
        circle_touch = flat.circles_overlap(vec2(0.0, 0.0), 1.0, vec2(2.0, 0.0), 1.0)
        circle_separate = flat.circles_overlap(vec2(0.0, 0.0), 1.0, vec2(3.0, 0.0), 1.0)
        sphere_overlap = vol.spheres_overlap(vec3(0.0, 0.0, 0.0), 1.0, vec3(1.0, 0.0, 0.0), 1.0)
        sphere_touch = vol.spheres_overlap(vec3(0.0, 0.0, 0.0), 1.0, vec3(2.0, 0.0, 0.0), 1.0)
        sphere_separate = vol.spheres_overlap(vec3(0.0, 0.0, 0.0), 1.0, vec3(3.0, 0.0, 0.0), 1.0)
        sphere_box_separate = vol.sphere_box_separation(vec3(3.0, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0), quat.identity())
        sphere_box_touch = vol.sphere_box_separation(vec3(2.0, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0), quat.identity())
        sphere_box_overlap = vol.sphere_box_separation(vec3(1.5, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0), quat.identity())
        sphere_box_inside_tie = vol.sphere_box_separation(vec3(0.0, 0.0, 0.0), 0.5, vec3(0.0, 0.0, 0.0), vec3(2.0, 2.0, 2.0), quat.identity())
        sphere_box_rotated = vol.sphere_box_separation(vec3(0.0, 1.5, 0.0), 1.0, vec3(0.0, 0.0, 0.0), vec3(2.0, 4.0, 2.0), quat.from_axis_angle(vec3(0.0, 0.0, 1.0), 1.57079633))
        sphere_sphere_separate = vol.sphere_sphere_separation(vec3(3.0, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), 1.0)
        sphere_sphere_touch = vol.sphere_sphere_separation(vec3(2.0, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), 1.0)
        sphere_sphere_overlap = vol.sphere_sphere_separation(vec3(1.5, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), 1.0)
        sphere_sphere_coincident = vol.sphere_sphere_separation(vec3(0.0, 0.0, 0.0), 1.0, vec3(0.0, 0.0, 0.0), 1.0)

entity ProbeEntity:
    Probe

# ── dsl-where-clause: spheres_overlap as an ordinary pure where: predicate ──
# A locally declared collider trait (Body), distinct from
# std.physics.volume.SphereCollider (stdlib-collision D4), supplies the
# position/radius arguments. Three bodies: BodyNear1/BodyNear2 overlap each
# other; BodyFar is separated from both. `where: a != b` (self-pair
# rejection) composes with the spheres_overlap predicate on the same clause,
# proving multiple where: lines conjoin correctly alongside a stdlib-collision
# call.

trait Body:
    var position: vec3 = vec3(0.0, 0.0, 0.0)
    var radius: float = 0.5
    var overlap_hits: int = 0

event OverlapDetected:
    dummy: int

rule DetectOverlapWhere:
    pairs:
        a:
            Body
        b:
            Body
    where:
        a != b
        vol.spheres_overlap(a.Body.position, a.Body.radius, b.Body.position, b.Body.radius)

    on tick:
        emit OverlapDetected to a:
            dummy = 1

rule ResolveOverlap:
    filter:
        Body

    on OverlapDetected:
        overlap_hits += 1

entity BodyNear1:
    Body:
        position = vec3(0.0, 0.0, 0.0)
        radius = 1.0

entity BodyNear2:
    Body:
        position = vec3(1.0, 0.0, 0.0)
        radius = 1.0

entity BodyFar:
    Body:
        position = vec3(10.0, 0.0, 0.0)
        radius = 1.0

trait SphereBoxCandidate:
    let position: vec3 = vec3(1.5, 0.0, 0.0)
    let radius: float = 1.0
    var accepted: bool = false

trait SeparationBox:
    let position: vec3 = vec3(0.0, 0.0, 0.0)
    let size: vec3 = vec3(2.0, 2.0, 2.0)
    let rotation: quat = quat.identity()

event SphereBoxAccepted

rule DetectSphereBoxWhere:
    pairs:
        sphere:
            SphereBoxCandidate
        box:
            SeparationBox
    where:
        v3m.length(vol.sphere_box_separation(sphere.SphereBoxCandidate.position, sphere.SphereBoxCandidate.radius, box.SeparationBox.position, box.SeparationBox.size, box.SeparationBox.rotation)) > 0.0

    on tick:
        emit SphereBoxAccepted to sphere

rule RecordSphereBoxWhere:
    filter:
        SphereBoxCandidate

    on SphereBoxAccepted:
        accepted = true

entity SphereBoxCandidateEntity:
    SphereBoxCandidate

entity SeparationBoxEntity:
    SeparationBox

trait SphereSphereCandidate:
    let position: vec3 = vec3(1.5, 0.0, 0.0)
    let radius: float = 1.0
    var accepted: bool = false

trait SeparationSphere:
    let position: vec3 = vec3(0.0, 0.0, 0.0)
    let radius: float = 1.0

event SphereSphereAccepted

rule DetectSphereSphereWhere:
    pairs:
        sphere_a:
            SphereSphereCandidate
        sphere_b:
            SeparationSphere
    where:
        v3m.length(vol.sphere_sphere_separation(sphere_a.SphereSphereCandidate.position, sphere_a.SphereSphereCandidate.radius, sphere_b.SeparationSphere.position, sphere_b.SeparationSphere.radius)) > 0.0

    on tick:
        emit SphereSphereAccepted to sphere_a

rule RecordSphereSphereWhere:
    filter:
        SphereSphereCandidate

    on SphereSphereAccepted:
        accepted = true

entity SphereSphereCandidateEntity:
    SphereSphereCandidate

entity SeparationSphereEntity:
    SeparationSphere
