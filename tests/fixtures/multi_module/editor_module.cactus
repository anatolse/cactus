module editor_module

use game_templates

pub trait EditorLocked

pub trait EditorState:
    var active: bool = true
    var mode: int = 0
    var selected: entity_id

pub entity SceneRoot:
    Renderable:
        color = #FFFFFFFF
        size = vec2(1.0, 1.0)
    EditorLocked

pub entity EditableBox:
    Renderable:
        color = #FF4444FF
        size = vec2(1.0, 1.0)