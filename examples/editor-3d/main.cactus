module main

use std.editor as editor
use std.input as inp
use std.math.quat as quat
use std.transform.volume as tv
use std.render.meshes as meshes
use std.render.models as models
use std.camera.volume as cam3d
use std.camera.viewport as vp

const:
    WINDOW_WIDTH = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE = "Editor 3D Example"
    TARGET_FPS = 60
    TARGET_HEIGHT = 1.8

# Shared with the model-renderer example — no new binary assets.
asset Robot: model = "../model-renderer/art/robot.glb"
asset Knight: model = "../model-renderer/art/Crispoly-Characters-Mini-Red-Knight.glb"

# ── Character Templates (palette-spawnable via EditorPlace3D) ─────────────────
# Each carries the CharacterScale normalization marker: palette spawns happen
# mid-session, so scale normalization runs on tick instead of at load.

trait CharacterScale:
    var normalized: bool = false

pub template RobotCharacter:
    tv.WorldTransform
    models.ModelRenderer:
        model = Robot
        visible = true
    models.ModelAnimator:
        clip = 0
        speed = 1.0
        time = 0.0
    CharacterScale

pub template KnightCharacter:
    tv.WorldTransform
    models.ModelRenderer:
        model = Knight
        visible = true
    models.ModelAnimator:
        clip = 0
        playing = true
        speed = 1.0
        time = 0.0
    CharacterScale

# ── Lights ────────────────────────────────────────────────────────────────────

pub entity KeyLight:
    tv.WorldTransform:
        position = vec3(-3.0, 4.0, 4.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #FFF4E0
        intensity = 1.5
        range = 20.0
        enabled = true

pub entity FillLight:
    tv.WorldTransform:
        position = vec3(4.0, 2.5, 3.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #C0D8FF
        intensity = 1.0
        range = 18.0
        enabled = true

# ── Camera ────────────────────────────────────────────────────────────────────
# Authored camera entity. When edit mode activates (F1), this viewport is
# deactivated and an editor rig is spawned at the captured pose. The rig's
# EditorCamera3D orbit state (yaw, pitch, distance, focus) is derived from
# MainCamera's position and target at the moment of entry. On exit the rig is
# destroyed and this viewport is restored — MainCamera is never mutated.
#
# Navigation controls (while edit mode is active):
#   Right/middle drag         Orbit around focus point
#   Shift + right/middle drag Pan focus point parallel to view plane
#   Scroll / - / =            Dolly (zoom distance in/out)
#   F                         Frame the selected entity

pub entity MainCamera:
    tv.WorldTransform:
        position = vec3(0.0, 7.0, 10.0)
        rotation = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), -0.55)
        scale = vec3(1.0, 1.0, 1.0)
    cam3d.Camera:
        fov_y = 60.0
        near = 0.1
        far = 500.0
    vp.Viewport:
        x = 0.0
        y = 0.0
        width = 1.0
        height = 1.0
        depth = 0
        clear_color = #223047FF

# ── Editor 3D Mode ────────────────────────────────────────────────────────────
# std.editor auto-creates the Editor entity with EditorState defaults (2D
# interaction). This one-shot load handler flips the editor to the 3D path so
# clicks raycast against models and Place-mode clicks land on the y=0 plane.
# EditorModeToggle (in std.editor) reads use_3d on the first input frame and
# spawns an EditorCamera3D rig at MainCamera's captured pose.

system Enable3DEditor:
    filter:
        editor.EditorState

    on load:
        use_3d = true

# ── Spawn-Time Scale Normalization ────────────────────────────────────────────
# Scene-authored and palette-spawned characters go through the same path: any
# un-normalized character is scaled so its bind-pose height equals
# TARGET_HEIGHT. Zero-height bounds (model not loadable yet) are skipped and
# retried next tick; the flag is only set once the scale is written.

system NormalizeSpawnedScale:
    filter:
        tv.WorldTransform
        models.ModelRenderer
        CharacterScale

    on tick:
        if not normalized:
            let size = models.bounds_size(model)
            if size.y > 0.0:
                let factor = TARGET_HEIGHT / size.y
                scale = vec3(factor, factor, factor)
                normalized = true
