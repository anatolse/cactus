module player

use std.input

# ── Input Action Declarations ─────────────────────────────────────────────────

input MoveX: axis
    negative = Key.A
    positive = Key.D
    gamepad  = GamepadAxis.LeftX

input MoveY: axis
    negative = Key.S
    positive = Key.W
    invert   = true
    gamepad  = GamepadAxis.LeftY

input Jump: button
    key     = Key.Space
    gamepad = GamepadButton.South

# ── Assets ────────────────────────────────────────────────────────────────────

asset PlayerSprite: texture = "sprites/player.png"

const:
    MOVE_SPEED = 6.0
    JUMP_FORCE = 12.0
    GRAVITY = 30.0
    MAX_JUMPS = 2
    START_HEALTH = 3
    START_LIVES = 3
    WALL_SLIDE_SPEED = 2.0
    PLAYER_WIDTH = 32.0
    PLAYER_HEIGHT = 48.0

enum FacingDirection:
    Left
    Right

enum JumpState:
    Grounded
    Jumping
    Falling
    WallSliding

trait Position:
    persist sync var pos: vec2
    var velocity: vec2

trait PlayerPhysics:
    var gravity: float
    var jump_force: float
    var is_grounded: bool
    var jumps_remaining: int
    var max_jumps: int
    var wall_slide_speed: float

trait MoveIntent:
    var axis_x: float
    var jump_pressed: bool

trait PlayerController:
    var move_speed: float
    var facing: FacingDirection
    var jump_state: JumpState
    var width: float
    var height: float

trait PlayerTag

trait Health:
    persist sync var health: int
    persist var lives: int
    let max_health: int = 3
    var invincible_timer: float

event PlayerJumped:
    position: vec2
    jumps_remaining: int

event PlayerLanded:
    position: vec2

event PlayerDamaged:
    amount: int

event PlayerDied:
    lives_remaining: int

pub unit Player:
    Position:
        pos = vec2(100.0, 300.0)
        velocity = vec2(0.0, 0.0)
    PlayerPhysics:
        gravity = GRAVITY
        jump_force = JUMP_FORCE
        is_grounded = false
        jumps_remaining = MAX_JUMPS
        max_jumps = MAX_JUMPS
        wall_slide_speed = WALL_SLIDE_SPEED
    PlayerController:
        move_speed = MOVE_SPEED
        facing = FacingDirection.Right
        jump_state = JumpState.Falling
        width = PLAYER_WIDTH
        height = PLAYER_HEIGHT
    PlayerTag
    Health:
        health = START_HEALTH
        lives = START_LIVES
        invincible_timer = 0.0

func clamp_float(value: float, min_val: float, max_val: float) float:
    if value < min_val:
        return min_val
    if value > max_val:
        return max_val
    return value

system ReadPlayerInputSystem:
    filter:
        MoveIntent as move
        Position as p

    on input:
        move.axis_x      = input.axis(MoveX)
        move.jump_pressed = input.pressed(Jump)

system MovementSystem:
    filter:
        Position as p
        PlayerController as ctrl
        MoveIntent as move

    on fixed_tick:
        if move.axis_x > 0.0:
            ctrl.facing = FacingDirection.Right
        if move.axis_x < 0.0:
            ctrl.facing = FacingDirection.Left

        p.velocity = vec2(move.axis_x * ctrl.move_speed, p.velocity.y)
        p.pos = p.pos + vec2(p.velocity.x * fixed_tick.dt, 0.0)

system GravitySystem:
    filter:
        Position as p
        PlayerPhysics as phys

    on tick:
        if phys.is_grounded == false:
            if phys.jump_state == JumpState.WallSliding:
                p.velocity = vec2(p.velocity.x, phys.wall_slide_speed)
            else:
                p.velocity = vec2(p.velocity.x, p.velocity.y + phys.gravity * tick.dt)

        p.pos = p.pos + vec2(0.0, p.velocity.y * tick.dt)

system JumpSystem:
    filter:
        Position as p
        PlayerPhysics as phys
        PlayerController as ctrl
        MoveIntent as move

    on fixed_tick:
        if move.jump_pressed:
            if phys.jumps_remaining > 0:
                p.velocity = vec2(p.velocity.x, phys.jump_force * -1.0)
                phys.jumps_remaining = phys.jumps_remaining - 1
                phys.is_grounded = false
                phys.jump_state = JumpState.Jumping
                emit PlayerJumped:
                    position = p.pos
                    jumps_remaining = phys.jumps_remaining

        if p.velocity.y > 0.0 and phys.jump_state == JumpState.Jumping:
            phys.jump_state = JumpState.Falling

    on PlayerLanded:
        phys.is_grounded = true
        phys.jumps_remaining = phys.max_jumps
        phys.jump_state = JumpState.Grounded
        p.velocity = vec2(p.velocity.x, 0.0)

system InvincibilitySystem:
    filter:
        Health as h

    on tick:
        if h.invincible_timer > 0.0:
            h.invincible_timer = h.invincible_timer - tick.dt

    on PlayerDamaged:
        if h.invincible_timer <= 0.0:
            h.health = h.health - PlayerDamaged.amount
            h.invincible_timer = 1.5
            if h.health <= 0:
                h.lives = h.lives - 1
                h.health = h.max_health
                emit PlayerDied:
                    lives_remaining = h.lives
