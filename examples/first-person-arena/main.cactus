entity Game:
    Match

entity Sun:
    meshes.DirectionalLight:
        direction = vec3(-0.4, -1.0, -0.2)
        color = #FFFFFFFF
        intensity = 1.0
        enabled = true

rule CursorLifecycle:
    filter:
        Player

    on load:
        inp.set_cursor_captured(true)

    on unload:
        inp.set_cursor_captured(false)

rule ReadPlayerLook:
    filter:
        Player
        camera.FirstPersonCamera as first_person
        tv.WorldTransform as transform

    when:
        not Game.Match.over

    on input:
        let delta = inp.mouse_delta()
        first_person.yaw = first_person.yaw - delta.x * first_person.sensitivity
        first_person.pitch = math.clamp(first_person.pitch - delta.y * first_person.sensitivity, -1.45, 1.45)
        transform.rotation = quat.from_euler(0.0, first_person.yaw, 0.0)

rule CursorCaptureToggle:
    filter:
        Player

    when:
        not Game.Match.over

    on input:
        if cursor_captured and input.pressed(ReleaseCursor):
            cursor_captured = false
            inp.set_cursor_captured(false)
            return
        if not cursor_captured and input.pressed(Fire):
            cursor_captured = true
            inp.set_cursor_captured(true)
            input.consume(Fire)

rule MovePlayer:
    filter:
        Player
        tv.WorldTransform as transform
        physics.CharacterBody as body

    when:
        not Game.Match.over

    on fixed_tick:
        var move = vec3(0.0, 0.0, 0.0)
        let forward = quat.forward(transform.rotation)
        let right = quat.right(transform.rotation)
        if input.down(MoveForward):
            move += vec3(forward.x, 0.0, forward.z)
        if input.down(MoveBackward):
            move -= vec3(forward.x, 0.0, forward.z)
        if input.down(MoveRight):
            move += vec3(right.x, 0.0, right.z)
        if input.down(MoveLeft):
            move -= vec3(right.x, 0.0, right.z)
        if v3.length(move) > 0.0:
            move = v3.normalize(move) * PLAYER_SPEED
        body.velocity.x = move.x
        body.velocity.z = move.z

# Reacts to the one-shot `pressed` edge during `on input` (fires exactly once
# per frame) rather than `on fixed_tick`, which can repeat zero or more times
# per frame under its accumulator cadence and would risk stacking multiple
# impulses from a single press.
rule ApplyJump:
    filter:
        Player
        physics.CharacterBody as body

    when:
        not Game.Match.over

    on input:
        if body.grounded and input.pressed(Jump):
            body.velocity.y = JUMP_VELOCITY

# Bodies keep their velocity, so they stand still once the match is over.
rule HaltWhenOver:
    filter:
        physics.CharacterBody as body

    when:
        Game.Match.over

    on fixed_tick:
        body.velocity.x = 0.0
        body.velocity.z = 0.0

rule ComposeCameraPose:
    filter:
        CameraRig
        tv.WorldTransform as transform

    on late_tick:
        let yaw = PlayerBody.camera.FirstPersonCamera.yaw
        let pitch = PlayerBody.camera.FirstPersonCamera.pitch
        transform.position = PlayerBody.tv.WorldTransform.position + vec3(0.0, CAMERA_EYE_HEIGHT, 0.0)
        transform.rotation = quat.compose(quat.from_euler(0.0, yaw, 0.0), quat.from_euler(pitch, 0.0, 0.0))

rule SpawnRobots:
    filter:
        RobotSpawnPoint as spawn_point
        tv.WorldTransform as transform

    when:
        not Game.Match.over

    on fixed_tick:
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let bounds = models.bounds_size(Robot)
        let model_scale = if bounds.y > 0.0: CHARACTER_HEIGHT / bounds.y else: 1.0
        spawn RobotTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                kind = ROBOT
            children:
                EnemyVisual:
                    tv.LocalTransform:
                        rotation = quat.from_euler(0.0, ROBOT.visual_yaw_offset, 0.0)
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Robot
                    models.ModelAnimator:
                        clip = ROBOT.run_clip
                        speed = ROBOT.speed / ROBOT.run_reference_speed
        spawn_point.countdown = SPAWN_INTERVAL

rule SpawnKnights:
    filter:
        KnightSpawnPoint as spawn_point
        tv.WorldTransform as transform

    when:
        not Game.Match.over

    on fixed_tick:
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let bounds = models.bounds_size(Knight)
        let model_scale = if bounds.y > 0.0: CHARACTER_HEIGHT / bounds.y else: 1.0
        spawn KnightTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                kind = KNIGHT
            children:
                EnemyVisual:
                    tv.LocalTransform:
                        rotation = quat.from_euler(0.0, KNIGHT.visual_yaw_offset, 0.0)
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Knight
                    models.ModelAnimator:
                        clip = KNIGHT.run_clip
                        speed = KNIGHT.speed / KNIGHT.run_reference_speed
        spawn_point.countdown = SPAWN_INTERVAL

# The ground-plane heading from position toward target, turned by angle.
func steer_heading(position: vec3, goal: vec3, angle: float) vec3:
    let delta = vec3(goal.x - position.x, 0.0, goal.z - position.z)
    let distance = v3.length(delta)
    if distance <= 0.0:
        return vec3(0.0, 0.0, 0.0)
    return v3.rotate(delta / distance, vec3(0.0, 1.0, 0.0), angle)

# The first free steering angle: small before large, left before right. When
# every candidate is blocked the enemy keeps the direct heading, and the
# character controller stops it at the wall.
func steer_angle(left_small_blocked: bool, right_small_blocked: bool, left_large_blocked: bool, right_large_blocked: bool) float:
    return (
        if not left_small_blocked: ENEMY_STEER_ANGLE_SMALL
        else if not right_small_blocked: -ENEMY_STEER_ANGLE_SMALL
        else if not left_large_blocked: ENEMY_STEER_ANGLE_LARGE
        else if not right_large_blocked: -ENEMY_STEER_ANGLE_LARGE
        else: 0.0
    )

# Whether a sphere of ENEMY_RADIUS at a steering probe overlaps this wall's
# box. The probe sits ENEMY_STEER_PROBE_DISTANCE along the heading, raised by
# height. The character controller does the real collision; this only picks a
# heading.
func is_probe_blocked(position: vec3, goal: vec3, angle: float, height: float, wall_position: vec3, wall_size: vec3, wall_rotation: quat) bool:
    let probe = position + steer_heading(position, goal, angle) * ENEMY_STEER_PROBE_DISTANCE + vec3(0.0, height, 0.0)
    return v3.length(collision.sphere_box_separation(probe, ENEMY_RADIUS, wall_position, wall_size, wall_rotation)) > 0.0

# One pass over enemy × wall: the broad phase finds the walls near each
# enemy, `reduce:` asks whether any of them blocks each probe, and the
# handler then runs once per enemy, also when no wall is near.
rule SeekPlayer:
    pairs:
        enemy:
            Enemy
            Threat
            physics.CharacterBody as body
            tv.WorldTransform as transform
        wall:
            physics.Solid
            physics.BoxCollider as box
            tv.WorldTransform as place
    where:
        collision.sphere_box_overlap(enemy.transform.position, ENEMY_SENSE_RADIUS, wall.place.position, wall.box.size, wall.place.rotation)
    reduce:
        per: enemy
        direct_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, 0.0, 0.0, wall.place.position, wall.box.size, wall.place.rotation))
        # An obstacle that still blocks at jump-clearance height is too tall to vault.
        direct_high_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, 0.0, ENEMY_VAULT_CLEARANCE_HEIGHT, wall.place.position, wall.box.size, wall.place.rotation))
        left_small_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, ENEMY_STEER_ANGLE_SMALL, 0.0, wall.place.position, wall.box.size, wall.place.rotation))
        right_small_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, ENEMY_STEER_ANGLE_SMALL * -1.0, 0.0, wall.place.position, wall.box.size, wall.place.rotation))
        left_large_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, ENEMY_STEER_ANGLE_LARGE, 0.0, wall.place.position, wall.box.size, wall.place.rotation))
        right_large_blocked = any(is_probe_blocked(enemy.transform.position, PlayerBody.tv.WorldTransform.position, ENEMY_STEER_ANGLE_LARGE * -1.0, 0.0, wall.place.position, wall.box.size, wall.place.rotation))
    when:
        not Game.Match.over

    on fixed_tick:
        # Writing velocity orders this rule before physics.solve, so grounded
        # is the previous tick's result, the same lag as ApplyJump's check.
        if enemy.Enemy.is_vaulting and enemy.body.grounded:
            enemy.Enemy.is_vaulting = false
            for visual in query.children[EnemyVisual](of = enemy):
                set models.ModelAnimator on visual:
                    clip = enemy.Enemy.kind.run_clip
                    time = 0.0

        let position = enemy.transform.position
        let target_position = PlayerBody.tv.WorldTransform.position
        var direction = steer_heading(position, target_position, 0.0)
        if v3.length(direction) <= 0.0:
            enemy.body.velocity.x = 0.0
            enemy.body.velocity.z = 0.0
            return

        if direct_blocked:
            # Vaultable beats steering: a short obstacle dead ahead is jumped
            # over on the direct heading rather than detoured around. Only
            # trigger while grounded, read from last tick's result (same lag
            # as the landing check above and ApplyJump's grounded check).
            let can_vault = not direct_high_blocked
            if can_vault and enemy.body.grounded:
                enemy.body.velocity.y = JUMP_VELOCITY
                enemy.Enemy.is_vaulting = true
                for visual in query.children[EnemyVisual](of = enemy):
                    set models.ModelAnimator on visual:
                        clip = enemy.Enemy.kind.jump_clip
                        time = 0.0

            if not can_vault:
                direction = steer_heading(position, target_position, steer_angle(left_small_blocked, right_small_blocked, left_large_blocked, right_large_blocked))

        enemy.Enemy.facing_yaw = math.atan2(direction.x * -1.0, direction.z * -1.0)
        enemy.transform.rotation = quat.from_euler(0.0, enemy.Enemy.facing_yaw, 0.0)
        enemy.body.velocity.x = direction.x * enemy.Enemy.kind.speed
        enemy.body.velocity.z = direction.z * enemy.Enemy.kind.speed

rule CooldownShooter:
    filter:
        Shooter as shooter

    on tick:
        if shooter.cooldown > 0.0:
            shooter.cooldown = math.max(0.0, shooter.cooldown - tick.dt)

rule FireBullet:
    filter:
        CameraRig
        Shooter as shooter
        tv.WorldTransform as transform
    after:
        CursorCaptureToggle
    when:
        not Game.Match.over

    on input:
        if not input.pressed(Fire) or shooter.cooldown > 0.0:
            return
        let direction = quat.forward(transform.rotation)
        spawn BulletTemplate:
            tv.WorldTransform:
                position = transform.position + direction * 0.5
            Bullet:
                velocity = direction * BULLET_SPEED
        shooter.cooldown = FIRE_COOLDOWN

# Each tick a bullet sweeps its motion against every solid its mask selects,
# so it can't pass through anything between ticks, and hurtboxes don't stop
# it. Walls have no EnemyHit handler, so a hit on a wall only destroys the
# bullet.
rule MoveBullets:
    pairs:
        bullet:
            Bullet
            tv.WorldTransform
        target:
            physics.Collider
            physics.Solid
    reduce:
        per: bullet
        first = first_hit(physics.sweep(bullet, bullet.Bullet.velocity * fixed_tick.dt, target))

    on fixed_tick:
        if first.hit:
            emit EnemyHit to first.other
            destroy bullet
            return
        bullet.tv.WorldTransform.position += bullet.Bullet.velocity * fixed_tick.dt
        bullet.Bullet.lifetime -= fixed_tick.dt
        if bullet.Bullet.lifetime <= 0.0:
            destroy bullet

rule BeginDeath:
    filter:
        Enemy as enemy
    exclude:
        Dying

    # The hurtbox goes with the hit, so a dying enemy can't catch the player.
    on EnemyHit:
        add Dying
        for hurtbox in query.children[Hurtbox](of = self):
            destroy hurtbox
        for visual in query.children[EnemyVisual](of = self):
            set models.ModelAnimator on visual:
                clip = enemy.kind.death_clip
                time = 0.0

# A dying enemy stops being a Threat, so SeekPlayer skips it, and stops
# moving. It leaves every collider layer, so bullets and live bodies pass
# through it, and collides only with the map.
rule StartDying:
    filter:
        Enemy as enemy
        physics.Collider as collider
        physics.CharacterBody as body

    on added Dying:
        enemy.death_elapsed = 0.0
        collider.layer = 0
        collider.mask = MAP_LAYER
        body.velocity = vec3(0.0, 0.0, 0.0)
        remove Threat

# The model child tips over and fades; the collision root keeps its yaw.
rule AnimateEnemyDeath:
    filter:
        Enemy as enemy
        Dying

    on tick:
        enemy.death_elapsed += tick.dt
        if enemy.death_elapsed >= DEATH_DURATION:
            # Destroying self cascades to the EnemyVisual child (Parent-based
            # recursive destroy).
            destroy
            return
        let progress = math.clamp(enemy.death_elapsed / DEATH_DURATION, 0.0, 1.0)
        enemy.death_pitch = progress * HALF_PI
        for visual in query.children[EnemyVisual](of = self):
            set tv.LocalTransform on visual:
                rotation = quat.from_euler(enemy.death_pitch, enemy.kind.visual_yaw_offset, 0.0)
            set models.ModelRenderer on visual:
                color = color(1.0, 1.0, 1.0, 1.0 - progress)

# Solid bodies never overlap, so a live enemy catches the player through its
# slightly larger hurtbox.
rule CatchPlayer:
    pairs:
        player:
            Player
        hurtbox:
            Hurtbox
    group: physics.contacts
    where:
        physics.touching(hurtbox, player)
    reduce:
        per: player
        hurtboxes = count()
    keep Caught on player

rule EndGame:
    filter:
        Player
    when:
        not Game.Match.over

    on added Caught:
        Game.Match.over = true
        Game.Match.over_count += 1
        cursor_captured = false
        inp.set_cursor_captured(false)
        set text.ScreenLabel on CrosshairHud:
            visible = false
        set text.ScreenLabel on GameOverHud:
            visible = true

rule RestartOnGameOver:
    filter:
        Player
        tv.WorldTransform as transform
        camera.FirstPersonCamera as first_person
        physics.CharacterBody as body
    when:
        Game.Match.over

    on input:
        if not input.pressed(RestartGame):
            return
        Game.Match.over = false
        transform.position = vec3(0.0, PLAYER_HALF_HEIGHT, 10.0)
        transform.rotation = quat.identity()
        body.velocity = vec3(0.0, 0.0, 0.0)
        first_person.yaw = 0.0
        first_person.pitch = 0.0
        cursor_captured = true
        inp.set_cursor_captured(true)
        for enemy in query.all[Enemy]():
            destroy enemy
        for bullet in query.all[Bullet]():
            destroy bullet
        for spawn_point in query.all[RobotSpawnPoint]():
            set RobotSpawnPoint on spawn_point:
                countdown = 0.0
        for spawn_point in query.all[KnightSpawnPoint]():
            set KnightSpawnPoint on spawn_point:
                countdown = 0.0
        set text.ScreenLabel on CrosshairHud:
            visible = true
        set text.ScreenLabel on GameOverHud:
            visible = false
