module std.physics.flat

# ── 2D Kinematic Physics Traits & Events ─────────────────────────────────────
# Plain data: nothing moves a 2D CharacterBody yet, so a game moves it with its
# own rules. The cpp-entt backend still reports CollisionEnter overlaps.

# Kinematic character state for 2D entities.
# velocity: movement velocity in world units per second
# grounded: whether the entity rests on a surface
# gravity:  downward acceleration in world units per second squared
pub trait CharacterBody:
    var velocity: vec2 = vec2(0.0, 0.0)
    var grounded: bool = false
    var gravity: float = 30.0

# Shared 2D collision participation/filtering data.
# layer: collision layer bitmask this entity belongs to
# mask:  collision layer bitmask this entity collides with
pub trait Collider:
    var layer: int = 1
    var mask: int = 1

# Axis-aligned rectangle/square collider for 2D entities.
# size: collider width/height in world units
pub trait BoxCollider:
    var size: vec2 = vec2(1.0, 1.0)

# Circular collider for 2D entities.
# radius: collider radius in world units
pub trait CircleCollider:
    var radius: float = 0.5

# Vertical capsule collider for 2D entities.
# radius: capsule radius in world units
# height: total capsule height in world units
pub trait CapsuleCollider:
    var radius: float = 0.5
    var height: float = 1.0

# Result tag for collider-backed 2D world queries.
# Empty means the query found no matching contact; Hit means contact is valid.
pub enum QueryResultKind:
    Empty
    Hit

# Contact payload returned by collider-backed 2D world queries.
# normal:   direction from hit collider toward subject/query shape
# distance: scalar cast travel distance before contact
# overlap:  minimum translation/separation vector for overlap contacts
pub struct QueryContact2D:
    other: entity_id
    normal: vec2
    distance: float
    overlap: vec2

# Algebraic neutral-or-hit result for single-contact 2D world queries.
pub struct QueryResult2D:
    kind: QueryResultKind
    contact: QueryContact2D

# Cast the subject collider through delta and return the nearest matching hit.
pub extern func query_cast_nearest(subject: entity_id, delta: vec2, mask: int, exclude: entity_id) QueryResult2D

# Return the deepest current overlap for the subject collider.
pub extern func query_overlap_deepest(subject: entity_id, mask: int, exclude: entity_id) QueryResult2D

# Return all current overlaps for the subject collider.
pub extern func query_overlap_all(subject: entity_id, mask: int, exclude: entity_id) list[QueryContact2D]

# Fired when this entity's collider first overlaps another entity's collider.
# other:   entity_id of the entity that was hit
# overlap: overlap vector (direction and depth of penetration)
pub event CollisionEnter:
    other: entity_id
    overlap: vec2
