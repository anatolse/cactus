module main

use std.input as inp
use std.math.quat as quat
use std.query as query
use std.text as text
use std.transform.volume as tv
use std.render.meshes as meshes
use std.render.models as models
use std.render.text as rtext
use std.camera.volume as cam3d
use std.camera.viewport as vp

const:
    WINDOW_WIDTH = 960
    WINDOW_HEIGHT = 540
    WINDOW_TITLE = "Model Animation Example"
    TARGET_FPS = 60
    ROTATION_SPEED = 1.75
    CHARACTER_COUNT = 3
    TARGET_HEIGHT = 1.8
    SELECTED_SCALE = 1.3
    SCALE_SPEED = 2.0

# Shared with the model-renderer example — one CC0 robot GLB, 14 named clips,
# plus a CC0 knight GLB with its own clip table and a different native height.
asset Robot: model = "../model-renderer/art/robot.glb"
asset Knight: model = "../model-renderer/art/Crispoly-Characters-Mini-Red-Knight.glb"

input CycleSelected: button
    key = inp.Key.Tab

input NextClip: button
    key = inp.Key.Space

# Arrows and WASD both rotate; each direction is two axis declarations, summed.
input RotateHorizontalKeys: axis
    negative = inp.Key.A
    positive = inp.Key.D

input RotateHorizontalArrows: axis
    negative = inp.Key.Left
    positive = inp.Key.Right

input RotateVerticalKeys: axis
    negative = inp.Key.S
    positive = inp.Key.W

input RotateVerticalArrows: axis
    negative = inp.Key.Down
    positive = inp.Key.Up

# Lock-step selection state: every character sees the same TAB press and
# advances its own `selected` copy, so "am I selected" is just
# `index == selected` — no cross-entity reads needed.
# base_scale: normalization factor computed at spawn (target height / model height)
# scale_mult: animated selection-emphasis multiplier eased toward SELECTED_SCALE
trait CharacterState:
    var index: int = 0
    var selected: int = 0
    var base_scale: float = 1.0
    var scale_mult: float = 1.0

trait ControlInput:
    var horizontal: float = 0.0
    var vertical: float = 0.0
    var cycle_pressed: bool = false
    var clip_pressed: bool = false

# Single-instance bootstrap marker: the SpawnCharacters load handler filters
# on this, so its body runs exactly once (load handlers run once per matching
# entity). The fields hold the per-model normalization factors computed during
# load; their defaults are the zero-height (unloadable model) fallback.
trait SpawnerMarker:
    var robot_scale: float = 1.0
    var knight_scale: float = 1.0

template CharacterTemplate:
    tv.WorldTransform
    models.ModelRenderer:
        visible = true
    models.ModelAnimator:
        playing = true
        speed = 1.0
        time = 0.0
    CharacterState
    ControlInput

pub entity Bootstrap:
    SpawnerMarker

pub entity Hud:
    rtext.ScreenLabel:
        text = ""
        position = vec2(16.0, 16.0)
        font_size = 24
        color = #FFFFFFFF
        visible = true

pub entity KeyLight:
    tv.WorldTransform:
        position = vec3(-3.0, 4.0, 4.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #FFF4E0
        intensity = 1.5
        range = 20.0
        enabled = true

pub entity FillLight:
    tv.WorldTransform:
        position = vec3(4.0, 2.5, 3.0)
        rotation = quat.identity()
        scale = vec3(1.0, 1.0, 1.0)
    meshes.PointLight:
        color = #C0D8FF
        intensity = 1.0
        range = 18.0
        enabled = true

pub entity MainCamera:
    tv.WorldTransform:
        position = vec3(0.0, 2.5, 8.0)
        rotation = quat.from_axis_angle(vec3(1.0, 0.0, 0.0), -0.15)
        scale = vec3(1.0, 1.0, 1.0)
    cam3d.Camera:
        fov_y = 60.0
        near = 0.1
        far = 500.0
    vp.Viewport:
        x = 0.0
        y = 0.0
        width = 1.0
        height = 1.0
        depth = 0
        clear_color = #223047FF

# Spawns the cast once at startup: robot / knight / robot, left to right, each
# normalized to TARGET_HEIGHT from its model's bind-pose bounds. A zero height
# (unloadable model) falls back to unscaled.
system SpawnCharacters:
    filter:
        SpawnerMarker

    on load:
        let robot_size = models.bounds_size(Robot)
        if robot_size.y > 0.0:
            robot_scale = TARGET_HEIGHT / robot_size.y
        let knight_size = models.bounds_size(Knight)
        if knight_size.y > 0.0:
            knight_scale = TARGET_HEIGHT / knight_size.y
        spawn CharacterTemplate:
            tv.WorldTransform:
                position = vec3(-2.5, 0.0, 0.0)
                rotation = quat.identity()
                scale = vec3(robot_scale, robot_scale, robot_scale)
            models.ModelRenderer:
                model = Robot
            models.ModelAnimator:
                clip = 0
            CharacterState:
                index = 0
                base_scale = robot_scale
        spawn CharacterTemplate:
            tv.WorldTransform:
                position = vec3(0.0, 0.0, 0.0)
                rotation = quat.identity()
                scale = vec3(knight_scale, knight_scale, knight_scale)
            models.ModelRenderer:
                model = Knight
            models.ModelAnimator:
                clip = 0
            CharacterState:
                index = 1
                base_scale = knight_scale
        spawn CharacterTemplate:
            tv.WorldTransform:
                position = vec3(2.5, 0.0, 0.0)
                rotation = quat.identity()
                scale = vec3(robot_scale, robot_scale, robot_scale)
            models.ModelRenderer:
                model = Robot
            models.ModelAnimator:
                clip = 2
            CharacterState:
                index = 2
                base_scale = robot_scale

system ReadControls:
    filter:
        ControlInput

    on input:
        horizontal = input.axis(RotateHorizontalKeys) + input.axis(RotateHorizontalArrows)
        vertical = input.axis(RotateVerticalKeys) + input.axis(RotateVerticalArrows)
        cycle_pressed = input.pressed(CycleSelected)
        clip_pressed = input.pressed(NextClip)

system CycleSelection:
    filter:
        CharacterState
        ControlInput

    on tick:
        if cycle_pressed:
            selected = (selected + 1) % CHARACTER_COUNT

# Selection emphasis: ease each character's scale multiplier toward
# SELECTED_SCALE while selected and back toward 1.0 otherwise, then write the
# combined normalization * emphasis scale to the transform.
system AnimateSelection:
    filter:
        tv.WorldTransform
        CharacterState
    after:
        CycleSelection

    on tick:
        if index == selected:
            scale_mult = scale_mult + SCALE_SPEED * tick.dt
            if scale_mult > SELECTED_SCALE:
                scale_mult = SELECTED_SCALE
        else:
            scale_mult = scale_mult - SCALE_SPEED * tick.dt
            if scale_mult < 1.0:
                scale_mult = 1.0
        scale = vec3(base_scale * scale_mult, base_scale * scale_mult, base_scale * scale_mult)

system RotateSelected:
    filter:
        tv.WorldTransform
        CharacterState
        ControlInput
    after:
        CycleSelection

    on tick:
        if index == selected:
            let yaw_axis = quat.up(rotation)
            # let pitch_axis = quat.right(rotation)
            let yaw_delta = quat.from_axis_angle(yaw_axis, horizontal * ROTATION_SPEED * tick.dt)
            # let pitch_delta = quat.from_axis_angle(pitch_axis, vertical * ROTATION_SPEED * tick.dt)
            rotation = quat.multiply(yaw_delta, rotation)
            # rotation = quat.multiply(pitch_delta, quat.multiply(yaw_delta, rotation))

system CycleClip:
    filter:
        CharacterState
        ControlInput
        models.ModelRenderer
        models.ModelAnimator
    after:
        CycleSelection

    on tick:
        if clip_pressed and index == selected:
            let count = models.animation_count(model)
            if count > 0:
                clip = (clip + 1) % count
                time = 0.0

system UpdateHud:
    filter:
        CharacterState
        models.ModelRenderer
        models.ModelAnimator
    after:
        CycleClip

    on tick:
        if index == selected:
            let hud = query.first[rtext.ScreenLabel]()
            project rtext.ScreenLabel to hud:
                position = vec2(16.0, 16.0)
                text = text.format("Character {} - {}", index + 1, models.animation_name(model, clip))
