module std.voxel.volume

use std.core as core
use std.math as math
use std.math.vec3 as v3
use std.transform.volume as tv
use std.physics.volume as physics
use std.collision.volume as collision
use std.render.layers as layers
use std.render.visibility as visibility

# ── Editable block volumes ───────────────────────────────────────────────────
# A Volume is a fixed, axis-aligned grid of cubic cells. Every cell is an
# ordinary entity with Cell, a WorldTransform at its centre and a box collider.
# physics.Solid on a cell means filled; a cell without it is air. Digging
# removes Solid, building sets Cell.texture and adds Solid. Saves record each
# cell, its texture and its Solid membership.
#
# The volume creates its own cells, `batch` per tick in linear order (z
# fastest, then y, then x), so a large volume fills over several frames and
# `cells_built` reports progress. React to `on added Cell` to choose each new
# cell's material. Cells, transforms and the volume's geometry never change
# after construction.
#
# A volume needs a finite origin, a positive finite cell size, max >= min on
# every axis, and fewer than 2^24 cells. An invalid volume creates no cells and
# reports why in `issue`.
# A cell's coordinates lie inside its volume's bounds: a spawn outside them, or
# against a destroyed volume, creates no cell and reports a range fault.

const:
    MAX_CELLS = 16777216.0

# Why a volume creates no cells.
pub enum VolumeIssue:
    Valid
    OriginNotFinite
    BadCellSize
    EmptyBounds
    TooManyCells

# origin:      world position of the minimum corner of cell (0, 0, 0)
# cell_size:   edge length of every cell, in world units
# min_*/max_*: inclusive integer cell bounds
# batch:       cells created per tick while the volume fills
# cells_built: cells created so far
# issue:       why the volume is invalid, or Valid
# duplicate_found: a CellProbe met two live cells with one coordinate
pub trait Volume:
    let origin: vec3 = vec3(0.0, 0.0, 0.0)
    let cell_size: float = 1.0
    let min_x: int = 0
    let min_y: int = 0
    let min_z: int = 0
    let max_x: int = 0
    let max_y: int = 0
    let max_z: int = 0
    persist var cells_built: int = 0
    var batch: int = 4096
    var issue: VolumeIssue = VolumeIssue.Valid
    var duplicate_found: bool = false

# One cell of `volume` at integer coordinate (x, y, z). texture is drawn on
# its exposed faces while it is Solid. A cell dies with its volume.
pub trait Cell:
    let volume: Volume
    let x: int in range(volume[Volume].min_x, volume[Volume].max_x + 1)
    let y: int in range(volume[Volume].min_y, volume[Volume].max_y + 1)
    let z: int in range(volume[Volume].min_z, volume[Volume].max_z + 1)
    persist var texture: texture_id

# A unit cell of a volume; the volume spawns these itself.
pub template CellTemplate(volume: Volume, x: int, y: int, z: int, center: vec3, size: float):
    Cell:
        volume = volume
        x = x
        y = y
        z = z
    tv.WorldTransform:
        position = center
    physics.Collider
    physics.BoxCollider:
        size = vec3(size, size, size)

func extent(lo: int, hi: int) int:
    return hi - lo + 1

# In float, so bounds far apart cannot wrap around.
func float_extent(lo: int, hi: int) float:
    return 1.0 * hi - lo + 1.0

func finite(v: float) bool:
    return v - v == 0.0

# Why a volume with this configuration creates no cells, or Valid.
pub func volume_issue(origin: vec3, cell_size: float, min_x: int, min_y: int, min_z: int, max_x: int, max_y: int, max_z: int) VolumeIssue:
    if not finite(origin.x) or not finite(origin.y) or not finite(origin.z):
        return VolumeIssue.OriginNotFinite
    if not (cell_size > 0.0) or not finite(cell_size):
        return VolumeIssue.BadCellSize
    if max_x < min_x or max_y < min_y or max_z < min_z:
        return VolumeIssue.EmptyBounds
    let cells = float_extent(min_x, max_x) * float_extent(min_y, max_y) * float_extent(min_z, max_z)
    if cells >= MAX_CELLS:
        return VolumeIssue.TooManyCells
    return VolumeIssue.Valid

# World centre of cell (x, y, z) of a volume with this origin and cell size.
pub func cell_center(origin: vec3, cell_size: float, x: int, y: int, z: int) vec3:
    return origin + vec3(x + 0.5, y + 0.5, z + 0.5) * cell_size

pub group fill:
    phase: core.tick

# A volume whose issue is not Valid; it never fills.
trait InvalidVolume

rule CheckVolume:
    each:
        Volume as v

    on added Volume:
        v.issue = volume_issue(v.origin, v.cell_size, v.min_x, v.min_y, v.min_z, v.max_x, v.max_y, v.max_z)
        if v.issue != VolumeIssue.Valid:
            add InvalidVolume

rule FillVolume:
    each:
        Volume as v
    without: InvalidVolume
    group: fill

    on core.tick:
        let size_y = extent(v.min_y, v.max_y)
        let size_z = extent(v.min_z, v.max_z)
        let total = extent(v.min_x, v.max_x) * size_y * size_z
        if v.cells_built >= total:
            return
        let step = if v.batch > 0: v.batch else: 1
        let end = if total - v.cells_built < step: total else: v.cells_built + step
        for i in range(v.cells_built, end):
            let x = v.min_x + i / (size_y * size_z)
            let y = v.min_y + (i / size_z) % size_y
            let z = v.min_z + i % size_z
            spawn CellTemplate(volume = self, x = x, y = y, z = z, center = cell_center(v.origin, v.cell_size, x, y, z), size = v.cell_size)
        v.cells_built = end

rule DropOrphanCells:
    each: Cell

    on lost Cell.volume:
        destroy

# ── Probes ───────────────────────────────────────────────────────────────────
# Probes answer "which cell is at this coordinate" and "which solid cell does
# this ray hit first" with ordinary pair rules in the input phase. A rule asks
# by projecting CellQuery or RayCast on the probe before `probes`; a probe with
# no question this frame gets no answer. The answer is a projected trait that
# exists only when there is one: CellFound, RayHit and RayFace. Read it after
# `probes` with `each:`, or with `match self:` when one handler handles both
# cases. Answers describe the cells committed before this input pass: an edit
# made from an answer shows up in the next input pass.

pub group probes:
    phase: core.input

# Finds the cell of `volume` at a CellQuery's coordinate, solid or air. With
# duplicate cells the earliest-created one wins, and the volume is told.
pub trait CellProbe:
    var volume: entity_id

# This frame's coordinate for a CellProbe.
pub trait CellQuery:
    let x: int = 0
    let y: int = 0
    let z: int = 0

# The cell a CellProbe found this frame.
pub trait CellFound:
    let cell: entity_id

# Casts this frame's RayCast against the solid cells of `volume`, up to
# max_distance. A nonpositive max_distance or an invalid ray never hits.
pub trait RayProbe:
    var volume: entity_id
    var max_distance: float = 6.0

# This frame's ray for a RayProbe.
pub trait RayCast:
    let origin: vec3 = vec3(0.0, 0.0, 0.0)
    let direction: vec3 = vec3(0.0, 0.0, -1.0)

# The nearest solid cell a ray hit: its coordinate, the distance along the ray
# and the point on its surface. A ray that starts inside a solid cell hits it
# at distance 0 and has no RayFace.
pub trait RayHit:
    let cell: entity_id
    let x: int = 0
    let y: int = 0
    let z: int = 0
    let distance: float = 0.0
    let point: vec3 = vec3(0.0, 0.0, 0.0)

# The face a ray struck: its outward normal and the neighbouring coordinate
# across it, the place to build.
pub trait RayFace:
    let normal: vec3 = vec3(0.0, 0.0, 0.0)
    let adjacent_x: int = 0
    let adjacent_y: int = 0
    let adjacent_z: int = 0

# The nearest hit before its cell's coordinate is known.
trait RayNearest:
    let cell: entity_id
    let distance: float = 0.0
    let point: vec3 = vec3(0.0, 0.0, 0.0)
    let normal: vec3 = vec3(0.0, 0.0, 0.0)

# A CellProbe met more than one live cell at a coordinate.
event DuplicateCell

rule ResolveCellProbes:
    pairs:
        probe:
            CellProbe
            CellQuery
        cell:
            Cell
    group: probes
    where:
        cell[Cell].volume == probe[CellProbe].volume and cell[Cell].x == probe[CellQuery].x and cell[Cell].y == probe[CellQuery].y and cell[Cell].z == probe[CellQuery].z
    reduce per probe:
        matches = count()
        earliest = best(cell, by = 0.0)

    on core.input:
        if matches == 0:
            return
        project CellFound to probe:
            cell = earliest
        if matches > 1:
            emit DuplicateCell to probe[CellProbe].volume

rule ReportDuplicateCell:
    each:
        Volume as v

    on DuplicateCell:
        v.duplicate_found = true

# A ray hit on one cell as a sweep result, so first_hit keeps the nearest.
func ray_cell_hit(cell: entity_id, ray: collision.RayHit, max_distance: float) physics.SweepHit:
    return physics.SweepHit(
        hit = ray.hit,
        other = cell,
        t = if ray.hit: ray.distance / max_distance else: 1.0,
        point = ray.point,
        normal = ray.normal,
        surface = ray.normal,
    )

rule ResolveRayProbes:
    pairs:
        probe:
            RayProbe
            RayCast
        cell:
            Cell
            physics.Solid
            tv.WorldTransform
            physics.BoxCollider
    group: probes
    where:
        cell[Cell].volume == probe[RayProbe].volume
        collision.ray_hits_box(probe[RayCast].origin, probe[RayCast].direction, probe[RayProbe].max_distance, cell[tv.WorldTransform].position, cell[physics.BoxCollider].size)
    reduce per probe:
        nearest = first_hit(ray_cell_hit(cell, collision.ray_box(probe[RayCast].origin, probe[RayCast].direction, probe[RayProbe].max_distance, cell[tv.WorldTransform].position, cell[physics.BoxCollider].size), probe[RayProbe].max_distance))

    on core.input:
        if not nearest.hit:
            return
        project RayNearest to probe:
            cell = nearest.other
            distance = nearest.t * probe[RayProbe].max_distance
            point = nearest.point
            normal = nearest.normal

# Names the struck cell's coordinate and, for a hit on a face, the neighbour
# across it. Runs inside `probes`, so a reader after the group sees the answer
# in the same pass. At most one cell matches, so each max is that cell's value.
rule LocateRayCell:
    pairs:
        probe:
            RayProbe
            RayNearest
        cell:
            Cell
    group: probes
    after:
        ResolveRayProbes
    where:
        cell == probe[RayNearest].cell
    reduce per probe:
        matches = count()
        x = max(cell[Cell].x, default = 0)
        y = max(cell[Cell].y, default = 0)
        z = max(cell[Cell].z, default = 0)

    on core.input:
        if matches == 0:
            return
        project RayHit to probe:
            cell = probe[RayNearest].cell
            x = x
            y = y
            z = z
            distance = probe[RayNearest].distance
            point = probe[RayNearest].point
        let normal = probe[RayNearest].normal
        if v3.length(normal) == 0.0:
            return
        project RayFace to probe:
            normal = normal
            adjacent_x = x + math.round(normal.x)
            adjacent_y = y + math.round(normal.y)
            adjacent_z = z + math.round(normal.z)

# ── Rendering ────────────────────────────────────────────────────────────────
# A volume with VolumeRenderer draws the exposed faces of its solid cells, each
# with its cell's texture repeated once per cell face, under the scene's lights.
# The renderer follows committed Solid changes and texture writes by itself and
# rebuilds only the parts of the surface that changed.

# Blocky draws cubes. Smooth draws one rounded surface around the solid cells,
# each part textured from its nearest solid cell. The smooth surface is visual
# only: collision, probes and saves still see whole cells.
pub enum SurfaceStyle:
    Blocky
    Smooth

# roughness: how far Smooth moves the surface with noise, as a fraction of
#            cell_size; kept within 0.0..0.4
# seed:      picks the noise, so one world always looks the same
pub trait VolumeRenderer:
    var visible: bool = true
    var style: SurfaceStyle = SurfaceStyle.Blocky
    var roughness: float = 0.25
    var seed: int = 0

# Plays `texture` as a vertical strip of square frames on every volume face
# drawn with it, at `fps` frames per second; the image's height over its width
# is the frame count. Playback is visual only: cells, saves and surfaces stay
# as they are.
pub trait TextureFlipbook:
    let texture: texture_id
    let fps: float = 8.0

extern rule PlayFlipbooks:
    each:
        TextureFlipbook
    group: layers.volumes
    before: RenderVolumes

    on core.render:
        reads:
            TextureFlipbook
        effects:
            graphics

# On a camera's viewport entity: that camera hides the cells of `volume` above
# layer `top` and shows the cut surface. Collision, probes and saves still see
# every cell, and other cameras show the whole volume.
pub trait Cutaway:
    var volume: entity_id
    var enabled: bool = true
    var top: int = 0

extern rule RenderVolumes:
    each:
        Volume
        VolumeRenderer
    group: layers.volumes

    on core.render:
        reads:
            Volume
            VolumeRenderer
            Cell
            physics.Solid
            Cutaway
            visibility.HiddenIn
        effects:
            graphics
