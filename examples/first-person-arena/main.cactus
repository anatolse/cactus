entity Sun:
    meshes.DirectionalLight:
        direction = vec3(-0.4, -1.0, -0.2)
        color = #FFFFFFFF
        intensity = 1.0
        enabled = true

rule CursorLifecycle:
    filter:
        Player

    on load:
        inp.set_cursor_captured(true)

    on unload:
        inp.set_cursor_captured(false)

rule ReadPlayerLook:
    filter:
        Player
        camera.FirstPersonCamera as first_person
        tv.WorldTransform as transform

    on input:
        if game_over:
            return
        let delta = inp.mouse_delta()
        first_person.yaw = first_person.yaw - delta.x * first_person.sensitivity
        first_person.pitch = math.clamp(first_person.pitch - delta.y * first_person.sensitivity, -1.45, 1.45)
        transform.rotation = quat.from_euler(0.0, first_person.yaw, 0.0)

rule CursorCaptureToggle:
    filter:
        Player

    on input:
        if game_over:
            return
        if cursor_captured and input.pressed(ReleaseCursor):
            cursor_captured = false
            inp.set_cursor_captured(false)
            return
        if not cursor_captured and input.pressed(Fire):
            cursor_captured = true
            inp.set_cursor_captured(true)
            input.consume(Fire)

rule MovePlayer:
    filter:
        Player
        tv.WorldTransform as transform

    on fixed_tick:
        if game_over:
            return
        let move = vec3(0.0, 0.0, 0.0)
        let forward = quat.forward(transform.rotation)
        let right = quat.right(transform.rotation)
        if input.down(MoveForward):
            move += vec3(forward.x, 0.0, forward.z)
        if input.down(MoveBackward):
            move -= vec3(forward.x, 0.0, forward.z)
        if input.down(MoveRight):
            move += vec3(right.x, 0.0, right.z)
        if input.down(MoveLeft):
            move -= vec3(right.x, 0.0, right.z)
        if v3.length(move) > 0.0:
            let direction = v3.normalize(move)
            transform.position.x += direction.x * PLAYER_SPEED * fixed_tick.dt
            transform.position.z += direction.z * PLAYER_SPEED * fixed_tick.dt

# Reacts to the one-shot `pressed` edge during `on input` (fires exactly once
# per frame) rather than `on fixed_tick`, which can repeat zero or more times
# per frame under its accumulator cadence and would risk stacking multiple
# impulses from a single press.
rule ApplyJump:
    filter:
        Player
        KinematicActor as actor

    on input:
        if game_over:
            return
        if actor.grounded and input.pressed(Jump):
            actor.vertical_velocity = JUMP_VELOCITY
            actor.grounded = false

rule BeginGrounding:
    filter:
        KinematicActor as actor

    on fixed_tick:
        actor.ground_surface = -1000.0

# Applies gravity every tick, including while resting: DetectGroundCandidate/
# ApplyGroundCandidate below correct the resulting sub-frame sink back onto
# the surface each tick (that's what GROUND_CONTACT_TOLERANCE absorbs), so
# there is no separate "am I grounded" branch here. Marking `grounded = false`
# unconditionally is a provisional default for this tick; ApplyGroundCandidate
# flips it back to true if a surface is found within range.
rule IntegrateVerticalMotion:
    filter:
        KinematicActor as actor
        tv.WorldTransform as transform
    after:
        MovePlayer
        SeekPlayer

    on fixed_tick:
        actor.vertical_velocity = math.max(actor.vertical_velocity - GRAVITY * fixed_tick.dt, MAX_FALL_SPEED * -1.0)
        transform.position.y += actor.vertical_velocity * fixed_tick.dt
        actor.grounded = false

rule DetectEnemySeparation:
    pairs:
        a:
            Enemy
            KinematicActor
            tv.WorldTransform
        b:
            Enemy
            KinematicActor
            tv.WorldTransform
    after:
        MovePlayer
        SeekPlayer
    where:
        a != b
        not a.Enemy.dying
        not b.Enemy.dying
        collision.spheres_overlap(a.tv.WorldTransform.position, a.KinematicActor.radius, b.tv.WorldTransform.position, b.KinematicActor.radius)

    on fixed_tick:
        let separation = collision.sphere_sphere_separation(a.tv.WorldTransform.position, a.KinematicActor.radius, b.tv.WorldTransform.position, b.KinematicActor.radius)
        emit SeparateActor to a:
            amount = separation * 0.5

rule DetectActorSolidContact:
    pairs:
        actor:
            KinematicActor
            tv.WorldTransform
        box:
            Solid
            physics.BoxCollider
            tv.WorldTransform
    after:
        MovePlayer
        SeekPlayer
        DetectEnemySeparation

    on fixed_tick:
        let separation = collision.sphere_box_separation(actor.tv.WorldTransform.position, actor.KinematicActor.radius, box.tv.WorldTransform.position, box.physics.BoxCollider.size, box.tv.WorldTransform.rotation)
        if v3.length(separation) > 0.0:
            emit SeparateActor to actor:
                amount = separation

rule ResolveActorSolidContact:
    filter:
        KinematicActor
        tv.WorldTransform as transform

    on SeparateActor as contact:
        transform.position += contact.amount

rule DetectGroundCandidate:
    pairs:
        actor:
            KinematicActor
            tv.WorldTransform
        surface:
            Walkable
            physics.BoxCollider
            tv.WorldTransform
    after:
        MovePlayer
        SeekPlayer
        IntegrateVerticalMotion

    on fixed_tick:
        let actor_position = actor.tv.WorldTransform.position
        let surface_position = surface.tv.WorldTransform.position
        let half_size = surface.physics.BoxCollider.size / 2.0
        let top = surface_position.y + half_size.y
        let feet = actor_position.y - actor.KinematicActor.half_height
        let overlaps_x = math.abs(actor_position.x - surface_position.x) <= half_size.x + actor.KinematicActor.radius
        let overlaps_z = math.abs(actor_position.z - surface_position.z) <= half_size.z + actor.KinematicActor.radius
        # Bounded on both sides: `top <= feet + step_height` lets an actor
        # step up onto a nearby-height surface (stairs); `feet <= top +
        # GROUND_CONTACT_TOLERANCE` keeps a surface far below current feet
        # (e.g. the floor under a roof edge) from counting as reachable ground
        # until an actual fall has brought feet down to meet it — without
        # this bound, walking off a ledge would instantly snap down to
        # whatever surface is below instead of falling. Excluding candidates
        # while still rising (vertical_velocity > 0.0) keeps a jump's initial
        # upward tick from being immediately re-snapped back onto the surface
        # it just left.
        if overlaps_x and overlaps_z and actor.KinematicActor.vertical_velocity <= 0.0 and top <= feet + actor.KinematicActor.step_height and feet <= top + GROUND_CONTACT_TOLERANCE:
            emit GroundCandidate to actor:
                surface = top

rule ApplyGroundCandidate:
    filter:
        KinematicActor as actor
        tv.WorldTransform as transform

    on GroundCandidate as candidate:
        if candidate.surface > actor.ground_surface:
            actor.ground_surface = candidate.surface
            transform.position.y = candidate.surface + actor.half_height
            actor.vertical_velocity = 0.0
            actor.grounded = true

rule ComposeCameraPose:
    pairs:
        rig:
            CameraRig
            tv.WorldTransform
        body:
            Player
            tv.WorldTransform
            camera.FirstPersonCamera

    on late_tick:
        emit CameraPose to rig:
            position = body.tv.WorldTransform.position + vec3(0.0, CAMERA_EYE_HEIGHT, 0.0)
            yaw = body.camera.FirstPersonCamera.yaw
            pitch = body.camera.FirstPersonCamera.pitch

rule ApplyCameraPose:
    filter:
        CameraRig
        tv.WorldTransform as transform

    on CameraPose as pose:
        transform.position = pose.position
        transform.rotation = quat.compose(quat.from_euler(0.0, pose.yaw, 0.0), quat.from_euler(pose.pitch, 0.0, 0.0))

# Mirrors ComposeCameraPose/ApplyCameraPose above: the EnemyVisual child's
# WorldTransform isn't auto-composed by std.transform.volume's
# TransformPropagation (that only applies when the parent itself carries
# LocalTransform, which the Enemy root deliberately doesn't — see EnemyBase),
# so it's authored here instead, offset down by half_height from the
# collision root's torso-height position. Rotation travels as yaw/pitch
# floats rather than a quat event field to sidestep a compiler gap in event
# quat-field codegen (see AnimateEnemyDeath's death_pitch, the same pattern
# CameraPose already uses for the player's look rotation).
rule ComposeEnemyVisualPose:
    filter:
        Enemy as enemy
        tv.WorldTransform as transform

    on late_tick:
        for visual in query.children[EnemyVisual](of = self):
            emit EnemyVisualPose to visual:
                position = transform.position - vec3(0.0, ENEMY_HALF_HEIGHT, 0.0)
                yaw = enemy.facing_yaw + enemy.visual_yaw_offset
                pitch = enemy.death_pitch

rule ApplyEnemyVisualPose:
    filter:
        EnemyVisual
        tv.WorldTransform as transform

    on EnemyVisualPose as pose:
        transform.position = pose.position
        # Single from_euler call (not a two-step compose like
        # ApplyCameraPose) to exactly match how the root's own rotation is
        # built in SeekPlayer/AnimateEnemyDeath.
        transform.rotation = quat.from_euler(pose.pitch, pose.yaw, 0.0)

rule SpawnRobots:
    filter:
        RobotSpawnPoint as spawn_point
        tv.WorldTransform as transform

    on fixed_tick:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let model_scale = 1.0
        let bounds = models.bounds_size(Robot)
        if bounds.y > 0.0:
            model_scale = CHARACTER_HEIGHT / bounds.y
        spawn RobotTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                speed = ROBOT_SPEED
                visual_yaw_offset = HALF_PI * 2.0
            children:
                EnemyVisual:
                    tv.WorldTransform:
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Robot
                    models.ModelAnimator:
                        clip = ROBOT_RUN_CLIP
                        speed = ROBOT_SPEED / ROBOT_RUN_REFERENCE_SPEED
        spawn_point.countdown = SPAWN_INTERVAL

rule SpawnKnights:
    filter:
        KnightSpawnPoint as spawn_point
        tv.WorldTransform as transform

    on fixed_tick:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        spawn_point.countdown -= fixed_tick.dt
        if spawn_point.countdown > 0.0:
            return
        let model_scale = 1.0
        let bounds = models.bounds_size(Knight)
        if bounds.y > 0.0:
            model_scale = CHARACTER_HEIGHT / bounds.y
        spawn KnightTemplate:
            tv.WorldTransform:
                position = transform.position
            Enemy:
                speed = KNIGHT_SPEED
            children:
                EnemyVisual:
                    tv.WorldTransform:
                        scale = vec3(model_scale, model_scale, model_scale)
                    models.ModelRenderer:
                        model = Knight
                    models.ModelAnimator:
                        clip = KNIGHT_RUN_CLIP
                        speed = KNIGHT_SPEED / KNIGHT_RUN_REFERENCE_SPEED
        spawn_point.countdown = SPAWN_INTERVAL

# Whether a sphere of ENEMY_RADIUS centered at probe overlaps this wall's
# box — the same box-geometry-aware predicate DetectActorSolidContact relies
# on for real wall collision, reused here for the AI's obstacle probing since
# std.physics.volume.query's raycast can't see box extent (see SeekPlayer).
func is_probe_blocked(probe: vec3, wall_position: vec3, wall_size: vec3, wall_rotation: quat) bool:
    return v3.length(collision.sphere_box_separation(probe, ENEMY_RADIUS, wall_position, wall_size, wall_rotation)) > 0.0

rule SeekPlayer:
    filter:
        Enemy as enemy
        Threat
        KinematicActor as actor
        tv.WorldTransform as transform

    on fixed_tick:
        if enemy.dying:
            return
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return

        # actor.grounded reflects the end of the *previous* tick's grounding
        # resolution (this tick's own IntegrateVerticalMotion/
        # DetectGroundCandidate haven't run yet) — a deliberate one-tick lag,
        # same as ApplyJump's grounded check, that sidesteps needing this
        # fixed_tick rule to depend on another fixed_tick rule's downstream
        # GroundCandidate-event cascade within the same tick.
        if enemy.is_vaulting and actor.grounded:
            enemy.is_vaulting = false
            let run_clip = ROBOT_RUN_CLIP
            match self:
                KnightEnemy =>
                    run_clip = KNIGHT_RUN_CLIP
            for visual in query.children[EnemyVisual](of = self):
                emit SetEnemyClip to visual:
                    clip = run_clip

        let target_position = tv.world_position(player_entity)
        let delta = vec3(target_position.x - transform.position.x, 0.0, target_position.z - transform.position.z)
        let distance = v3.length(delta)
        if distance <= 0.0:
            return
        let direct_direction = delta / distance
        let up = vec3(0.0, 1.0, 0.0)
        let probe_direct = transform.position + direct_direction * ENEMY_STEER_PROBE_DISTANCE
        let solid_walls = query.all[Solid]()

        # Checked in two passes: the direct heading alone first, since that's
        # the common case and the only one steering/vaulting ever needs — the
        # deflected candidates and vault-clearance probe below are wasted
        # work on a tick where the direct path is already clear.
        let direct_blocked = false
        for wall in solid_walls:
            let wall_position = vec3(0.0, 0.0, 0.0)
            let wall_rotation = quat.identity()
            match wall:
                tv.WorldTransform as wall_transform =>
                    wall_position = wall_transform.position
                    wall_rotation = wall_transform.rotation
            let wall_size = vec3(1.0, 1.0, 1.0)
            match wall:
                physics.BoxCollider as wall_box =>
                    wall_size = wall_box.size
            if not direct_blocked and is_probe_blocked(probe_direct, wall_position, wall_size, wall_rotation):
                direct_blocked = true

        let direction = direct_direction
        if direct_blocked:
            let candidate_left_small = v3.rotate(direct_direction, up, ENEMY_STEER_ANGLE_SMALL)
            let candidate_right_small = v3.rotate(direct_direction, up, ENEMY_STEER_ANGLE_SMALL * -1.0)
            let candidate_left_large = v3.rotate(direct_direction, up, ENEMY_STEER_ANGLE_LARGE)
            let candidate_right_large = v3.rotate(direct_direction, up, ENEMY_STEER_ANGLE_LARGE * -1.0)
            let probe_left_small = transform.position + candidate_left_small * ENEMY_STEER_PROBE_DISTANCE
            let probe_right_small = transform.position + candidate_right_small * ENEMY_STEER_PROBE_DISTANCE
            let probe_left_large = transform.position + candidate_left_large * ENEMY_STEER_PROBE_DISTANCE
            let probe_right_large = transform.position + candidate_right_large * ENEMY_STEER_PROBE_DISTANCE
            # Same x/z as probe_direct, raised to jump-clearance height: an
            # obstacle that blocks here too is too tall to vault.
            let probe_direct_high = vec3(probe_direct.x, transform.position.y + ENEMY_VAULT_CLEARANCE_HEIGHT, probe_direct.z)

            let direct_high_blocked = false
            let left_small_blocked = false
            let right_small_blocked = false
            let left_large_blocked = false
            let right_large_blocked = false
            for wall in solid_walls:
                let wall_position = vec3(0.0, 0.0, 0.0)
                let wall_rotation = quat.identity()
                match wall:
                    tv.WorldTransform as wall_transform =>
                        wall_position = wall_transform.position
                        wall_rotation = wall_transform.rotation
                let wall_size = vec3(1.0, 1.0, 1.0)
                match wall:
                    physics.BoxCollider as wall_box =>
                        wall_size = wall_box.size
                if not direct_high_blocked and is_probe_blocked(probe_direct_high, wall_position, wall_size, wall_rotation):
                    direct_high_blocked = true
                if not left_small_blocked and is_probe_blocked(probe_left_small, wall_position, wall_size, wall_rotation):
                    left_small_blocked = true
                if not right_small_blocked and is_probe_blocked(probe_right_small, wall_position, wall_size, wall_rotation):
                    right_small_blocked = true
                if not left_large_blocked and is_probe_blocked(probe_left_large, wall_position, wall_size, wall_rotation):
                    left_large_blocked = true
                if not right_large_blocked and is_probe_blocked(probe_right_large, wall_position, wall_size, wall_rotation):
                    right_large_blocked = true

            # Vaultable beats steering: a short obstacle dead ahead is jumped
            # over on the direct heading rather than detoured around. Only
            # trigger while grounded, read from last tick's resolution (same
            # lag as the landing check above and ApplyJump's grounded check).
            # `enemy.is_vaulting` is already false by the time we'd reach here
            # in the same tick a landing clears it, so it adds nothing beyond
            # actor.grounded and isn't repeated as a guard here.
            let can_vault = not direct_high_blocked
            if can_vault and actor.grounded:
                actor.vertical_velocity = JUMP_VELOCITY
                actor.grounded = false
                enemy.is_vaulting = true
                let jump_clip = ROBOT_JUMP_CLIP
                match self:
                    KnightEnemy =>
                        jump_clip = KNIGHT_JUMP_CLIP
                for visual in query.children[EnemyVisual](of = self):
                    emit SetEnemyClip to visual:
                        clip = jump_clip

            # Priority order (small deflection, then large deflection,
            # alternating sides): flat guards instead of nested ifs so each
            # line stands alone — falls back to the direct heading when every
            # candidate is blocked and vaulting doesn't apply, same as before
            # steering existed (the existing wall-separation rules still
            # prevent tunneling in that case).
            let steering_needed = not can_vault
            if steering_needed and not left_small_blocked:
                direction = candidate_left_small
            if steering_needed and left_small_blocked and not right_small_blocked:
                direction = candidate_right_small
            if steering_needed and left_small_blocked and right_small_blocked and not left_large_blocked:
                direction = candidate_left_large
            if steering_needed and left_small_blocked and right_small_blocked and left_large_blocked and not right_large_blocked:
                direction = candidate_right_large

        enemy.facing_yaw = math.atan2(direction.x * -1.0, direction.z * -1.0)
        transform.rotation = quat.from_euler(0.0, enemy.facing_yaw, 0.0)
        transform.position += direction * enemy.speed * fixed_tick.dt

rule CooldownShooter:
    filter:
        Shooter as shooter

    on tick:
        if shooter.cooldown > 0.0:
            shooter.cooldown = math.max(0.0, shooter.cooldown - tick.dt)

rule FireBullet:
    filter:
        CameraRig
        Shooter as shooter
        tv.WorldTransform as transform
    after:
        CursorCaptureToggle

    on input:
        let player_entity = query.first[Player]()
        let active = false
        match player_entity:
            Player as player =>
                active = not player.game_over
        if not active:
            return
        if not input.pressed(Fire) or shooter.cooldown > 0.0:
            return
        let direction = quat.forward(transform.rotation)
        spawn BulletTemplate:
            tv.WorldTransform:
                position = transform.position + direction * 0.5
            Bullet:
                velocity = direction * BULLET_SPEED
        shooter.cooldown = FIRE_COOLDOWN

rule MoveBullets:
    filter:
        Bullet as bullet
        tv.WorldTransform as transform

    on fixed_tick:
        if bullet.consumed:
            return
        transform.position += bullet.velocity * fixed_tick.dt
        bullet.lifetime -= fixed_tick.dt
        if bullet.lifetime <= 0.0:
            bullet.consumed = true
            destroy

rule DetectBulletSolidContact:
    pairs:
        bullet:
            Bullet
            tv.WorldTransform
        box:
            Solid
            physics.BoxCollider
            tv.WorldTransform

    on fixed_tick:
        if not bullet.Bullet.consumed:
            let separation = collision.sphere_box_separation(bullet.tv.WorldTransform.position, BULLET_RADIUS, box.tv.WorldTransform.position, box.physics.BoxCollider.size, box.tv.WorldTransform.rotation)
            if v3.length(separation) > 0.0:
                emit BulletContact to bullet:
                    other = box
                    hit_enemy = false

rule DetectBulletEnemyContact:
    pairs:
        bullet:
            Bullet
            tv.WorldTransform
        enemy:
            Enemy
            Threat
            KinematicActor
            tv.WorldTransform
    after:
        DetectBulletSolidContact

    on fixed_tick:
        if not bullet.Bullet.consumed and not enemy.Enemy.dying:
            let bullet_position = bullet.tv.WorldTransform.position
            let enemy_position = enemy.tv.WorldTransform.position
            let horizontal = vec3(bullet_position.x - enemy_position.x, 0.0, bullet_position.z - enemy_position.z)
            let close_horizontal = v3.length(horizontal) <= BULLET_RADIUS + enemy.KinematicActor.radius
            let close_vertical = math.abs(bullet_position.y - enemy_position.y) <= enemy.KinematicActor.half_height + BULLET_RADIUS
            if close_horizontal and close_vertical:
                emit BulletContact to bullet:
                    other = enemy
                    hit_enemy = true

rule ConsumeBulletContact:
    filter:
        Bullet as bullet

    on BulletContact as contact:
        if bullet.consumed:
            return
        bullet.consumed = true
        if contact.hit_enemy:
            emit EnemyHit to contact.other
        destroy

rule BeginRobotDeath:
    filter:
        RobotEnemy
        Enemy as enemy

    on EnemyHit:
        if enemy.dying:
            return
        enemy.dying = true
        enemy.death_elapsed = 0.0
        for visual in query.children[EnemyVisual](of = self):
            emit SetEnemyClip to visual:
                clip = ROBOT_DEATH_CLIP

rule BeginKnightDeath:
    filter:
        KnightEnemy
        Enemy as enemy

    on EnemyHit:
        if enemy.dying:
            return
        enemy.dying = true
        enemy.death_elapsed = 0.0
        for visual in query.children[EnemyVisual](of = self):
            emit SetEnemyClip to visual:
                clip = KNIGHT_DEATH_CLIP

rule ApplySetEnemyClip:
    filter:
        EnemyVisual
        models.ModelAnimator as animator

    on SetEnemyClip as trigger:
        animator.clip = trigger.clip
        animator.time = 0.0
        animator.playing = true

# Enemy is the collision/logic root (grounded at torso height, see
# EnemyBase); the rendered model lives on a child EnemyVisual entity, so the
# alpha fade computed here is applied there via EnemyDeathProgress.
rule AnimateEnemyDeath:
    filter:
        Enemy as enemy
        tv.WorldTransform as transform

    on tick:
        if not enemy.dying:
            return
        enemy.death_elapsed += tick.dt
        if enemy.death_elapsed >= DEATH_DURATION:
            # Destroying self cascades to the EnemyVisual child (Parent-based
            # recursive destroy) — skip emitting to it this tick so nothing
            # tries to apply EnemyDeathProgress against an entity destroyed
            # in the same activation.
            destroy
            return
        let progress = math.clamp(enemy.death_elapsed / DEATH_DURATION, 0.0, 1.0)
        enemy.death_pitch = progress * HALF_PI
        transform.rotation = quat.from_euler(enemy.death_pitch, enemy.facing_yaw, 0.0)
        for visual in query.children[EnemyVisual](of = self):
            emit EnemyDeathProgress to visual:
                alpha = 1.0 - progress

rule ApplyEnemyDeathProgress:
    filter:
        EnemyVisual
        models.ModelRenderer as renderer

    on EnemyDeathProgress as progress:
        renderer.color = color(1.0, 1.0, 1.0, progress.alpha)

rule DetectPlayerContact:
    pairs:
        enemy:
            Enemy
            Threat
            KinematicActor
            tv.WorldTransform
        player:
            Player
            KinematicActor
            tv.WorldTransform

    on fixed_tick:
        if not enemy.Enemy.dying and not player.Player.game_over:
            if collision.spheres_overlap(enemy.tv.WorldTransform.position, enemy.KinematicActor.radius, player.tv.WorldTransform.position, player.KinematicActor.radius):
                emit GameOver to player

rule EndGame:
    filter:
        Player

    on GameOver:
        if game_over:
            return
        game_over = true
        game_over_count += 1
        cursor_captured = false
        inp.set_cursor_captured(false)
        let crosshair = query.first[Crosshair]()
        emit GameOverPresentation to crosshair
        let label = query.first[GameOverLabel]()
        emit GameOverPresentation to label

rule HideCrosshairOnGameOver:
    filter:
        Crosshair
        text.ScreenLabel as label

    on GameOverPresentation:
        label.visible = false

rule ShowGameOverLabel:
    filter:
        GameOverLabel
        text.ScreenLabel as label

    on GameOverPresentation:
        label.text = "GAME OVER"
        label.visible = true

rule RestartOnGameOver:
    filter:
        Player
        tv.WorldTransform as transform
        camera.FirstPersonCamera as first_person

    on input:
        if not game_over:
            return
        if not input.pressed(RestartGame):
            return
        game_over = false
        transform.position = vec3(0.0, PLAYER_HALF_HEIGHT, 10.0)
        transform.rotation = quat.identity()
        first_person.yaw = 0.0
        first_person.pitch = 0.0
        cursor_captured = true
        inp.set_cursor_captured(true)
        for enemy in query.all[Enemy]():
            emit RestartCleanup to enemy
        for bullet in query.all[Bullet]():
            emit RestartCleanup to bullet
        for spawn_point in query.all[RobotSpawnPoint]():
            emit RestartSpawnPoint to spawn_point
        for spawn_point in query.all[KnightSpawnPoint]():
            emit RestartSpawnPoint to spawn_point
        let crosshair = query.first[Crosshair]()
        emit RestartPresentation to crosshair
        let label = query.first[GameOverLabel]()
        emit RestartPresentation to label

rule RestartClearsEnemy:
    filter:
        Enemy

    on RestartCleanup:
        destroy

rule RestartClearsBullet:
    filter:
        Bullet

    on RestartCleanup:
        destroy

rule RestartResetsRobotSpawnPoint:
    filter:
        RobotSpawnPoint as spawn_point

    on RestartSpawnPoint:
        spawn_point.countdown = 0.0

rule RestartResetsKnightSpawnPoint:
    filter:
        KnightSpawnPoint as spawn_point

    on RestartSpawnPoint:
        spawn_point.countdown = 0.0

rule ShowCrosshairOnRestart:
    filter:
        Crosshair
        text.ScreenLabel as label

    on RestartPresentation:
        label.visible = true

rule HideGameOverLabelOnRestart:
    filter:
        GameOverLabel
        text.ScreenLabel as label

    on RestartPresentation:
        label.visible = false
