module std.physics.volume.query

# 3D spatial query operations. Trait filters are supplied at each call site
# as bracketed predicates; these declarations carry only the geometry arguments
# required at every call site.

# Nearest entity in 3D world space satisfying the query filter, or a stale
# entity_id if no match exists.
pub extern func nearest(from: vec3) entity_id

# All entities whose 3D axis-aligned bounding box overlaps the given box.
pub extern func overlap_box(center: vec3, size: vec3) list[entity_id]

# All entities whose 3D shape overlaps the given sphere.
pub extern func overlap_sphere(center: vec3, radius: float) list[entity_id]

# All entities along the 3D ray within max_dist that satisfy the query filter.
pub extern func raycast(origin: vec3, dir: vec3, max_dist: float) list[entity_id]
