module external_handler_linking

pub extern event frame:
    dt: float

pub extern event Reset:
    value: int

trait Position:
    var value: float = 2.0

trait Velocity:
    var value: float = 1.0

trait Heading:
    var angle: float = 0.0
    var turns: int = 0

phase fixed_tick:
    from:
        frame
    dt: float = frame.dt

entity Mover:
    Position
    Velocity
    Heading

extern rule NativeMovement:
    each:
        Position
        Velocity
    on fixed_tick:
        reads:
            Position
        writes:
            Velocity
        commands:
            set Heading
    on Reset:
        reads:
            Velocity
        writes:
            Position