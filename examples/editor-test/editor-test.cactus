module editor_test

use std.transform.flat
use std.physics.flat
use std.camera.flat
use std.camera.viewport
use std.render.shapes
use std.editor

# ── Template Catalog (editor-spawnable via EditorPlace2D) ─────────────────────

pub template Box:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #FF4444FF
        visible = true

pub template PlayerSpawn:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #4488FFFF
        visible = true

# ── Camera ────────────────────────────────────────────────────────────────────

pub entity EditorCamera:
    Camera:
        zoom = 64.0
        offset = vec2(0.0, 0.0)
    Viewport

# ── Initial Scene Entities ────────────────────────────────────────────────────

pub entity Player:
    LocalTransform:
        position = vec2(0.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #4488FFFF
        visible = true
    EditorLocked

pub entity SpawnBox:
    LocalTransform:
        position = vec2(3.0, 0.0)
    WorldTransform
    BoxCollider:
        size = vec2(1.0, 1.0)
    Shape:
        type = ShapeType.Rectangle
        size = vec2(1.0, 1.0)
        color = #44FF44FF
        visible = true
