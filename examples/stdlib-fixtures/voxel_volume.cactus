module voxel_volume

# Small volumes for std.voxel.volume's headless test.
#   Terrain: 4 x 3 x 4 cells from (10, 0, 0), y in -1..1. Layer y = -1 is stone,
#            cells with y = 0 and x < 2 are wood, the rest is air.
#   Fine:    4 x 1 x 2 half-metre cells at negative coordinates, all solid.
#   Broken:  a zero cell size, so it creates no cells.
# StrayCell duplicates Terrain's (2, 1, 2) and is created before the volume's
# own cells.

use std.core
use std.physics.volume as physics
use std.voxel.volume as voxel
use std.persistence as storage

asset Stone: texture = "../platformer/assets/tiles/ground.png"
asset Wood: texture = "../platformer/assets/tiles/platform.png"

pub entity Terrain:
    voxel.Volume:
        origin = vec3(10.0, 0.0, 0.0)
        min_y = -1
        max_x = 3
        max_y = 1
        max_z = 3
        batch = 16

pub entity Fine:
    voxel.Volume:
        origin = vec3(-5.0, 0.0, 20.0)
        cell_size = 0.5
        min_x = -2
        max_x = 1
        min_z = -1
        batch = 100

pub entity Broken:
    voxel.Volume:
        cell_size = 0.0
        max_x = 3

pub entity StrayCell:
    voxel.Cell:
        volume = Terrain
        x = 2
        y = 1
        z = 2

pub entity Picker:
    voxel.CellProbe:
        volume = Terrain
    Ask
    CellSighting

pub entity Eye:
    voxel.RayProbe:
        volume = Terrain
    Aim
    Sighting

pub entity FineEye:
    voxel.RayProbe:
        volume = Fine
    Aim
    Sighting

# Digs whatever its ray probe hits while armed, and records the coordinate it
# saw, which shows the probe ran first.
pub trait Digger:
    var armed: bool = false
    var saw_x: int = -100
    var saw_y: int = -100
    var saw_z: int = -100

pub entity Shovel:
    Digger
    voxel.RayProbe:
        volume = Terrain
    Aim
    Sighting

# The test aims a ray probe through its Aim, and asks a cell probe through its
# Ask. Taking the trait away leaves the probe without a question.
pub trait Aim:
    var origin: vec3 = vec3(0.0, 0.0, 0.0)
    var direction: vec3 = vec3(0.0, 0.0, -1.0)

pub trait Ask:
    var x: int = 0
    var y: int = 0
    var z: int = 0

# A probe's answer this frame, kept for the test to read after the frame.
pub trait Sighting:
    var hit: bool = false
    var cell: entity_id
    var x: int = 0
    var y: int = 0
    var z: int = 0
    var distance: float = 0.0
    var point: vec3 = vec3(0.0, 0.0, 0.0)
    var faced: bool = false
    var normal: vec3 = vec3(0.0, 0.0, 0.0)
    var adjacent_x: int = 0
    var adjacent_y: int = 0
    var adjacent_z: int = 0

rule AimProbes:
    each:
        Aim as aim
        voxel.RayProbe
    before:
        voxel.probes

    on input:
        project voxel.RayCast:
            origin = aim.origin
            direction = aim.direction

rule RecordRays:
    each:
        Sighting as seen
    after:
        voxel.probes

    on input:
        seen.hit = false
        seen.faced = false
        match self:
            voxel.RayHit as hit =>
                seen.hit = true
                seen.cell = hit.cell
                seen.x = hit.x
                seen.y = hit.y
                seen.z = hit.z
                seen.distance = hit.distance
                seen.point = hit.point
        match self:
            voxel.RayFace as face =>
                seen.faced = true
                seen.normal = face.normal
                seen.adjacent_x = face.adjacent_x
                seen.adjacent_y = face.adjacent_y
                seen.adjacent_z = face.adjacent_z

# A cell probe's answer this frame.
pub trait CellSighting:
    var found: bool = false
    var cell: entity_id

rule AskProbes:
    each:
        Ask as ask
        voxel.CellProbe
    before:
        voxel.probes

    on input:
        project voxel.CellQuery:
            x = ask.x
            y = ask.y
            z = ask.z

rule RecordCells:
    each:
        CellSighting as seen
    after:
        voxel.probes

    on input:
        seen.found = false
        match self:
            voxel.CellFound as found =>
                seen.found = true
                seen.cell = found.cell

event Dig

# The host takes a whole volume away.
pub extern event Demolish:
    volume: entity_id

rule DemolishVolume:
    on Demolish:
        destroy Demolish.volume

# Copies the coordinates of the cell its handle names, or -1 when the handle
# names no live cell. The test sets the handle.
pub trait CellLookup:
    var target: entity_id
    var x: int = 0
    var z: int = 0

pub entity Lookup:
    CellLookup

rule LookUpCell:
    pairs:
        lookup:
            CellLookup
        cell:
            voxel.Cell
    where:
        cell == lookup[CellLookup].target
    reduce per lookup:
        x = max(cell[voxel.Cell].x, default = -1)
        z = max(cell[voxel.Cell].z, default = -1)

    on tick:
        lookup[CellLookup].x = x
        lookup[CellLookup].z = z

# Spawns a cell one past Terrain's max_x when the test sets `armed`.
pub trait Overflow:
    var armed: bool = false
    var cell: entity_id

pub entity Spiller:
    Overflow

rule SpillCell:
    each:
        Overflow as overflow

    on tick:
        if not overflow.armed:
            return
        overflow.armed = false
        overflow.cell = spawn voxel.CellTemplate(volume = Terrain, x = 4, y = 0, z = 0, center = vec3(14.5, 0.5, 0.5), size = 1.0)

# Saves or restores slot "voxels" when the test sets a flag.
pub trait StorageControl:
    var save: bool = false
    var restore: bool = false
    var saved: bool = false
    var restored: bool = false
    var failure: string = ""

pub entity Storage:
    StorageControl

rule DriveStorage:
    each:
        StorageControl as control

    on tick:
        if control.save:
            control.save = false
            emit storage.SaveRequested:
                slot = "voxels"
                request_id = 1
        if control.restore:
            control.restore = false
            emit storage.RestoreRequested:
                slot = "voxels"
                request_id = 2

    on storage.SaveCompleted:
        control.saved = true

    on storage.SaveFailed as failed:
        control.failure = failed.message

    on storage.RestoreFailed as failed:
        control.failure = failed.message

rule GenerateTerrain:
    each:
        voxel.Cell as cell

    on added voxel.Cell:
        if cell.volume == Terrain and cell.y == -1:
            cell.texture = Stone
            add physics.Solid
        if cell.volume == Terrain and cell.y == 0 and cell.x < 2:
            cell.texture = Wood
            add physics.Solid
        if cell.volume == Fine:
            cell.texture = Stone
            add physics.Solid

rule DigWithShovel:
    each:
        Digger as digger
        voxel.RayHit as hit
    after:
        voxel.probes

    on input:
        if not digger.armed:
            return
        digger.saw_x = hit.x
        digger.saw_y = hit.y
        digger.saw_z = hit.z
        digger.armed = false
        emit Dig to hit.cell

rule RemoveDugCell:
    each:
        voxel.Cell
        physics.Solid

    on Dig:
        remove physics.Solid
