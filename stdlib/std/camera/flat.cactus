module std.camera.flat

# ── 2D Camera Traits & Systems ────────────────────────────────────────────────

# 2D orthographic camera configuration.
# zoom:     magnification factor (1.0 = normal, 2.0 = 2x zoom in)
# offset:   camera origin offset in world units (controls what is centered)
# rotation: camera rotation in radians
# active:   only the active camera is used for rendering
pub trait Camera:
    var zoom: float = 1.0
    var offset: vec2 = vec2(0.0, 0.0)
    var rotation: float = 0.0
    var active: bool = true

# Smooth-follow camera that tracks a target entity's position.
# target:    entity_id of the entity to follow
# offset:    additional offset from the target's position
# smoothing: lerp speed (higher = snappier; 0 = instant)
pub trait FollowCamera:
    var target: entity_id
    var offset: vec2 = vec2(0.0, 0.0)
    var smoothing: float = 8.0

# Updates Camera.offset to smoothly follow the target entity's position.
# TODO: requires entity query mechanism to read target entity's Transform.
# Stubbed until entity-by-id field access is added to the language.
pub system FollowCameraSystem:
    filter:
        Camera as cam
        FollowCamera as follow
    on late_tick(dt: float):
        # TODO: query target entity Transform and lerp cam.offset toward it
        pass
