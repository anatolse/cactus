module std.transform.volume

# ── 3D Hierarchical Transforms ────────────────────────────────────────────────

# Local/authored 3D transform relative to the entity's parent.
# position: local-space 3D position
# rotation: orientation as a quaternion (identity = no rotation)
# scale:    per-axis scale factor (1.0 = normal size)
pub trait LocalTransform:
    var position: vec3 = vec3(0.0, 0.0, 0.0)
    var rotation: quat = quat(0.0, 0.0, 0.0, 1.0)
    var scale: vec3 = vec3(1.0, 1.0, 1.0)

# 3D world transform. Propagation derives it for entities with LocalTransform.
# An entity with WorldTransform and no LocalTransform is a pose root: rules
# write its pose, and propagation never overwrites it.
# position: world-space 3D position
# rotation: world-space orientation as a quaternion
# scale:    world-space per-axis scale
pub trait WorldTransform:
    var position: vec3 = vec3(0.0, 0.0, 0.0)
    var rotation: quat = quat(0.0, 0.0, 0.0, 1.0)
    var scale: vec3 = vec3(1.0, 1.0, 1.0)

# Composes each LocalTransform child onto its parent's WorldTransform, after
# every other late_tick rule that writes WorldTransform.
extern rule TransformPropagation:
    filter:
        LocalTransform
        WorldTransform

    on late_tick:
        reads:
            LocalTransform
            Parent
            WorldTransform
        writes:
            WorldTransform

# Returns WorldTransform.position for a live entity, or vec3(0,0,0) if stale.
pub extern func world_position(of: entity_id) vec3
