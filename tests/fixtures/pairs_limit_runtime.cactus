module pairs_limit_runtime

use std.core

# Runtime coverage for `limit:` (dsl-rule-limit) across all four shapes: a
# unary global limit with and without `order by:`, a pairs global limit, a
# pairs per-binding limit, and a provably-one per-binding limit that writes
# straight through its pair binding.
#
# The emit-and-roll fingerprint idiom is the same one pairs_order_by_runtime
# uses: each activation emits a single-digit code and a Recorder singleton
# rolls those digits into one integer, so the final value is an order- and
# count-sensitive fingerprint of the whole pass.

trait Ranked:
    var score: int = 0
    var tag: int = 0

# A second, data-bearing trait on the same entities as Ranked: a sorted unary
# filter needs at least two elements in its view for codegen's `view.use<>`
# anchor pin, which is unrelated to anything `limit:` does.
trait Contender:
    var flag: int = 0

trait Marked:
    var tag: int = 0

trait Actor:
    var height: float = 0.0
    var ground: int = 0

trait Surface:
    var code: int = 0
    var top: float = 0.0

trait Recorder:
    var unary_sequence: int = 0
    var mark_sequence: int = 0
    var mark_all_sequence: int = 0
    var pair_sequence: int = 0
    var per_sequence: int = 0

event UnaryVisited:
    code: int

event MarkVisited:
    code: int

event MarkAllVisited:
    code: int

event PairVisited:
    code: int

event PerVisited:
    code: int

# The arena's DetectGroundCandidate/ApplyGroundCandidate/BeginGrounding shape
# collapsed into one rule: rank every candidate surface by how far below the
# actor it sits, keep the closest one that is actually below, and write the
# winner straight through the `actor` binding — no event, no sentinel
# accumulator field, no second rule.
#
# This is also the where:-versus-truncation hazard: surface 1 sits *above* the
# actor, so its -2.0 key sorts ahead of every legal candidate. Truncating
# before `where:` would hand it the single slot and leave the actor ungrounded;
# the correct answer is surface 2 (the closest surface at or below 10.0).
rule GroundActor:
    pairs:
        actor:
            Actor
        surface:
            Surface
    order by:
        actor.Actor.height - surface.Surface.top asc
    where:
        surface.Surface.top <= actor.Actor.height
    limit: 1 per actor

    on tick:
        actor.Actor.ground = surface.Surface.code

# Ascending score over tags 1/2/3 with scores 3/1/2 orders tag2, tag3, tag1;
# taking 2 makes the fingerprint 23 rather than the unlimited 231.
rule TakeTwoRanked:
    filter:
        Ranked as r
        Contender as c
    order by:
        r.score asc
    limit: 2

    on tick:
        emit UnaryVisited:
            code = r.tag

# No `order by:`, so the limit takes the *domain's own* iteration order — the
# order VisitAllMarked below visits unrestricted. Asserting the two against
# each other is what makes this a spec check ("without `order by:`, `limit`
# uses the domain's existing stable iteration order") rather than a
# restatement of whichever direction EnTT's view happens to run.
rule TakeOneMarked:
    filter:
        Marked as m
    limit: 1

    on tick:
        emit MarkVisited:
            code = m.tag

rule VisitAllMarked:
    filter:
        Marked as m

    on tick:
        emit MarkAllVisited:
            code = m.tag

# 3 Ranked entities give 9 tuples in left-binding-major creation order; the
# first 3 all have Alpha on the left, making the fingerprint 123.
rule TakeThreeTuples:
    pairs:
        lead:
            Ranked
        mate:
            Ranked
    limit: 3

    on tick:
        emit PairVisited:
            code = ((lead.Ranked.tag - 1) * 3) + mate.Ranked.tag

# Two tuples per distinct `lead`, each partition resolved independently:
# codes 1,2 for Alpha, 4,5 for Beta, 7,8 for Gamma.
rule TakeTwoPerLead:
    pairs:
        lead:
            Ranked
        mate:
            Ranked
    limit: 2 per lead

    on tick:
        emit PerVisited:
            code = ((lead.Ranked.tag - 1) * 3) + mate.Ranked.tag

rule RecordUnary:
    filter:
        Recorder

    on UnaryVisited as visit:
        unary_sequence = (unary_sequence * 10) + visit.code

rule RecordMark:
    filter:
        Recorder

    on MarkVisited as visit:
        mark_sequence = (mark_sequence * 10) + visit.code

rule RecordMarkAll:
    filter:
        Recorder

    on MarkAllVisited as visit:
        mark_all_sequence = (mark_all_sequence * 10) + visit.code

rule RecordPair:
    filter:
        Recorder

    on PairVisited as visit:
        pair_sequence = (pair_sequence * 10) + visit.code

rule RecordPer:
    filter:
        Recorder

    on PerVisited as visit:
        per_sequence = (per_sequence * 10) + visit.code

entity Alpha:
    Ranked:
        score = 3
        tag = 1
    Contender:
        flag = 0

entity Beta:
    Ranked:
        score = 1
        tag = 2
    Contender:
        flag = 0

entity Gamma:
    Ranked:
        score = 2
        tag = 3
    Contender:
        flag = 0

entity MarkFirst:
    Marked:
        tag = 7

entity MarkSecond:
    Marked:
        tag = 8

entity Walker:
    Actor:
        height = 10.0
        ground = 0

entity Ceiling:
    Surface:
        code = 1
        top = 12.0

entity Ledge:
    Surface:
        code = 2
        top = 9.0

entity Floor:
    Surface:
        code = 3
        top = 4.0

entity Log:
    Recorder
